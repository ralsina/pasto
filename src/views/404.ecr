<script>
  document.addEventListener('DOMContentLoaded', function() {
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      let html = `<a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;"><i data-lucide="plus" style="width: 20px; height: 20px;"></i></a>`;
      html += `<a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;"><i data-lucide="help-circle" style="width: 20px; height: 20px;"></i></a>`;
      <% if current_user %>
      html += `<a href="/profile" class="controls-button" title="Profile" aria-label="View your profile" style="text-decoration: none; display: flex; align-items: center; justify-content: center;"><i data-lucide="user" style="width: 20px; height: 20px;"></i></a>`;
      <% end %>
      controlsGroup.insertAdjacentHTML('afterbegin', html);
      if (window.lucide) {
        lucide.createIcons();
      }
    }
  });
</script>

<div class="error-container">
  <div class="error-content">
    <div class="error-icon">
      <i data-lucide="file-x" style="width: 64px; height: 64px; color: var(--pico-del-color);"></i>
    </div>

    <h1>404 - Not Found</h1>
  </div>
</div>

<style>
  .error-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .error-content {
    text-align: center;
    background-color: var(--pico-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    padding: 3rem 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .error-icon {
    margin-bottom: 2rem;
  }

  .error-content h1 {
    color: var(--pico-del-color);
    margin-bottom: 0;
    font-size: 3rem;
    font-weight: 700;
  }

  /* Controls buttons styling */
  .controls-button {
    background: transparent;
    border: 2px solid var(--pico-primary);
    border-radius: 4px;
    padding: 0;
    cursor: pointer;
    font-size: 1.25rem;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    color: var(--pico-primary);
  }

  .controls-button:hover {
    background: var(--pico-primary);
    color: var(--pico-primary-inverse);
  }

  .controls-button i,
  .controls-button svg {
    color: inherit;
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    min-height: 20px !important;
    max-width: 20px !important;
    max-height: 20px !important;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .error-container {
      margin: 1rem auto;
    }

    .error-content {
      padding: 2rem 1.5rem;
    }

    .error-content h1 {
      font-size: 2.5rem;
    }
  }
</style>
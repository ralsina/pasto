    'cmake': '.cmake',
    'cobol': '.cob',
    'coffeescript': '.coffee',
    'common_lisp': '.lisp',
    'coq': '.v',
    'crystal': '.cr',
    'csharp': '.cs',
    'css': '.css',
    'cue': '.cue',
    'cython': '.pyx',
    'd': '.d',
    'dart': '.dart',
    'dax': '.dax',
    'desktop_entry': '.desktop',
    'diff': '.diff',
    'dns': '.zone',
    'docker': '.dockerfile',
    'dtd': '.dtd',
    'dylan': '.dylan',
    'ebnf': '.ebnf',
    'elixir': '.ex',
    'elm': '.elm',
    'emacslisp': '.el',
    'erlang': '.erl',
    'factor': '.factor',
    'fennel': '.fennel',
    'fish': '.fish',
    'forth': '.fth',
    'fortran': '.f90',
    'fortranfixed': '.f',
    'fsharp': '.fs',
    'gas': '.s',
    'gdscript': '.gd',
    'gdscript3': '.gd',
    'gherkin': '.feature',
    'gleam': '.gleam',
    'glsl': '.glsl',
    'gnuplot': '.plt',
    'go': '.go',
    'go_template': '.gotmpl',
    'graphql': '.graphql',
    'groff': '.man',
    'groovy': '.groovy',
    'handlebars': '.hbs',
    'hare': '.ha',
    'haskell': '.hs',
    'hcl': '.hcl',
    'hlb': '.hlb',
    'hlsl': '.hlsl',
    'holyc': '.hc',
    'html': '.html',
    'hy': '.hy',
    'idris': '.idr',
    'igor': '.ipf',
    'ini': '.ini',
    'io': '.io',
    'j': '.ijs',
    'java': '.java',
    'javascript': '.js',
    'json': '.json',
    'jsonata': '.jsonata',
    'julia': '.jl',
    'jungle': '.jungle',
    'kotlin': '.kt',
    'llvm': '.ll',
    'lua': '.lua',
    'makefile': '.mak',
    'mako': '.mao',
    'markdown': '.md',
    'mason': '.mhtml',
    'mathematica': '.nb',
    'matlab': '.m',
    'mcfunction': '.mcfunction',
    'metal': '.metal',
    'minizinc': '.mzn',
    'mlir': '.mlir',
    'modula-2': '.mod',
    'monkeyc': '.mc',
    'myghty': '.myt',
    'nasm': '.nasm',
    'natural': '.nsp',
    'newspeak': '.ns2',
    'nim': '.nim',
    'nix': '.nix',
    'objective-c': '.m',
    'objectpascal': '.pas',
    'ocaml': '.ml',

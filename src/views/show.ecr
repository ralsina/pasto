    'puppet': '.pp',
    'python': '.py',
    'python_2': '.py',
    'qbasic': '.bas',
    'qml': '.qml',
    'r': '.r',
    'racket': '.rkt',
    'react': '.jsx',
    'reasonml': '.re',
    'reg': '.reg',
    'rego': '.rego',
    'rexx': '.rexx',
    'rpm_spec': '.spec',
    'rst': '.rst',
    'ruby': '.rb',
    'rust': '.rs',
    'sas': '.sas',
    'sass': '.sass',
    'scala': '.scala',
    'scheme': '.scm',
    'scilab': '.sci',
    'scss': '.scss',
    'sed': '.sed',
    'shell': '.sh',
    'sieve': '.sieve',
    'smali': '.smali',
    'smalltalk': '.st',
    'smarty': '.tpl',
    'snobol': '.snobol',
    'solidity': '.sol',
    'sourcepawn': '.sp',
    'sparql': '.sparql',
    'sql': '.sql',
    'mysql': '.sql',
    'standard_ml': '.sml',
    'stas': '.stas',
    'stylus': '.styl',
    'svelte': '.svelte',
    'swift': '.swift',
    'systemd': '.service',
    'systemverilog': '.sv',
    'tablegen': '.td',
    'tal': '.tal',
    'tasm': '.tasm',
    'tcl': '.tcl',
    'tcsh': '.tcsh',
    'terraform': '.tf',
    'tex': '.tex',
    'text': '.txt',
    'thrift': '.thrift',
    'toml': '.toml',
    'tradingview': '.tv',
    'turing': '.tu',
    'turtle': '.ttl',
    'twig': '.twig',
    'typescript': '.ts',
    'typoscript': '.ts',
    'ucode': '.uc',
    'v': '.v',
    'v_shell': '.vsh',
    'vala': '.vala',
    'vb_net': '.vb',
    'VelocityLexer': '.vm',
    'verilog': '.v',
    'vhdl': '.vhdl',
    'vhs': '.tape',
    'viml': '.vim',
    'vue': '.vue',
    'wdte': '.wdte',
    'webgpu_shading_language': '.wgsl',
    'whiley': '.whiley',
    'xml': '.xml',
    'yaml': '.yaml',
    'yang': '.yang',
    'z80_assembly': '.z80',
    'zed': '.zed',
    'zig': '.zig',
    // Aliases
    'cpp': '.cpp',
    'jsx': '.jsx',
    'tsx': '.tsx',
    'sh': '.sh',
    'zsh': '.sh'
  };
  
  function getDownloadFilename() {
    // If filename already has an extension, use it as-is
    if (pasteFilename.includes('.')) {
      return pasteFilename;
    }
    // Otherwise, add extension based on currently selected language
    const langSelect = document.getElementById('view-language');
    const selectedLang = langSelect ? (langSelect.value || pasteLanguage) : pasteLanguage;
    const ext = languageExtensions[selectedLang] || '.txt';
    return pasteFilename + ext;
  }
  
  function copyToClipboard() {
    const btn = document.querySelector('.copy-overlay-btn');

    // Use the potentially decrypted content
    const contentToCopy = window.rawContent || rawContent;

    // Try modern clipboard API first, fall back to execCommand
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(contentToCopy).then(() => {
        showCopySuccess(btn);
      }).catch(() => {
        fallbackCopy(btn, contentToCopy);
      });
    } else {
      fallbackCopy(btn, contentToCopy);
    }
  }
  
  function fallbackCopy(btn, content) {
    // Fallback for non-HTTPS or older browsers
    const textarea = document.createElement('textarea');
    textarea.value = content;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand('copy');
      showCopySuccess(btn);
    } catch (e) {
      console.error('Copy failed:', e);
    }
    document.body.removeChild(textarea);
  }
  
  function showCopySuccess(btn) {
    btn.classList.add('copied');
    btn.innerHTML = '<i data-lucide="check"></i>';
    lucide.createIcons();
    
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = '<i data-lucide="copy"></i>';
      lucide.createIcons();
    }, 2000);
  }
  
  function downloadPaste() {
    // Use the potentially decrypted content
    const contentToDownload = window.rawContent || rawContent;
    const blob = new Blob([contentToDownload], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = getDownloadFilename();
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function forkPaste() {
    // Create a form and submit it to fork the paste
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/<%= paste.sepia_id %>/fork';
    document.body.appendChild(form);
    form.submit();
  }

  function deletePaste() {
    if (confirm('Are you sure you want to delete this paste? This action cannot be undone.')) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/<%= paste.sepia_id %>/delete';
      document.body.appendChild(form);
      form.submit();
    }
  }

  function changeLanguage() {
    const language = document.getElementById('view-language').value;
    const url = new URL(window.location);

    if (language) {
      url.searchParams.set('lang', language);
    } else {
      url.searchParams.delete('lang');
    }

    window.location.href = url.toString();
  }

  // Show password dialog for encrypted content
  function showPasswordDialog() {
    const pasteContent = document.getElementById('paste-content');
    const isPasswordBased = <%= paste.password_based ? "true" : "false" %>;

    // Create and show the dialog
    pasteContent.innerHTML = `
      <div id="encryption-dialog" style="padding: 2rem; text-align: center; color: var(--pico-color);">
        <h3 style="color: var(--pico-primary);">🔒 This paste is encrypted</h3>
        <p style="margin-bottom: 1.5rem;">Enter the ${isPasswordBased === "true" ? "password" : "encryption key"} to decrypt this content:</p>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem; max-width: 400px; margin: 0 auto;">
          <input
            type="password"
            id="encryption-key-input"
            placeholder="Enter ${isPasswordBased === "true" ? "password" : "encryption key"}"
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--pico-border-color); border-radius: 4px; font-family: ${isPasswordBased === "true" ? "inherit" : "monospace"};"
            autocomplete="off"
          >
          <button
            id="decrypt-button"
            style="background: var(--pico-primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer; font-weight: 500;"
            onclick="attemptDecryption()"
          >
            Decrypt
          </button>
          <button
            id="cancel-button"
            style="background: var(--pico-secondary-background); color: var(--pico-color); border: 1px solid var(--pico-border-color); padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer;"
            onclick="showEncryptedInfo()"
          >
            Show Info
          </button>
        </div>
        <p style="font-size: 0.8rem; opacity: 0.7; margin-top: 1.5rem;">
          <strong>Tip:</strong> The key should have been provided to you separately.
        </p>
      </div>
    `;

    // Focus on the input field
    setTimeout(() => {
      const input = document.getElementById('encryption-key-input');
      if (input) {
        input.focus();
        // Add enter key support
        input.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            attemptDecryption();
          }
        });
      }
    }, 100);
  }

  // Show encrypted paste info dialog
  function showEncryptedInfo() {
    const pasteContent = document.getElementById('paste-content');
    pasteContent.innerHTML = `
      <div id="encryption-info" style="padding: 2rem; text-align: center; color: var(--pico-color);">
        <h3 style="color: var(--pico-primary);">🔒 Encrypted Paste</h3>
        <p style="margin-bottom: 1.5rem;">This content is protected with AES-256-GCM encryption.</p>
        <div style="background: var(--pico-secondary-background); border: 1px solid var(--pico-border-color); border-radius: 4px; padding: 1rem; margin: 1rem 0; text-align: left;">
          <h4 style="margin-top: 0; color: var(--pico-primary);">How to decrypt:</h4>
          <ol style="margin: 0.5rem 0; padding-left: 1.5rem;">
            <li>Obtain the encryption key from the person who shared this paste</li>
            <li>Click the "Enter Key" button below</li>
            <li>Paste the key and the content will decrypt automatically</li>
          </ol>
        </div>
        <div style="background: var(--pico-secondary-background); border: 1px solid var(--pico-border-color); border-radius: 4px; padding: 1rem; margin: 1rem 0; text-align: left;">
          <h4 style="margin-top: 0; color: var(--pico-primary);">About this encryption:</h4>
          <ul style="margin: 0.5rem 0; padding-left: 1.5rem;">
            <li><strong>Algorithm:</strong> AES-256-GCM</li>
            <li><strong>Security:</strong> Zero-knowledge - the server cannot decrypt your content</li>
            <li><strong>Compatibility:</strong> Works with OpenSSL command line tools</li>
          </ul>
        </div>
        <button
          onclick="showPasswordDialog()"
          style="background: var(--pico-primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer; font-weight: 500;"
        >
          Enter Key
        </button>
      </div>
    `;
  }

  // Attempt decryption with user-provided key
  async function attemptDecryption() {
    const keyInput = document.getElementById('encryption-key-input');
    const decryptButton = document.getElementById('decrypt-button');
    const dialog = document.getElementById('encryption-dialog');

    const key = keyInput ? keyInput.value.trim() : '';

    if (!key) {
      alert('Please enter an encryption key');
      return;
    }

    // Update button state
    if (decryptButton) {
      decryptButton.textContent = 'Decrypting...';
      decryptButton.disabled = true;
    }

    try {
      // Store key in session storage instead of URL fragment
      const currentPath = window.location.pathname;
      const pasteSepiaId = currentPath.substring(1);
      PastoCrypto.storeKeyInSession(pasteSepiaId, key);

      let decryptedContent;

      // Check if this is password-based encryption
      const isPasswordBased = <%= paste.password_based ? "true" : "false" %>;

      if (isPasswordBased) {
        // Get encryption salt and iterations from the paste data
        const encryptionSalt = "<%= paste.encryption_salt %>";
        const encryptionIterations = <%= paste.encryption_iterations || 100000 %>;

        // Decrypt using password (no base64 validation for passwords)
        decryptedContent = await PastoCrypto.decryptWithPassword(encryptedContent, encryptionIv, encryptionSalt, key, encryptionIterations);
      } else {
        // Validate key format for key-based encryption
        if (!PastoCrypto.validateKey(key)) {
          alert('Invalid encryption key format. The key should be a valid base64 string.');
          if (decryptButton) {
            decryptButton.textContent = 'Decrypt';
            decryptButton.disabled = false;
          }
          return;
        }

        // Decrypt using key
        decryptedContent = await PastoCrypto.decrypt(encryptedContent, encryptionIv, key);
      }

      // Update the content with the decrypted data
      const pasteContent = document.getElementById('paste-content');
      pasteContent.textContent = decryptedContent;

      // Update rawContent for copy/download functionality
      window.rawContent = decryptedContent;

      // Re-highlight the decrypted content
      const formData = new FormData();
      formData.append('content', decryptedContent);
      formData.append('language', pasteLanguage);
      formData.append('theme', 'monokai');

      const response = await fetch('/highlight', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        const data = await response.json();
        if (data.html) {
          pasteContent.innerHTML = data.html;
        }
      }

      // Update markdown rendering if needed
      const isMarkdown = (pasteLanguage === "markdown") || pasteFilename.endsWith(".md");
      if (isMarkdown) {
        const renderedDiv = document.getElementById('rendered-markdown');
        if (renderedDiv) {
          renderedDiv.innerHTML = marked.parse(decryptedContent);
        }
      }

      // Update the paste header to show it's decrypted
      const headerElement = document.querySelector('.paste-header h2');
      if (headerElement) {
        headerElement.innerHTML = '🔓 ' + headerElement.textContent;
      }

      // Show success message briefly
      const successMessage = document.createElement('div');
      successMessage.innerHTML = '✅ Successfully decrypted!';
      successMessage.style.cssText = 'position: fixed; top: 20px; right: 20px; background: var(--pico-ins-color); color: white; padding: 0.75rem 1rem; border-radius: 4px; z-index: 1000; animation: fadeInOut 2s ease-in-out;';
      document.body.appendChild(successMessage);

      setTimeout(() => {
        document.body.removeChild(successMessage);
      }, 2000);

    } catch (error) {
      console.error('Decryption error:', error);

      // Restore button state
      if (decryptButton) {
        decryptButton.textContent = 'Decrypt';
        decryptButton.disabled = false;
      }

      // Show error message
      alert('Failed to decrypt content: ' + error.message);
    }
  }

  // Handle encrypted content decryption
  async function handleEncryptedContent() {
    if (!isEncrypted || !encryptedContent || !encryptionIv) {
      return;
    }

    // Get paste ID from current URL
    const currentPath = window.location.pathname;
    const pasteSepiaId = currentPath.substring(1); // Remove leading '/'

    // Check if this is password-based encryption
    const isPasswordBased = <%= paste.password_based ? "true" : "false" %>;

    let encryptionKey;
    if (isPasswordBased) {
      // For password-based encryption, check session storage first
      encryptionKey = PastoCrypto.getKeyFromSession(pasteSepiaId);
      if (!encryptionKey) {
        showPasswordDialog();
        return;
      }
    } else {
      // For key-based encryption, check session storage
      encryptionKey = PastoCrypto.getKeyFromSession(pasteSepiaId);
      if (!encryptionKey) {
        showPasswordDialog();
        return;
      }
    }

    try {
      let decryptedContent;

      if (isPasswordBased) {
        // Get encryption salt and iterations from the paste data
        const encryptionSalt = "<%= paste.encryption_salt %>";
        const encryptionIterations = <%= paste.encryption_iterations || 100000 %>;

        // Decrypt using password (no validation needed for passwords)
        decryptedContent = await PastoCrypto.decryptWithPassword(encryptedContent, encryptionIv, encryptionSalt, encryptionKey, encryptionIterations);
      } else {
        // Validate key format for key-based encryption
        if (!PastoCrypto.validateKey(encryptionKey)) {
          throw new Error('Invalid encryption key format. Expected base64-encoded key.');
        }

        // Decrypt using key
        decryptedContent = await PastoCrypto.decrypt(encryptedContent, encryptionIv, encryptionKey);
      }

      // Update the content with the decrypted data
      const pasteContent = document.getElementById('paste-content');
      pasteContent.textContent = decryptedContent;

      // Update rawContent for copy/download functionality
      window.rawContent = decryptedContent;

      // Re-highlight the decrypted content
      const formData = new FormData();
      formData.append('content', decryptedContent);
      formData.append('language', pasteLanguage);
      formData.append('theme', 'monokai');

      const response = await fetch('/highlight', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        const data = await response.json();
        if (data.html) {
          pasteContent.innerHTML = data.html;
        }
      }

      // Update markdown rendering if needed
      const isMarkdown = (pasteLanguage === "markdown") || pasteFilename.endsWith(".md");
      if (isMarkdown) {
        const renderedDiv = document.getElementById('rendered-markdown');
        if (renderedDiv) {
          renderedDiv.innerHTML = marked.parse(decryptedContent);
        }
      }

      // Update the paste header to show it's decrypted
      const headerElement = document.querySelector('.paste-header h2');
      if (headerElement) {
        headerElement.innerHTML = '🔓 ' + headerElement.textContent;
      }

    } catch (error) {
      console.error('Decryption error:', error);
      document.getElementById('paste-content').innerHTML =
        '<div style="padding: 2rem; text-align: center; color: var(--pico-del-color);">' +
        '<h3>❌ Decryption Failed</h3>' +
        '<p>Unable to decrypt this content. The key may be invalid or corrupted.</p>' +
        '<p style="font-size: 0.9rem; opacity: 0.7;">Error: ' + error.message + '</p>' +
        '</div>';
    }
  }

  // Inject controls into controls-group and set initial language
  document.addEventListener('DOMContentLoaded', function() {
    // Handle encrypted content first
    if (isEncrypted) {
      handleEncryptedContent();
    }

    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="plus" style="width: 20px; height: 20px;"></i>
        </a>
        <select id="view-language" onchange="changeLanguage()" class="controls-select" aria-label="View as different programming language">
          <% Pasto::Paste.available_languages.each do |lang| %>
            <option value="<%= lang == "Auto" ? "" : lang %>" <%= lang == paste.language ? "selected" : "" %>><%= lang %></option>
          <% end %>
        </select>
        <button onclick="downloadPaste()" class="controls-button" title="Download" aria-label="Download paste as file">
          <i data-lucide="download" style="width: 20px; height: 20px;"></i>
        </button>
        <% if current_user %>
        <button onclick="forkPaste()" class="controls-button" title="Fork (create your own copy)" aria-label="Fork paste - create your own copy">
          <i data-lucide="git-fork" style="width: 20px; height: 20px;"></i>
        </button>
        <% end %>
        <% if current_user && paste.user_id == current_user.sepia_id %>
        <a href="/<%= paste.base_id %>/edit" class="controls-button" title="Edit Paste" aria-label="Edit Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="pencil" style="width: 20px; height: 20px;"></i>
        </a>
        <% if version_count > 1 %>
        <a href="/<%= paste.base_id %>/history" class="controls-button" title="View History (<%= version_count %> versions)" aria-label="View History" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="history" style="width: 20px; height: 20px;"></i>
        </a>
        <% end %>
        <button onclick="deletePaste()" class="controls-button" title="Delete Paste" aria-label="Delete paste permanently" style="color: var(--pico-del-color);">
          <i data-lucide="trash-2" style="width: 20px; height: 20px;"></i>
        </button>
        <% end %>
        <% if is_version_view %>
        <a href="/<%= base_paste_id %>" class="controls-button" title="Back to Latest" aria-label="Back to Latest" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
        </a>
        <% end %>
        <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="help-circle" style="width: 20px; height: 20px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user" style="width: 20px; height: 20px;"></i>
        </a>
      `;

      // Initialize Lucide icons
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }

    const urlParams = new URLSearchParams(window.location.search);
    const langParam = urlParams.get('lang');

    if (langParam) {
      document.getElementById('view-language').value = langParam;
    }

    // Auto-detect language when no specific language is assigned
    const languageSelect = document.getElementById('view-language');
    const isAutoDetect = (languageSelect.value === '' || languageSelect.value === 'Auto');

    if (isAutoDetect && rawContent) {
      // Use the highlight endpoint to detect language
      const formData = new FormData();
      formData.append('content', rawContent);
      formData.append('language', '');
      formData.append('theme', 'monokai');

      fetch('/highlight', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.detected_language) {
          const autoDetectOption = Array.from(languageSelect.options).find(
            option => option.value === '' || option.value === 'Auto'
          );
          if (autoDetectOption) {
            autoDetectOption.textContent = `Auto (${data.detected_language})`;
          }

          // Re-highlight the content with the detected language
          const pasteContent = document.getElementById('paste-content');
          if (pasteContent && data.html) {
            pasteContent.innerHTML = data.html;

            // Update markdown rendered content if it exists
            const isMarkdown = (pasteLanguage === "markdown") || pasteFilename.endsWith(".md");
            if (isMarkdown) {
              const renderedDiv = document.getElementById('rendered-markdown');
              if (renderedDiv) {
                renderedDiv.innerHTML = marked.parse(rawContent);
              }
            }
          }
        }
      })
      .catch(error => {
        console.error('Error detecting language:', error);
      });
    }
  });
</script>
<div class="paste-header">
  <hgroup>
    <h2><%= HTML.escape(paste.display_title) %></h2>
    <div class="paste-meta">
      <span class="meta-item" title="<%= paste.created_at.to_s("%Y-%m-%d %H:%M") %> UTC">
        <i data-lucide="calendar"></i>
        <%= Pasto::TimeHelper.relative_time(paste.created_at) %>
      </span>
      
      <span class="meta-separator">•</span>
      
      <span class="meta-item" title="Paste creator">
        <i data-lucide="user"></i>
        <% if owner = paste.owner %>
          <% display_name = owner.display_name.empty? ? "Unnamed User" : owner.display_name %>
          <%= HTML.escape(display_name) %>
          <button class="user-id-info" title="Click to show user ID" aria-label="Show user ID">
            <i data-lucide="help-circle"></i>
          </button>
          <span class="user-id" style="display: none;"> (ID: <%= HTML.escape(owner.sepia_id) %>)</span>
        <% else %>
          Anonymous User
        <% end %>
      </span>
      
      <% if paste.language %>
        <span class="meta-separator">•</span>
        <span class="meta-item" title="Programming language">
          <i data-lucide="code-2"></i>
          <%= HTML.escape(paste.language.try(&.capitalize) || "Text") %>
        </span>
      <% end %>
      
      <% if paste.private? || paste.is_encrypted? || paste.burn_after_reading? || paste.expired? %>
        <span class="meta-separator">•</span>
        <span class="meta-badges">
          <% if paste.private? %>
            <span class="badge badge-private" title="This paste is private - only you can view it">
              <i data-lucide="lock"></i>
              Private
            </span>
          <% end %>
          
          <% if paste.is_encrypted? %>
            <span class="badge badge-encrypted" title="This paste is end-to-end encrypted">
              <i data-lucide="shield"></i>
              Encrypted
            </span>
          <% end %>
          
          <% if paste.burn_after_reading? %>
            <span class="badge badge-burn" title="This paste will be deleted after first view">
              <i data-lucide="flame"></i>
              Burn After Reading
            </span>
          <% end %>
          
          <% if !paste.expired? && paste.expires_at < Time.utc(9999, 1, 1) %>
            <span class="badge badge-expires" title="Expires on <%= paste.expires_at.to_s("%Y-%m-%d %H:%M") %> UTC">
              <i data-lucide="clock"></i>
              Expires <%= paste.expires_at.to_s("%Y-%m-%d") %>
            </span>
          <% end %>
        </span>
      <% end %>
    </div>
  </hgroup>
</div>

<style>
  .paste-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--pico-muted-color);
    margin-top: 0.5rem;
  }
  
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  
  .meta-item i {
    width: 16px;
    height: 16px;
    opacity: 0.8;
  }
  
  .meta-separator {
    opacity: 0.5;
  }
  
  .meta-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }
  
  .badge i {
    width: 14px;
    height: 14px;
  }
  
  .badge-private {
    background: var(--pico-primary-background);
    color: var(--pico-primary);
    border: 1px solid var(--pico-primary);
  }
  
  .badge-encrypted {
    background: rgba(34, 197, 94, 0.1);
    color: rgb(34, 197, 94);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  
  .badge-burn {
    background: rgba(239, 68, 68, 0.1);
    color: rgb(239, 68, 68);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  
  .badge-expires {
    background: rgba(251, 191, 36, 0.1);
    color: rgb(251, 191, 36);
    border: 1px solid rgba(251, 191, 36, 0.3);
  }
  
  .user-id-info {
    background: none;
    border: none;
    padding: 0;
    margin: 0 0 0 0.25rem;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s;
    vertical-align: middle;
  }
  
  .user-id-info:hover {
    opacity: 1;
  }
  
  .user-id-info i {
    width: 14px;
    height: 14px;
  }
  
  @media (max-width: 768px) {
    .paste-meta {
      font-size: 0.8rem;
    }
    
    .badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
    }
  }
</style>

<% is_markdown = (paste.language == "markdown") || paste.filename.to_s.ends_with?(".md") %>
<div class="paste-content-wrapper">
  <div class="paste-content" id="paste-content">
    <%= highlighted_content %>
  </div>
  <% if is_markdown %>
    <div id="rendered-markdown"></div>
        <script>
      let showingMarkdown = true;
      document.addEventListener('DOMContentLoaded', function() {
        // Show rendered markdown by default
        const src = document.getElementById('paste-content');
        const rendered = document.getElementById('rendered-markdown');
        rendered.innerHTML = marked.parse(rawContent);
        src.style.display = 'none';
        rendered.style.display = '';
        const btn = document.getElementById('toggle-md-render');
        btn.innerHTML = '<i data-lucide="file-code-2"></i>';
        btn.title = 'Show source';
        if (window.lucide) lucide.createIcons();
      });
      function toggleMarkdownView() {
        const btn = document.getElementById('toggle-md-render');
        const src = document.getElementById('paste-content');
        const rendered = document.getElementById('rendered-markdown');
        if (!showingMarkdown) {
          rendered.innerHTML = marked.parse(rawContent);
          src.style.display = 'none';
          rendered.style.display = '';
          btn.innerHTML = '<i data-lucide="file-code-2"></i>';
          btn.title = 'Show source';
          if (window.lucide) lucide.createIcons();
          showingMarkdown = true;
        } else {
          rendered.style.display = 'none';
          src.style.display = '';
          btn.innerHTML = '<i data-lucide="eye"></i>';
          btn.title = 'Show rendered Markdown';
          if (window.lucide) lucide.createIcons();
          showingMarkdown = false;
        }
      }
    </script>
  <% end %>

  <div class="overlay-buttons-container">
    <%# QR Code button for all pastes %>
    <button class="overlay-btn qr-btn" id="show-qr-btn" onclick="showQRCode()" title="Show QR Code" aria-label="Show QR Code for sharing paste">
      <i data-lucide="qr-code"></i>
    </button>

    <button class="overlay-btn raw-btn" onclick="viewRaw()" title="View raw content" aria-label="View raw paste content">
      <i data-lucide="code"></i>
    </button>

    <button class="overlay-btn copy-link-btn" onclick="copyLink()" title="Copy link" aria-label="Copy paste URL to clipboard">
      <i data-lucide="link"></i>
    </button>

    <button class="overlay-btn copy-btn" onclick="copyToClipboard()" title="Copy to clipboard" aria-label="Copy paste content to clipboard">
      <i data-lucide="copy"></i>
    </button>

    <% if is_markdown %>
    <button class="overlay-btn eye-btn" id="toggle-md-render" onclick="toggleMarkdownView()" title="Show source" aria-label="Toggle between rendered and source view">
      <i data-lucide="file-code-2"></i>
    </button>
    <% end %>
  </div>
</div>

<style>
  .paste-content-wrapper {
    position: relative;
  }

  .overlay-buttons-container {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.5rem;
    z-index: 2;
  }

  .overlay-btn {
    background: var(--pico-contrast-background);
    border: 1px solid var(--pico-primary);
    border-radius: var(--pico-border-radius);
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    cursor: pointer;
    opacity: 0.8;
    transform: translateZ(0);
    will-change: opacity, background-color;
    transition: opacity 0.2s, background-color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .overlay-btn:hover {
    opacity: 1;
    background: var(--pico-primary);
  }

  .copy-btn.copied {
    background: var(--pico-ins-color);
  }

  .copy-btn.copied i,
  .copy-btn.copied svg {
    color: var(--pico-contrast-inverse);
  }

  .overlay-btn i,
  .overlay-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--pico-contrast-inverse);
  }

  /* User ID info button styling */
  .user-id-info {
    background: none;
    border: none;
    padding: 0;
    margin: 0 0 0 4px;
    cursor: pointer;
    display: inline-block;
    vertical-align: middle;
    color: var(--pico-muted-color);
    transition: color 0.2s;
  }

  .user-id-info:hover {
    color: var(--pico-primary);
  }

  .user-id-info i {
    width: 14px;
    height: 14px;
  }

  .user-id {
    color: var(--pico-muted-color);
    font-size: 0.9em;
  }

  </style>

<%# Include shared utilities, styles, and security components %>
<%= render "src/views/_shared_utils.ecr" %>
<%= render "src/views/_shared_styles.ecr" %>
<%= render "src/views/_security_shared.ecr" %>
<%= render "src/views/_modal_utils.ecr" %>

<script>
  // Store raw content for copying
  const rawContent = <%= paste.content.to_json %>;
  const pasteFilename = <%= (paste.filename || paste.sepia_id).to_json %>;
  const pasteLanguage = <%= (paste.language || "text").to_json %>;

  // Initialize shared security utilities
  const pasteData = {
    is_encrypted: <%= paste.is_encrypted? %>,
    encryption_iv: <%= paste.responds_to?(:encryption_iv) && paste.encryption_iv ? paste.encryption_iv.to_json : "null" %>
  };
  SharedSecurity.initialize(pasteData);

  // Function to apply syntax highlighting to a content element
  function applySyntaxHighlighting(contentElement, code, language) {
    if (typeof hljs === 'undefined') {
      // highlight.js not available, fallback to plain text
      contentElement.textContent = code;
      return;
    }

    // Don't highlight markdown - it will be rendered separately
    const isMarkdown = (language === "markdown") || pasteFilename.endsWith(".md");
    if (isMarkdown) {
      contentElement.textContent = code;
      return;
    }

    // Apply syntax highlighting
    let highlightedCode;
    try {
      if (language && language !== 'text' && hljs.getLanguage(language)) {
        highlightedCode = hljs.highlight(code, { language: language, ignoreIllegals: true }).value;
      } else {
        highlightedCode = hljs.highlightAuto(code).value;
      }
    } catch (e) {
      console.error('Highlight.js error:', e);
      highlightedCode = code;
    }

    contentElement.innerHTML = `<pre><code>${highlightedCode}</code></pre>`;

    // Apply CodeJar theme classes for consistency
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    contentElement.className = isDark ? 'atom-one-dark' : 'atom-one-light';
  }

  // Store encryption information
  const isEncrypted = <%= paste.responds_to?(:is_encrypted?) && paste.is_encrypted? ? "true" : "false" %>;
  const encryptedContent = <%= paste.responds_to?(:encrypted_content) && paste.encrypted_content ? paste.encrypted_content.to_json : "null" %>;
  const encryptionIv = <%= paste.responds_to?(:encryption_iv) && paste.encryption_iv ? paste.encryption_iv.to_json : "null" %>;
  
  // Language extensions are now loaded from language-mapping.js module
  const languageExtensions = window.LanguageExtensions || {};
      
  function getDownloadFilename() {
    // If filename already has an extension, use it as-is
    if (pasteFilename.includes('.')) {
      return pasteFilename;
    }
    // Otherwise, add extension based on currently selected language
    const langSelect = document.getElementById('view-language');
    const selectedLang = langSelect ? (langSelect.value || pasteLanguage) : pasteLanguage;
    const ext = languageExtensions[selectedLang] || '.txt';
    return pasteFilename + ext;
  }
  
  // Copy to clipboard using shared utility
  function copyToClipboard() {
    const btn = document.querySelector('.copy-btn');
    const contentToCopy = window.rawContent || rawContent;

    // Use shared clipboard utility
    SharedClipboard.copy(contentToCopy, {
      button: btn,
      successMessage: 'Content copied!',
      onSuccess: () => {
        console.log('Content copied successfully');
      }
    });
  }

  // Show QR Code for paste sharing (URL only - key management is user concern)
  function showQRCode() {
    const pasteId = window.location.pathname.substring(1); // Remove leading '/'

    generateQRDialog(pasteId);
  }

  // View raw content of the paste
  function viewRaw() {
    const pasteId = window.location.pathname.substring(1); // Remove leading '/'
    window.open(`/${pasteId}/raw`, '_blank');
  }

  // Copy link to the paste
  function copyLink() {
    const btn = document.querySelector('.copy-link-btn');
    SharedURL.copyCurrentURL(btn);
  }

  
  function generateQRDialog(pasteId) {
    // Build QR API URL - just the paste URL, no keys
    const qrApiUrl = `/api/qr/${pasteId}`;

    // Use shared modal system
    return window.showGenericModal({
      title: 'QR Code for Paste',
      icon: 'qr-code',
      message: '',
      customContent: `
        <div id="qr-container" style="display: flex; justify-content: center; align-items: center; min-height: 200px;">
          <div style="padding: 2rem; background: var(--pico-secondary-background); border-radius: 0.5rem; display: flex; align-items: center; justify-content: center;">
            <div style="text-align: center;">
              <i data-lucide="loader" style="width: 2rem; height: 2rem; animation: spin 1s linear infinite;"></i>
              <div style="margin-top: 0.5rem; opacity: 0.7;">Loading QR code...</div>
            </div>
          </div>
        </div>
      `,
      primaryButtonText: 'Close',
      showSecondaryButton: false,
      onShow: (modal) => {
        // Load QR code after modal is shown
        setTimeout(() => {
          const qrContainer = document.getElementById('qr-container');
          qrContainer.innerHTML = `
            <img src="${qrApiUrl}" alt="QR Code" style="max-width: 300px; width: 100%; height: auto; border-radius: 0.5rem; border: 1px solid var(--pico-border-color);" onerror="this.parentElement.innerHTML='<div style=\\'color: var(--pico-del-color); text-align: center; padding: 2rem;\\'><i data-lucide=\\'alert-circle\\' style=\\'width: 2rem; height: 2rem;\\'></i><div style=\\'margin-top: 0.5rem;\\'>Failed to load QR code</div></div>'" />
          `;
        }, 100);
      }
    });
  }

  function downloadPaste() {
    // Use the potentially decrypted content
    const contentToDownload = window.rawContent || rawContent;
    const blob = new Blob([contentToDownload], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = getDownloadFilename();
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function forkPaste() {
    // Create a form and submit it to fork the paste
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/<%= paste.sepia_id %>/fork';
    document.body.appendChild(form);
    form.submit();
  }

  function deletePaste() {
    showConfirmDialog('Are you sure you want to delete this paste? This action cannot be undone.', () => {
      fetch('/<%= paste.sepia_id %>/delete', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        }
      })
      .then(response => {
        if (response.ok) {
          // Redirect to home page after successful deletion
          window.location.href = '/';
        } else {
          // Handle error
          showError('Failed to delete paste. Please try again.');
        }
      })
      .catch(error => {
        console.error('Error deleting paste:', error);
        showError('Failed to delete paste. Please try again.');
      });
    });
  }

  function changeLanguage() {
    const language = document.getElementById('view-language').value;
    const url = new URL(window.location);

    if (language) {
      url.searchParams.set('lang', language);
    } else {
      url.searchParams.delete('lang');
    }

    window.location.href = url.toString();
  }

  // Show password dialog for encrypted content
  function showPasswordDialog() {
    // All encrypted pastes now use password-based encryption with PBKDF2 key derivation
    const isPasswordBased = <%= paste.is_encrypted? ? "true" : "false" %>;

    // Check Web Crypto API availability first
    if (!window.crypto || !window.crypto.subtle || typeof window.crypto.subtle !== 'object') {
      // Show error for insecure environment using shared security utilities
      const pasteContent = document.getElementById('paste-content');
      pasteContent.innerHTML = `
        <div id="encryption-dialog" style="padding: 2rem; text-align: center; color: var(--pico-color);">
          <div style="background: var(--pico-del-background, #dc3545); color: var(--pico-del-inverse, white); padding: 1rem; border-radius: var(--pico-border-radius, 0.25rem); margin: 1rem 0;">
            <h3>🔒 Insecure Environment Detected</h3>
            <p><strong>This encrypted paste cannot be accessed in your current browser environment.</strong></p>
            <p>Web Crypto API requires a <strong>secure context</strong> (HTTPS) to function properly.</p>
            <div style="margin-top: 1rem;">
              <strong>To fix this issue:</strong>
              <ul style="margin: 0.5rem 0; padding-left: 1.5rem;">
                <li>Access this page via <strong>HTTPS</strong> instead of HTTP</li>
                <li>Use <strong>127.0.0.1</strong> instead of <strong>0.0.0.0</strong> for local development</li>
                <li>Ensure you're using a modern browser that supports Web Crypto API</li>
              </ul>
            </div>
            <p style="margin-top: 1rem; font-size: 0.9rem; opacity: 0.9;">
              This security requirement protects your encrypted data from being exposed in insecure contexts.
            </p>
          </div>
        </div>
      `;
      return; // Don't proceed with encryption dialog
    }

    // Use SharedSecurity to show encryption dialog
    SharedSecurity.showEncryptionDialog({
      isPasswordBased: isPasswordBased === "true",
      onSuccess: (key) => {
        attemptDecryptionWithKey(key);
      },
      onCancel: () => {
        showEncryptedInfo();
      }
    });
  }

  // Show encrypted paste info dialog
  function showEncryptedInfo() {
    // Use SharedSecurity to show encryption info
    SharedSecurity.showEncryptionInfo();
  }

  // Attempt decryption with provided key
  async function attemptDecryptionWithKey(key) {
    if (!key) {
      SharedSecurity.showError('Please enter an encryption key');
      return;
    }

    try {
      console.log('=== DEBUG: Starting decryption ===');
      console.log('Key provided:', key ? 'YES' : 'NO');
      console.log('encryptedContent:', encryptedContent ? encryptedContent.substring(0, 50) + '...' : 'NULL');
      console.log('encryptionIv:', encryptionIv ? encryptionIv.substring(0, 50) + '...' : 'NULL');

      // Store key in session storage instead of URL fragment
      const currentPath = window.location.pathname;
      const pasteSepiaId = currentPath.substring(1);
      PastoCrypto.storeKeyInSession(pasteSepiaId, key);

      let decryptedContent;

      // All encrypted pastes now use password-based encryption with PBKDF2 key derivation
      const isPasswordBased = <%= paste.is_encrypted? ? "true" : "false" %>;
      console.log('isPasswordBased:', isPasswordBased);

      // Debug: Check if PastoCrypto is available
      console.log('=== DEBUG: Checking PastoCrypto availability ===');
      console.log('typeof PastoCrypto:', typeof PastoCrypto);
      console.log('typeof window.PastoCrypto:', typeof window.PastoCrypto);

      // If PastoCrypto is not available, wait for it to load
      if (typeof PastoCrypto === 'undefined' && typeof window.PastoCrypto === 'undefined') {
        console.error('ERROR: PastoCrypto is not loaded yet! Waiting for it...');

        // Wait for the crypto module to load
        let attempts = 0;
        const maxAttempts = 10;
        const waitForCrypto = async () => {
          while (attempts < maxAttempts && typeof window.PastoCrypto === 'undefined') {
            attempts++;
            console.log(`Waiting for PastoCrypto to load... attempt ${attempts}/${maxAttempts}`);
            await new Promise(resolve => setTimeout(resolve, 100));
          }

          if (typeof window.PastoCrypto === 'undefined') {
            throw new Error('PastoCrypto failed to load after multiple attempts');
          }

          // Continue with decryption
          console.log('PastoCrypto loaded successfully!');
          return window.PastoCrypto;
        };

        try {
          window.PastoCrypto = await waitForCrypto();
        } catch (error) {
          console.error('Failed to load PastoCrypto:', error);
          SharedSecurity.showError('Encryption module failed to load. Please refresh the page and try again.');
          return;
        }
      }

      // Use whichever PastoCrypto is available
      const Crypto = typeof PastoCrypto !== 'undefined' ? PastoCrypto : window.PastoCrypto;
      console.log('Using Crypto object:', Crypto);
      console.log('Available Crypto methods:', Object.getOwnPropertyNames(Crypto));
      console.log('Crypto.decryptWithPassword type:', typeof Crypto.decryptWithPassword);

      if (isPasswordBased) {
        // Get encryption salt and iterations from the paste data
        const encryptionSalt = "<%= paste.encryption_salt %>";
        const encryptionIterations = <%= paste.encryption_iterations || 100000 %>;
        console.log('Using password-based encryption with salt:', encryptionSalt, 'iterations:', encryptionIterations);

        // Decrypt using password (no base64 validation for passwords)
        console.log('Calling Crypto.decryptWithPassword...');
        if (typeof Crypto.decryptWithPassword !== 'function') {
          console.error('ERROR: Crypto.decryptWithPassword is not a function!');
          throw new Error('Crypto.decryptWithPassword is not available');
        }
        decryptedContent = await Crypto.decryptWithPassword(encryptedContent, encryptionIv, encryptionSalt, key, encryptionIterations);
        console.log('Decryption result:', decryptedContent ? decryptedContent.substring(0, 100) + '...' : 'NULL');
      } else {
        // Validate key format for key-based encryption
        console.log('Validating key format...');
        if (!Crypto.validateKey(key)) {
          SharedSecurity.showError('Invalid encryption key format. The key should be a valid base64 string.');
          return;
        }

        // Decrypt using key
        console.log('Calling Crypto.decrypt...');
        decryptedContent = await Crypto.decrypt(encryptedContent, encryptionIv, key);
        console.log('Decryption result:', decryptedContent ? decryptedContent.substring(0, 100) + '...' : 'NULL');
      }

      console.log('Updating content with decrypted data...');
      console.log('pasteContent element:', document.getElementById('paste-content'));
      console.log('pasteLanguage:', pasteLanguage);

      // Update the content with the decrypted data
      const pasteContent = document.getElementById('paste-content');
      if (!pasteContent) {
        console.error('ERROR: paste-content element not found!');
        return;
      }

      console.log('Calling applySyntaxHighlighting...');
      applySyntaxHighlighting(pasteContent, decryptedContent, pasteLanguage);

      // Update rawContent for copy/download functionality
      window.rawContent = decryptedContent;
      console.log('Set window.rawContent, length:', decryptedContent ? decryptedContent.length : 0);

      // SECURITY: Client-side highlighting for encrypted content
      // Using highlight.js instead of sending decrypted content to server

      // Update markdown rendering if needed
      const isMarkdown = (pasteLanguage === "markdown") || pasteFilename.endsWith(".md");
      if (isMarkdown) {
        const renderedDiv = document.getElementById('rendered-markdown');
        if (renderedDiv) {
          renderedDiv.innerHTML = marked.parse(decryptedContent);
        }
      }

      // Update the paste header to show it's decrypted
      const headerElement = document.querySelector('.paste-header h2');
      if (headerElement) {
        // Remove any existing unlock emoji and keep clean text
        headerElement.textContent = headerElement.textContent.replace('🔓 ', '').trim();
      }

      // Show success message using shared utilities
      SharedSecurity.showSuccess('Successfully decrypted!');

    } catch (error) {
      console.error('Decryption error:', error);
      // Clear the invalid key from session storage and retry
      Crypto.removeKeyFromSession(pasteSepiaId);
      // Show password dialog again instead of error
      showPasswordDialog();
      return;
    }
  }

  
  // Handle encrypted content decryption
  async function handleEncryptedContent() {
    if (!isEncrypted || !encryptedContent || !encryptionIv) {
      return;
    }

    // Get paste ID from current URL
    const currentPath = window.location.pathname;
    const pasteSepiaId = currentPath.substring(1); // Remove leading '/'

    // All encrypted pastes now use password-based encryption with PBKDF2 key derivation
    const isPasswordBased = <%= paste.is_encrypted? ? "true" : "false" %>;

    // Use whichever PastoCrypto is available
    const Crypto = typeof PastoCrypto !== 'undefined' ? PastoCrypto : window.PastoCrypto;
    if (typeof Crypto === 'undefined') {
      console.error('ERROR: PastoCrypto is not available in handleEncryptedContent!');
      showPasswordDialog();
      return;
    }

    let encryptionKey;
    if (isPasswordBased) {
      // For password-based encryption, check session storage first
      encryptionKey = Crypto.getKeyFromSession(pasteSepiaId);
      if (!encryptionKey) {
        showPasswordDialog();
        return;
      }
    } else {
      // For key-based encryption, check session storage
      encryptionKey = Crypto.getKeyFromSession(pasteSepiaId);
      if (!encryptionKey) {
        showPasswordDialog();
        return;
      }
    }

    try {
      let decryptedContent;

      if (isPasswordBased) {
        // Get encryption salt and iterations from the paste data
        const encryptionSalt = "<%= paste.encryption_salt %>";
        const encryptionIterations = <%= paste.encryption_iterations || 100000 %>;

        // Decrypt using password (no validation needed for passwords)
        decryptedContent = await Crypto.decryptWithPassword(encryptedContent, encryptionIv, encryptionSalt, encryptionKey, encryptionIterations);
      } else {
        // Validate key format for key-based encryption
        if (!Crypto.validateKey(encryptionKey)) {
          throw new Error('Invalid encryption key format. Expected base64-encoded key.');
        }

        // Decrypt using key
        decryptedContent = await Crypto.decrypt(encryptedContent, encryptionIv, encryptionKey);
      }

      // Update the content with the decrypted data
      const pasteContent = document.getElementById('paste-content');
      applySyntaxHighlighting(pasteContent, decryptedContent, pasteLanguage);

      // Update rawContent for copy/download functionality
      window.rawContent = decryptedContent;

      // SECURITY: Client-side highlighting for encrypted content
      // Using highlight.js instead of sending decrypted content to server

      // Update markdown rendering if needed
      const isMarkdown = (pasteLanguage === "markdown") || pasteFilename.endsWith(".md");
      if (isMarkdown) {
        const renderedDiv = document.getElementById('rendered-markdown');
        if (renderedDiv) {
          renderedDiv.innerHTML = marked.parse(decryptedContent);
        }
      }

      // Update the paste header to show it's decrypted
      const headerElement = document.querySelector('.paste-header h2');
      if (headerElement) {
        // Remove any existing unlock emoji and keep clean text
        headerElement.textContent = headerElement.textContent.replace('🔓 ', '').trim();
      }

    } catch (error) {
      console.error('Decryption error:', error);
      // Clear the invalid key from session storage and retry
      Crypto.removeKeyFromSession(pasteSepiaId);
      // Show password dialog again instead of error
      showPasswordDialog();
    }
  }

  // Inject controls into controls-group and set initial language
  document.addEventListener('DOMContentLoaded', function() {
    // Handle encrypted content first
    if (isEncrypted) {
      handleEncryptedContent();
    }

    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="plus" style="width: 20px; height: 20px;"></i>
        </a>
        <select id="view-language" onchange="changeLanguage()" class="controls-select" aria-label="View as different programming language">
          <% Pasto::Paste.available_languages.each do |lang| %>
            <option value="<%= lang == "Auto" ? "" : lang %>" <%= lang == paste.language ? "selected" : "" %>><%= lang %></option>
          <% end %>
        </select>
        <button onclick="downloadPaste()" class="controls-button" title="Download" aria-label="Download paste as file">
          <i data-lucide="download" style="width: 20px; height: 20px;"></i>
        </button>
        <% if current_user %>
        <button onclick="forkPaste()" class="controls-button" title="Fork (create your own copy)" aria-label="Fork paste - create your own copy">
          <i data-lucide="git-fork" style="width: 20px; height: 20px;"></i>
        </button>
        <% end %>
        <% if current_user && paste.user_id == current_user.sepia_id %>
        <a href="/<%= paste.base_id %>/edit" class="controls-button" title="Edit Paste" aria-label="Edit Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="pencil" style="width: 20px; height: 20px;"></i>
        </a>
        <% end %>
        <% if version_count > 1 %>
        <a href="/<%= paste.base_id %>/history" class="controls-button" title="View History (<%= version_count %> versions)" aria-label="View History" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="history" style="width: 20px; height: 20px;"></i>
        </a>
        <% end %>
        <button onclick="deletePaste()" class="controls-button" title="Delete Paste" aria-label="Delete paste permanently" style="color: var(--pico-del-color);">
          <i data-lucide="trash-2" style="width: 20px; height: 20px;"></i>
        </button>
        <% if is_version_view %>
        <a href="/<%= base_paste_id %>" class="controls-button" title="Back to Latest" aria-label="Back to Latest" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
        </a>
        <% end %>
              <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="help-circle" style="width: 20px; height: 20px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="user" style="width: 20px; height: 20px;"></i>
        </a>
      `;

      // Initialize Lucide icons
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }

    const urlParams = new URLSearchParams(window.location.search);
    const langParam = urlParams.get('lang');

    if (langParam) {
      document.getElementById('view-language').value = langParam;
    }

    // Auto-detect language when no specific language is assigned
    const languageSelect = document.getElementById('view-language');
    const isAutoDetect = (languageSelect.value === '' || languageSelect.value === 'Auto');

    // SECURITY: Do not send potentially decrypted content to server for language detection
    // Only run auto-detection for non-encrypted content
    if (isAutoDetect && rawContent && !isEncrypted) {
      // Use the highlight endpoint to detect language
      const formData = new FormData();
      formData.append('content', rawContent);
      formData.append('language', '');
      formData.append('theme', '<%= paste.theme %>');

      fetch('/highlight', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.language) {
          const autoDetectOption = Array.from(languageSelect.options).find(
            option => option.value === '' || option.value === 'Auto'
          );
          if (autoDetectOption) {
            autoDetectOption.textContent = `Auto (${data.language})`;
          }

          // Re-highlight the content with the detected language
          const pasteContent = document.getElementById('paste-content');
          if (pasteContent && data.html) {
            pasteContent.innerHTML = data.html;

            // Update markdown rendered content if it exists
            const isMarkdown = (pasteLanguage === "markdown") || pasteFilename.endsWith(".md");
            if (isMarkdown) {
              const renderedDiv = document.getElementById('rendered-markdown');
              if (renderedDiv) {
                renderedDiv.innerHTML = marked.parse(rawContent);
              }
            }
          }
        }
      })
      .catch(error => {
        console.error('Error detecting language:', error);
      });
    }

});
</script>

<script>
// Toggle user ID visibility - setup immediately
(function() {
  function setupUserIdToggle() {
    const userIdInfos = document.querySelectorAll('.user-id-info');

    userIdInfos.forEach(function(infoElement) {
      infoElement.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const userIdSpan = this.nextElementSibling;
        if (userIdSpan && userIdSpan.classList.contains('user-id')) {
          userIdSpan.style.display = userIdSpan.style.display === 'none' ? 'inline' : 'none';
        }
      });
    });
  }

  // Setup immediately if DOM is ready, otherwise wait for DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupUserIdToggle);
  } else {
    setupUserIdToggle();
  }
})();
</script>
<div class="paste-header">
  <hgroup>
    <h2><%= HTML.escape(paste.display_title) %></h2>
    <p class="paste-meta"><%= paste.created_at.to_s("%Y-%m-%d %H:%M") %> UTC</p>
  </hgroup>
</div>

<% is_markdown = (paste.language == "markdown") || paste.filename.to_s.ends_with?(".md") %>
<div class="paste-content-wrapper">
  <div class="paste-content" id="paste-content">
    <%= highlighted_content %>
  </div>
  <% if is_markdown %>
    <div id="rendered-markdown"></div>
    <button class="eye-overlay-btn" id="toggle-md-render" onclick="toggleMarkdownView()" title="Show source" aria-label="Toggle between rendered and source view">
      <i data-lucide="file-code-2"></i>
    </button>
        <script>
      let showingMarkdown = true;
      document.addEventListener('DOMContentLoaded', function() {
        // Show rendered markdown by default
        const src = document.getElementById('paste-content');
        const rendered = document.getElementById('rendered-markdown');
        rendered.innerHTML = marked.parse(rawContent);
        src.style.display = 'none';
        rendered.style.display = '';
        const btn = document.getElementById('toggle-md-render');
        btn.innerHTML = '<i data-lucide="file-code-2"></i>';
        btn.title = 'Show source';
        if (window.lucide) lucide.createIcons();
      });
      function toggleMarkdownView() {
        const btn = document.getElementById('toggle-md-render');
        const src = document.getElementById('paste-content');
        const rendered = document.getElementById('rendered-markdown');
        if (!showingMarkdown) {
          rendered.innerHTML = marked.parse(rawContent);
          src.style.display = 'none';
          rendered.style.display = '';
          btn.innerHTML = '<i data-lucide="file-code-2"></i>';
          btn.title = 'Show source';
          if (window.lucide) lucide.createIcons();
          showingMarkdown = true;
        } else {
          rendered.style.display = 'none';
          src.style.display = '';
          btn.innerHTML = '<i data-lucide="eye"></i>';
          btn.title = 'Show rendered Markdown';
          if (window.lucide) lucide.createIcons();
          showingMarkdown = false;
        }
      }
    </script>
  <% end %>
  <button class="copy-overlay-btn" onclick="copyToClipboard()" title="Copy to clipboard" aria-label="Copy paste content to clipboard">
    <i data-lucide="copy"></i>
  </button>
</div>

<style>
  .paste-content-wrapper {
    position: relative;
  }
  
  .copy-overlay-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--pico-secondary-background);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    cursor: pointer;
    opacity: 0.7;
    transform: translateZ(0);
    will-change: opacity, background-color;
    transition: opacity 0.2s, background-color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .eye-overlay-btn {
    position: absolute;
    top: 0.75rem;
    right: 3.25rem;
    background: var(--pico-secondary-background);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    cursor: pointer;
    opacity: 0.7;
    transform: translateZ(0);
    will-change: opacity, background-color;
    transition: opacity 0.2s, background-color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  
  .copy-overlay-btn:hover, .eye-overlay-btn:hover {
    opacity: 1;
    background: var(--pico-secondary-hover-background);
  }
  
  .copy-overlay-btn.copied {
    background: var(--pico-ins-color);
  }
  
  .copy-overlay-btn i,
  .copy-overlay-btn svg,
  .eye-overlay-btn i,
  .eye-overlay-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--pico-primary);
  }
</style>

<script>
  // Store raw content for copying
  const rawContent = <%= paste.content.to_json %>;
  const pasteFilename = <%= (paste.filename || paste.sepia_id).to_json %>;
  const pasteLanguage = <%= (paste.language || "text").to_json %>;

  // Store encryption information
  const isEncrypted = <%= paste.responds_to?(:is_encrypted) && paste.is_encrypted ? "true" : "false" %>;
  const encryptedContent = <%= paste.responds_to?(:encrypted_content) && paste.encrypted_content ? paste.encrypted_content.to_json : "null" %>;
  const encryptionIv = <%= paste.responds_to?(:encryption_iv) && paste.encryption_iv ? paste.encryption_iv.to_json : "null" %>;
  
  // Map languages to typical file extensions (reversed from Tartrazine's LEXERS_BY_FILENAME)
  // Generated from all lexers - picking the most canonical extension for each
  const languageExtensions = {
    'abap': '.abap',
    'abnf': '.abnf',
    'actionscript': '.as',
    'actionscript_3': '.as',
    'ada': '.ada',
    'agda': '.agda',

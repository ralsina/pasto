<div class="paste-header">
  <hgroup>
    <h2><%= HTML.escape(paste.display_title) %></h2>
    <p class="paste-meta"><%= paste.created_at.to_s("%Y-%m-%d %H:%M") %> UTC</p>
  </hgroup>
</div>

<div class="paste-content">
  <%= highlighted_content %>
</div>

<script>
  function changeLanguage() {
    const language = document.getElementById('view-language').value;
    const url = new URL(window.location);

    if (language) {
      url.searchParams.set('lang', language);
    } else {
      url.searchParams.delete('lang');
    }

    window.location.href = url.toString();
  }

  // Inject controls into top bar and set initial language
  document.addEventListener('DOMContentLoaded', function() {
    const topBarRight = document.querySelector('.top-bar-right');
    if (topBarRight) {
      topBarRight.insertAdjacentHTML('afterbegin', `
        <a href="/" class="top-bar-btn" title="Create New Paste"><i data-lucide="plus"></i></a>
        <% if current_user && paste.user_id == current_user.sepia_id %>
        <a href="/<%= paste.base_id %>/edit" class="top-bar-btn" title="Edit Paste"><i data-lucide="pencil"></i></a>
        <% if version_count > 1 %>
        <a href="/<%= paste.base_id %>/history" class="top-bar-btn" title="View History (<%= version_count %> versions)"><i data-lucide="history"></i></a>
        <% end %>
        <% end %>
        <% if is_version_view %>
        <a href="/<%= base_paste_id %>" class="top-bar-btn" title="Back to Latest"><i data-lucide="arrow-left"></i></a>
        <% end %>
        <select id="view-language" onchange="changeLanguage()">
          <% Pasto::Paste.available_languages.each do |lang| %>
            <option value="<%= lang == "Auto-detect" ? "" : lang %>" <%= lang == paste.language ? "selected" : "" %>><%= lang %></option>
          <% end %>
        </select>
      `);
      lucide.createIcons();
    }

    const urlParams = new URLSearchParams(window.location.search);
    const langParam = urlParams.get('lang');

    if (langParam) {
      document.getElementById('view-language').value = langParam;
    }
  });
</script>
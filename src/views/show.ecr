<div class="paste-header">
  <hgroup>
    <h2><%= HTML.escape(paste.display_title) %></h2>
    <p class="paste-meta"><%= paste.created_at.to_s("%Y-%m-%d %H:%M") %> UTC</p>
  </hgroup>
</div>

<div class="paste-content-wrapper">
  <div class="paste-content">
    <%= highlighted_content %>
  </div>
  <button class="copy-overlay-btn" onclick="copyToClipboard()" title="Copy to clipboard">
    <i data-lucide="copy"></i>
  </button>
</div>

<style>
  .paste-content-wrapper {
    position: relative;
  }
  
  .copy-overlay-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--pico-secondary-background);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    padding: 0.5rem;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s, background-color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .copy-overlay-btn:hover {
    opacity: 1;
    background: var(--pico-primary-background);
  }
  
  .copy-overlay-btn.copied {
    background: var(--pico-ins-color);
  }
  
  .copy-overlay-btn i,
  .copy-overlay-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--pico-color);
  }
</style>

<script>
  // Store raw content for copying
  const rawContent = <%= paste.content.to_json %>;
  const pasteFilename = <%= (paste.filename || paste.sepia_id).to_json %>;
  const pasteLanguage = <%= (paste.language || "text").to_json %>;
  
  // Map languages to typical file extensions
  const languageExtensions = {
    'python': '.py',
    'javascript': '.js',
    'typescript': '.ts',
    'ruby': '.rb',
    'php': '.php',
    'java': '.java',
    'c': '.c',
    'cpp': '.cpp',
    'csharp': '.cs',
    'go': '.go',
    'rust': '.rs',
    'bash': '.sh',
    'shell': '.sh',
    'powershell': '.ps1',
    'sql': '.sql',
    'mysql': '.sql',
    'html': '.html',
    'css': '.css',
    'scss': '.scss',
    'sass': '.sass',
    'json': '.json',
    'yaml': '.yaml',
    'xml': '.xml',
    'markdown': '.md',
    'dockerfile': '.dockerfile',
    'makefile': '.makefile',
    'perl': '.pl',
    'lua': '.lua',
    'r': '.r',
    'scala': '.scala',
    'kotlin': '.kt',
    'swift': '.swift',
    'dart': '.dart',
    'elixir': '.ex',
    'erlang': '.erl',
    'haskell': '.hs',
    'clojure': '.clj',
    'crystal': '.cr',
    'nim': '.nim',
    'zig': '.zig',
    'vue': '.vue',
    'svelte': '.svelte',
    'jsx': '.jsx',
    'tsx': '.tsx',
    'toml': '.toml',
    'ini': '.ini',
    'csv': '.csv',
    'text': '.txt'
  };
  
  function getDownloadFilename() {
    // If filename already has an extension, use it as-is
    if (pasteFilename.includes('.')) {
      return pasteFilename;
    }
    // Otherwise, add extension based on language
    const ext = languageExtensions[pasteLanguage] || '.txt';
    return pasteFilename + ext;
  }
  
  function copyToClipboard() {
    const btn = document.querySelector('.copy-overlay-btn');
    
    // Try modern clipboard API first, fall back to execCommand
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(rawContent).then(() => {
        showCopySuccess(btn);
      }).catch(() => {
        fallbackCopy(btn);
      });
    } else {
      fallbackCopy(btn);
    }
  }
  
  function fallbackCopy(btn) {
    // Fallback for non-HTTPS or older browsers
    const textarea = document.createElement('textarea');
    textarea.value = rawContent;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand('copy');
      showCopySuccess(btn);
    } catch (e) {
      console.error('Copy failed:', e);
    }
    document.body.removeChild(textarea);
  }
  
  function showCopySuccess(btn) {
    btn.classList.add('copied');
    btn.innerHTML = '<i data-lucide="check"></i>';
    lucide.createIcons();
    
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = '<i data-lucide="copy"></i>';
      lucide.createIcons();
    }, 2000);
  }
  
  function downloadPaste() {
    const blob = new Blob([rawContent], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = getDownloadFilename();
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function changeLanguage() {
    const language = document.getElementById('view-language').value;
    const url = new URL(window.location);

    if (language) {
      url.searchParams.set('lang', language);
    } else {
      url.searchParams.delete('lang');
    }

    window.location.href = url.toString();
  }

  // Inject controls into top bar and set initial language
  document.addEventListener('DOMContentLoaded', function() {
    const topBarRight = document.querySelector('.top-bar-right');
    if (topBarRight) {
      topBarRight.insertAdjacentHTML('afterbegin', `
        <a href="/" class="top-bar-btn" title="Create New Paste"><i data-lucide="plus"></i></a>
        <button class="top-bar-btn" onclick="downloadPaste()" title="Download"><i data-lucide="download"></i></button>
        <% if current_user && paste.user_id == current_user.sepia_id %>
        <a href="/<%= paste.base_id %>/edit" class="top-bar-btn" title="Edit Paste"><i data-lucide="pencil"></i></a>
        <% if version_count > 1 %>
        <a href="/<%= paste.base_id %>/history" class="top-bar-btn" title="View History (<%= version_count %> versions)"><i data-lucide="history"></i></a>
        <% end %>
        <% end %>
        <% if is_version_view %>
        <a href="/<%= base_paste_id %>" class="top-bar-btn" title="Back to Latest"><i data-lucide="arrow-left"></i></a>
        <% end %>
        <select id="view-language" onchange="changeLanguage()">
          <% Pasto::Paste.available_languages.each do |lang| %>
            <option value="<%= lang == "Auto-detect" ? "" : lang %>" <%= lang == paste.language ? "selected" : "" %>><%= lang %></option>
          <% end %>
        </select>
      `);
      lucide.createIcons();
    }

    const urlParams = new URLSearchParams(window.location.search);
    const langParam = urlParams.get('lang');

    if (langParam) {
      document.getElementById('view-language').value = langParam;
    }
  });
</script>
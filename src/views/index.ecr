<% unless current_user %>
  <div id="anon-warning" class="anon-warning" style="display:none; margin: 1rem;">
    <i data-lucide="info"></i>
    You are not logged in. Pastes created will not be associated with an account and cannot be edited later.
    <a href="/profile" style="margin-left:0.5em;">Log in to enable editing</a>
    <button id="anon-warning-dismiss" title="Dismiss" aria-label="Dismiss anonymous user warning" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:0.5em;font-size:1.1em;vertical-align:middle;">&times;</button>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (!localStorage.getItem('pasto_hide_anon_warning')) {
        document.getElementById('anon-warning').style.display = '';
      }
      document.getElementById('anon-warning-dismiss').onclick = function() {
        document.getElementById('anon-warning').style.display = 'none';
        localStorage.setItem('pasto_hide_anon_warning', 'true');
      };
      if (window.lucide) lucide.createIcons();
    });
  </script>
  <style>
    .anon-warning {
      background: none;
      color: var(--pico-color);
      border: 1px solid var(--pico-primary, #0074d9);
      border-radius: 6px;
      padding: 0.75em 1em;
      font-size: 0.97em;
      display: flex;
      align-items: center;
      gap: 0.5em;
      box-shadow: none;
    }
    .anon-warning i[data-lucide] {
      width: 20px;
      height: 20px;
      color: var(--pico-primary, #0074d9);
      flex-shrink: 0;
    }
    .anon-warning button {
      font-weight: bold;
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
      margin-left: 0.5em;
      font-size: 1.1em;
      line-height: 1;
      padding: 0 0.25em;
    }
    .anon-warning a {
      color: var(--pico-primary, #0074d9);
      text-decoration: underline;
      margin-left: 0.5em;
    }
    .anon-warning a:hover {
      text-decoration: none;
    }
  </style>
<% end %>

<%= render "src/views/_editor_container.ecr" %>

<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '';

  // Use shared functions from external module
  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language using shared function
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    // Use shared togglePreview function
    if (typeof window.togglePreview === 'function') {
      window.togglePreview(jar,
        () => document.getElementById('language').value,
        () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
      );
    }
  }

  function updatePreview() {
    // Use shared updatePreview function
    if (typeof window.updatePreview === 'function') {
      window.updatePreview(jar,
        () => document.getElementById('language').value,
        () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
      );

      // Update currentLanguage if auto-detect is active and language was detected
      const languageSelect = document.getElementById('language');
      const isAutoDetect = (languageSelect?.value === 'Auto' || languageSelect?.value === '');
      if (isAutoDetect && languageSelect?.options) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto' || option.value === ''
        );
        if (autoDetectOption && autoDetectOption.textContent.includes('(')) {
          // Extract detected language from text like "Auto (javascript)"
          const match = autoDetectOption.textContent.match(/\(([^)]+)\)/);
          if (match) {
            currentLanguage = match[1];
          }
        }
      }
    }
  }

  function createPaste() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');

    if (!languageSelect) {
      alert('Language selector not available');
      return;
    }

    const language = languageSelect.value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);

    fetch('/', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error creating paste:', error);
      alert('Error creating paste: ' + error.message);
    });
  }

  // Initialize CodeJar and inject controls
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into the controls-group
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <input type="text" id="paste-title" placeholder="Title (optional)" class="controls-input">
        <select id="language" onchange="updateLanguage()" class="controls-select" aria-label="Select programming language">
          <option value="">Auto</option>
        </select>
        <button onclick="createPaste()" class="controls-button" title="Create Paste" aria-label="Create Paste">
          <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
        </button>
        <button onclick="window.togglePreview(window.jar, () => document.getElementById('language').value, () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai')" class="controls-button" title="Show Preview" id="controls-show-preview-button" aria-label="Show Preview" style="display: none;">
          <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
        </button>
        <button onclick="window.togglePreview(window.jar, () => document.getElementById('language').value, () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai')" class="controls-button" title="Hide Preview" id="controls-hide-preview-button" aria-label="Hide Preview" style="display: flex;">
          <i data-lucide="eye-off" style="width: 16px; height: 16px;"></i>
        </button>
        <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="help-circle" style="width: 16px; height: 16px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user" style="width: 16px; height: 16px;"></i>
        </a>
      `;
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');

    const editorElement = document.getElementById('editor');

    // Use shared highlight function
    jar = CodeJar(editorElement, (editor) => {
      if (typeof window.highlight === 'function') {
        window.highlight(editor, currentLanguage);
      }
    }, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Force Chivo Mono font application
    editorElement.style.fontFamily = "'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace";

    // Set keyboard focus on the editor
    editorElement.focus();

    // Export jar to window for external functions
    window.jar = jar;

    // Update preview on content change using debounced function
    jar.onUpdate(() => {
      if (typeof window.debouncedUpdatePreview === 'function') {
        debounceTimer = window.debouncedUpdatePreview(() => {
          window.updatePreview(window.jar,
            () => document.getElementById('language').value,
            () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
          );
        }, debounceTimer);
      } else {
        // Fallback if shared function not available
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          window.updatePreview(window.jar,
            () => document.getElementById('language').value,
            () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
          );
        }, 300);
      }
    });

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    const container = document.getElementById('editor-preview-container');
    const showButton = document.getElementById('controls-show-preview-button');
    const hideButton = document.getElementById('controls-hide-preview-button');

    if (previewHidden) {
      container.classList.add('preview-hidden');
      if (showButton) showButton.style.display = 'flex';
      if (hideButton) hideButton.style.display = 'none';
    } else {
      container.classList.remove('preview-hidden');
      if (showButton) showButton.style.display = 'none';
      if (hideButton) hideButton.style.display = 'flex';
    }

    // Initialize Lucide icons
    if (window.lucide) {
      window.lucide.createIcons();
    }

    // Initialize language options via API
    fetch('/api/languages')
      .then(response => response.json())
      .then(languages => {
        const languageSelect = document.getElementById('language');
        if (!languageSelect) {
          console.error('Language selector not found when trying to load languages');
          return;
        }
        languageSelect.innerHTML = '';
        languages.forEach(lang => {
          const option = document.createElement('option');
          // Handle if lang is an object with name property or a string
          const langName = typeof lang === 'object' ? lang.name || lang.value || JSON.stringify(lang) : lang;
          const langValue = typeof lang === 'object' ? lang.value || lang.name || JSON.stringify(lang) : lang;
          option.value = langValue;
          option.textContent = langName;
          languageSelect.appendChild(option);
        });

        // Initialize preview after languages are loaded
        updatePreview();
      })
      .catch(error => {
        console.error('Error loading languages:', error);
        // Still initialize preview even if language loading fails
        updatePreview();
      });
  });
</script>

<% unless current_user %>
  <div id="anon-warning" class="anon-warning" style="display:none;">
    <i data-lucide="info"></i>
    You are not logged in. Pastes created will not be associated with an account and cannot be edited later.
    <a href="/profile" style="margin-left:0.5em;">Log in to enable editing</a>
    <button id="anon-warning-dismiss" title="Dismiss" aria-label="Dismiss anonymous user warning" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:0.5em;font-size:1.1em;vertical-align:middle;">&times;</button>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (!localStorage.getItem('pasto_hide_anon_warning')) {
        document.getElementById('anon-warning').style.display = '';
      }
      document.getElementById('anon-warning-dismiss').onclick = function() {
        document.getElementById('anon-warning').style.display = 'none';
        localStorage.setItem('pasto_hide_anon_warning', 'true');
      };
      if (window.lucide) lucide.createIcons();
    });
  </script>
  <style>
    .anon-warning {
      background: var(--pico-secondary-background, #f5f7fa);
      color: var(--pico-color, #333);
      border: 1px solid var(--pico-muted-border-color, #cfd8dc);
      border-radius: var(--pico-border-radius, 6px);
      padding: 0.75em 1em;
      margin: 1em 0 0.5em 0;
      font-size: 0.97em;
      display: flex;
      align-items: center;
      gap: 0.5em;
      box-shadow: 0 1px 4px rgba(0,0,0,0.03);
    }
    .anon-warning i[data-lucide] {
      width: 20px;
      height: 20px;
      color: var(--pico-primary, #0074d9);
      flex-shrink: 0;
    }
    .anon-warning button {
      font-weight: bold;
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
      margin-left: 0.5em;
      font-size: 1.1em;
      line-height: 1;
      padding: 0 0.25em;
    }
    .anon-warning a {
      color: var(--pico-primary, #0074d9);
      text-decoration: underline;
      margin-left: 0.5em;
    }
    .anon-warning a:hover {
      text-decoration: none;
    }
  </style>
<% end %>

<div class="editor-preview-container">

  <div class="editor-pane">
    <div class="codejar-wrap">
      <div class="codejar-editor" id="editor"></div>
    </div>
  </div>
<style>
  .eye-overlay-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--pico-secondary-background);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s, background-color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .eye-overlay-btn:hover {
    opacity: 1;
    background: var(--pico-secondary-hover-background);
  }
  .eye-overlay-btn i, .eye-overlay-btn svg {
    width: 24px;
    height: 24px;
    color: var(--pico-primary);
  }
  .editor-md-preview {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--pico-card-background-color, var(--pico-background-color));
    color: var(--pico-color);
    padding: 1rem;
    overflow: auto;
    border: 2px solid var(--pico-primary);
    border-radius: var(--pico-border-radius);
    font-size: 0.95rem;
    z-index: 1;
  }
</style>

<script src="/assets/bundle.js" defer></script>
<script>
  // Markdown editor preview toggle logic
  let editorMarkdownShowing = false;
  function isEditorMarkdown() {
    const lang = (document.getElementById('language')?.value || '').toLowerCase();
    const title = (document.getElementById('paste-title')?.value || '').toLowerCase();
    // Try to get detected language from the preview (if present)
      const detected = (window.detectedLanguage || '').toLowerCase();
      return lang === 'markdown' || title.endsWith('.md') || detected === 'markdown';
  }

  function updateEditorMarkdownButton() {
    const btn = document.getElementById('editor-md-toggle');
    if (isEditorMarkdown()) {
      btn.style.display = '';
    } else {
      btn.style.display = 'none';
      if (editorMarkdownShowing) toggleEditorMarkdownView(true); // force source view
    }
  }

  function toggleEditorMarkdownView(forceSource) {
    const btn = document.getElementById('editor-md-toggle');
    const editor = document.getElementById('editor');
    const mdPreview = document.getElementById('editor-md-preview');
    const previewContent = document.getElementById('preview');
    if (!editorMarkdownShowing && !forceSource) {
      // Show rendered markdown in preview pane
      mdPreview.innerHTML = marked.parse(jar ? jar.toString() : '');
      previewContent.style.display = 'none';
      mdPreview.style.display = '';
      btn.innerHTML = '<i data-lucide="file-code-2"></i>';
      btn.title = 'Show source';
      lucide.createIcons();
      editorMarkdownShowing = true;
    } else {
      // Show source
      mdPreview.style.display = 'none';
      previewContent.style.display = '';
      btn.innerHTML = '<i data-lucide="eye"></i>';
      btn.title = 'Show rendered Markdown';
      lucide.createIcons();
      editorMarkdownShowing = false;
    }
  }

  function updateEditorMarkdownPreviewLive() {
    if (editorMarkdownShowing) {
      const preview = document.getElementById('editor-md-preview');
      preview.innerHTML = marked.parse(jar ? jar.toString() : '');
    }
  }
</script>

  <div class="preview-pane" style="position:relative;">
    <button class="eye-overlay-btn" id="editor-md-toggle" style="display:none; position:absolute; top:0.75rem; right:0.75rem;" title="Show rendered Markdown" onclick="toggleEditorMarkdownView()" aria-label="Toggle between code and markdown preview">
      <i data-lucide="eye"></i>
    </button>
    <div class="preview-content" id="preview">
      <pre><code>Start typing to see preview...</code></pre>
    </div>
    <div id="editor-md-preview" class="editor-md-preview" style="display:none;"></div>
  </div>
</div>

<!-- CodeJar and Highlight.js -->
<!-- highlight.js is now bundled in bundle.js -->

<style>
  .codejar-wrap {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .codejar-editor {
    flex: 1;
    min-height: 0;
    padding: 1rem;
    font-family: 'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    overflow: auto;
    outline: none;
    background: var(--pico-card-background-color, var(--pico-background-color));
    color: var(--pico-color);
    tab-size: 2;
    -moz-tab-size: 2;
    white-space: pre-wrap;
    word-wrap: break-word;
    border: 2px solid var(--pico-primary);
    border-radius: var(--pico-border-radius);
  }

  .codejar-editor:focus-within {
    box-shadow: 0 0 0 3px var(--pico-primary-focus);
  }

  .codejar-editor:empty::before {
    content: 'Paste your code here...';
    color: var(--pico-muted-color);
    pointer-events: none;
  }

  /* Highlight.js styling adjustments */
  .codejar-editor.hljs {
    background: transparent !important;
    padding: 0 !important;
  }
</style>

<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '';

  // Map common language names to highlight.js names
  function mapLanguage(lang) {
    if (!lang) return 'plaintext';
    const langLower = lang.toLowerCase();
    const mapping = {
      'c++': 'cpp',
      'c#': 'csharp',
      'objective-c': 'objectivec',
      'shell': 'bash',
      'dockerfile': 'docker',
      'console': 'bash',
      'text': 'plaintext',
      'plain text': 'plaintext',
      'crystal': 'ruby',  // Crystal is similar to Ruby
      'auto-detect': 'plaintext'
    };
    return mapping[langLower] || langLower;
  }

  // Highlight function for CodeJar
  function highlight(editor) {
    const code = editor.textContent;
    if (!code) return;
    
    const lang = currentLanguage || '';
    const mappedLang = mapLanguage(lang);
    
    try {
      if (mappedLang !== 'plaintext' && hljs.getLanguage(mappedLang)) {
        editor.innerHTML = hljs.highlight(code, { language: mappedLang, ignoreIllegals: true }).value;
      } else if (!lang || lang === '' || mappedLang === 'plaintext') {
        // Auto-detect mode or plaintext
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
      } else {
        // Unknown language, try auto-detection
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
      }
    } catch (e) {
      // Fallback to plain text
      editor.textContent = code;
    }
  }

  function debouncedUpdatePreview() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updatePreview, 300);
  }

  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    const container = document.querySelector('.editor-preview-container');
    const button = document.getElementById('preview-toggle');
    const isHidden = container.classList.toggle('preview-hidden');
    
    if (isHidden) {
      button.innerHTML = '<i data-lucide="eye-off"></i>';
      button.title = 'Show Preview';
    } else {
      button.innerHTML = '<i data-lucide="eye"></i>';
      button.title = 'Hide Preview';
      updatePreview(); // Refresh preview when shown
    }
    lucide.createIcons();
    
    // Save preference
    localStorage.setItem('previewHidden', isHidden);
  }

  function updatePreview() {
    const content = jar ? jar.toString() : '';
    const language = document.getElementById('language').value;
    const syntaxTheme = document.getElementById('syntax-theme').value;

    if (!content.trim()) {
      document.getElementById('preview').innerHTML = '<pre><code>Start typing to see preview...</code></pre>';
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('theme', syntaxTheme);

    fetch('/highlight', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      document.getElementById('preview').innerHTML = data.html;
      window.detectedLanguage = (data.detected_language || '').toLowerCase();
      console.log('Detected language:', window.detectedLanguage);
      updateEditorMarkdownButton();

      // Update language selector text to show detected language if auto-detection is active
      const languageSelect = document.getElementById('language');
      const isAutoDetect = (languageSelect.value === 'Auto-detect' || languageSelect.value === '');

      if (isAutoDetect) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto-detect' || option.value === ''
        );

        if (autoDetectOption) {
          if (data.detected_language) {
            autoDetectOption.textContent = `Auto-detect (${data.detected_language})`;
            // Update editor highlighting with detected language
            currentLanguage = data.detected_language;
          } else {
            autoDetectOption.textContent = 'Auto-detect';
          }
        }
      }
    })
    .catch(error => {
      console.error('Error updating preview:', error);
      document.getElementById('preview').innerHTML = '<pre><code>Error updating preview</code></pre>';
    });
  }

  function createPaste() {
    const content = jar ? jar.toString() : '';
    const language = document.getElementById('language').value;
    const title = document.getElementById('paste-title').value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('title', title);

    fetch('/', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error creating paste:', error);
      alert('Error creating paste: ' + error.message);
    });
  }

  // Initialize CodeJar on page load
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into top bar
    const topBarRight = document.querySelector('.top-bar-right');
    if (topBarRight) {
      topBarRight.insertAdjacentHTML('afterbegin', `
        <input type="text" id="paste-title" placeholder="Title (optional)" style="width: 200px; padding: 0.25rem 0.5rem; font-size: 0.85rem; margin: 0; height: auto;">
        <select id="language" onchange="updateLanguage()" aria-label="Select programming language">
            <!-- Preload Auto-detect for immediate responsiveness -->
            <option value="">Auto-detect</option>
          </select>
          <div id="language-loading" style="color: var(--muted-color); font-size: 0.8em; margin-top: 0.25rem;">
            Loading more languages...
          </div>
        <button onclick="createPaste()" title="Create Paste"><i data-lucide="plus"></i></button>
        <button id="preview-toggle" onclick="togglePreview()" title="Toggle Preview"><i data-lucide="eye"></i></button>
      `);
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');
    
    const editorElement = document.getElementById('editor');
    
    jar = CodeJar(editorElement, highlight, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Update preview on content change
    jar.onUpdate(() => {
      debouncedUpdatePreview();
      updateEditorMarkdownPreviewLive();
    });
  // Update markdown toggle button on language/title change
  document.getElementById('language').addEventListener('change', updateEditorMarkdownButton);
  document.getElementById('paste-title').addEventListener('input', updateEditorMarkdownButton);
  updateEditorMarkdownButton();

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    if (previewHidden) {
      document.querySelector('.editor-preview-container').classList.add('preview-hidden');
      document.getElementById('preview-toggle').innerHTML = '<i data-lucide="eye-off"></i>';
      document.getElementById('preview-toggle').title = 'Show Preview';
    }

    // Initialize Lucide icons
    lucide.createIcons();

    // Initialize
    updatePreview();
  });
</script>
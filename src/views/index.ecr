<% unless current_user %>
  <div id="anon-warning" class="anon-warning" style="display:none; margin: 1rem;">
    <i data-lucide="info"></i>
    You are not logged in. Pastes created will not be associated with an account and cannot be edited later.
    <a href="/profile" style="margin-left:0.5em;">Log in to enable editing</a>
    <button id="anon-warning-dismiss" title="Dismiss" aria-label="Dismiss anonymous user warning" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:0.5em;font-size:1.1em;vertical-align:middle;">&times;</button>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (!localStorage.getItem('pasto_hide_anon_warning')) {
        document.getElementById('anon-warning').style.display = '';
      }
      document.getElementById('anon-warning-dismiss').onclick = function() {
        document.getElementById('anon-warning').style.display = 'none';
        localStorage.setItem('pasto_hide_anon_warning', 'true');
      };
      if (window.lucide) lucide.createIcons();
    });
  </script>
  <style>
    .anon-warning {
      background: var(--pico-secondary-background);
      color: var(--pico-color);
      border: 1px solid var(--pico-border-color);
      border-radius: 6px;
      padding: 0.75em 1em;
      font-size: 0.97em;
      display: flex;
      align-items: center;
      gap: 0.5em;
      box-shadow: 0 1px 4px rgba(0,0,0,0.03);
    }
    .anon-warning i[data-lucide] {
      width: 20px;
      height: 20px;
      color: var(--pico-primary, #0074d9);
      flex-shrink: 0;
    }
    .anon-warning button {
      font-weight: bold;
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
      margin-left: 0.5em;
      font-size: 1.1em;
      line-height: 1;
      padding: 0 0.25em;
    }
    .anon-warning a {
      color: var(--pico-primary, #0074d9);
      text-decoration: underline;
      margin-left: 0.5em;
    }
    .anon-warning a:hover {
      text-decoration: none;
    }
  </style>
<% end %>

<div class="editor-preview-container preview-hidden" id="editor-preview-container">
  <div class="editor-pane">
    <div class="editor-wrapper">
      <div class="codejar-editor" id="editor"></div>
    </div>
  </div>

  <div class="preview-pane">
    <div class="preview-content" id="preview">
      <pre><code>Start typing to see preview...</code></pre>
    </div>
  </div>
</div>

<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '';

  // Map common language names to highlight.js names
  function mapLanguage(lang) {
    if (!lang) return 'plaintext';
    const langLower = lang.toLowerCase();
    const mapping = {
      'c++': 'cpp',
      'c#': 'csharp',
      'objective-c': 'objectivec',
      'shell': 'bash',
      'dockerfile': 'docker',
      'console': 'bash',
      'text': 'plaintext',
      'plain text': 'plaintext',
      'crystal': 'ruby',  // Crystal is similar to Ruby
      'auto-detect': 'plaintext'
    };
    return mapping[langLower] || langLower;
  }

  // Highlight function for CodeJar
  function highlight(editor) {
    const code = editor.textContent;
    if (!code) return;

    const lang = currentLanguage || '';
    const mappedLang = mapLanguage(lang);

    try {
      if (mappedLang !== 'plaintext' && hljs.getLanguage(mappedLang)) {
        const result = hljs.highlight(code, { language: mappedLang, ignoreIllegals: true });
        editor.innerHTML = result.value;
        // Apply CodeJar theme class
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        editor.className = isDark ? 'atom-one-dark' : 'atom-one-light';
      } else if (!lang || lang === '' || mappedLang === 'plaintext') {
        // Auto-detect mode or plaintext
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
        // Apply CodeJar theme class
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        editor.className = isDark ? 'atom-one-dark' : 'atom-one-light';
      } else {
        // Unknown language, try auto-detection
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
        // Apply CodeJar theme class
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        editor.className = isDark ? 'atom-one-dark' : 'atom-one-light';
      }
    } catch (e) {
      console.error('Highlight error:', e);
      // Fallback to plain text
      editor.textContent = code;
    }
  }

  function debouncedUpdatePreview() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updatePreview, 300);
  }

  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    const container = document.getElementById('editor-preview-container');
    const controlsIcon = document.querySelector('#controls-preview-button i[data-lucide]');

    const isHidden = container.classList.toggle('preview-hidden');

    // Update controls button icon (show regular eye when hidden, crossed eye when visible)
    if (controlsIcon) {
      if (isHidden) {
        controlsIcon.setAttribute('data-lucide', 'eye');
      } else {
        controlsIcon.setAttribute('data-lucide', 'eye-off');
      }
      if (window.lucide) lucide.createIcons();
    }

    if (!isHidden) {
      updatePreview(); // Refresh preview when shown
    }

    // Save preference
    localStorage.setItem('previewHidden', isHidden);
  }

  function updatePreview() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');
    // Get syntax theme from sidebar selector
    const syntaxThemeSelect = document.querySelector('#syntax-theme') || document.getElementById('syntax-theme');

    // Check if language selector exists
    if (!languageSelect) {
      console.warn('Language selector not available');
      return;
    }

    // Use fallback theme if syntax theme selector is not available
    const syntaxTheme = syntaxThemeSelect ? syntaxThemeSelect.value : 'monokai';
    const language = languageSelect.value;

    if (!content.trim()) {
      const previewElement = document.getElementById('preview');
      if (previewElement) {
        previewElement.innerHTML = '<pre><code>Start typing to see preview...</code></pre>';
      }
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('theme', syntaxTheme);

    fetch('/highlight', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      const previewElement = document.getElementById('preview');
      if (previewElement) {
        previewElement.innerHTML = data.html;
      }

      // Update language selector text to show detected language if auto-detection is active
      const isAutoDetect = (languageSelect.value === 'Auto-detect' || languageSelect.value === '');

      if (isAutoDetect) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto-detect' || option.value === ''
        );

        if (autoDetectOption) {
          if (data.detected_language) {
            autoDetectOption.textContent = `Auto-detect (${data.detected_language})`;
            // Update editor highlighting with detected language
            currentLanguage = data.detected_language;
          } else {
            autoDetectOption.textContent = 'Auto-detect';
          }
        }
      }
    })
    .catch(error => {
      console.error('Error updating preview:', error);
      const previewElement = document.getElementById('preview');
      if (previewElement) {
        previewElement.innerHTML = '<pre><code>Error updating preview</code></pre>';
      }
    });
  }

  function createPaste() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');

    if (!languageSelect) {
      alert('Language selector not available');
      return;
    }

    const language = languageSelect.value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);

    fetch('/', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error creating paste:', error);
      alert('Error creating paste: ' + error.message);
    });
  }

  // Initialize CodeJar and inject controls
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into the controls-group
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <input type="text" id="paste-title" placeholder="Title (optional)" class="controls-input">
        <select id="language" onchange="updateLanguage()" class="controls-select" aria-label="Select programming language">
          <option value="">Auto-detect</option>
        </select>
        <button onclick="createPaste()" class="controls-button" title="Create Paste" aria-label="Create Paste">
          <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
        </button>
        <button onclick="togglePreview()" class="controls-button" title="Toggle Preview" id="controls-preview-button" aria-label="Toggle Preview">
          <i data-lucide="eye-off" style="width: 16px; height: 16px;"></i>
        </button>
        <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="help-circle" style="width: 16px; height: 16px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user" style="width: 16px; height: 16px;"></i>
        </a>
      `;
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');

    const editorElement = document.getElementById('editor');

    jar = CodeJar(editorElement, highlight, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Force Chivo Mono font application
    editorElement.style.fontFamily = "'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace";

    // Set keyboard focus on the editor
    editorElement.focus();

    // Update preview on content change
    jar.onUpdate(() => {
      debouncedUpdatePreview();
    });

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    if (previewHidden) {
      document.getElementById('editor-preview-container').classList.add('preview-hidden');

      // Update controls button if it exists (show regular eye when hidden)
      const controlsIcon = document.querySelector('#controls-preview-button i[data-lucide]');
      if (controlsIcon) {
        controlsIcon.setAttribute('data-lucide', 'eye');
        if (window.lucide) window.lucide.createIcons();
      }
    }

    // Initialize Lucide icons
    if (window.lucide) {
      window.lucide.createIcons();
    }

    // Initialize language options via API
    fetch('/api/languages')
      .then(response => response.json())
      .then(languages => {
        const languageSelect = document.getElementById('language');
        if (!languageSelect) {
          console.error('Language selector not found when trying to load languages');
          return;
        }
        languageSelect.innerHTML = '';
        languages.forEach(lang => {
          const option = document.createElement('option');
          // Handle if lang is an object with name property or a string
          const langName = typeof lang === 'object' ? lang.name || lang.value || JSON.stringify(lang) : lang;
          const langValue = typeof lang === 'object' ? lang.value || lang.name || JSON.stringify(lang) : lang;
          option.value = langValue;
          option.textContent = langName;
          languageSelect.appendChild(option);
        });
      })
      .catch(error => console.error('Error loading languages:', error));

    // Initialize preview
    updatePreview();
  });
</script>
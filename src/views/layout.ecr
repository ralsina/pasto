<%# Include shared utilities and styles %>
<%= render "src/views/_shared_utils.ecr" %>
<%= render "src/views/_shared_styles.ecr" %>

<!DOCTYPE html>
<html lang="en" data-theme="<%= theme_vars[:resolved_pico_theme] %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pasto</title>
  <link rel="icon" type="image/png" href="/assets/favicon.png">

  <!-- PWA Manifest -->
  <link rel="manifest" href="/assets/manifest.json">
  <meta name="theme-color" content="#0172ad">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Pasto">

  <!-- Basic Meta Description for all pages -->
  <meta name="description" content="<%= meta_description %>">

  <!-- Social Media Meta Tags -->
  <% if meta_title %>
    <meta property="og:title" content="<%= meta_title %>">
  <% end %>
  <% if meta_description %>
    <meta property="og:description" content="<%= meta_description %>">
  <% end %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Pasto">
  <% if meta_url && !meta_url.empty? %>
    <meta property="og:url" content="<%= meta_url %>">
  <% end %>
  <% if meta_image && !meta_image.empty? %>
    <meta property="og:image" content="<%= meta_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  <% end %>

  <% # Twitter Card tags if we have enough data %>
  <% if meta_title && meta_description %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= meta_title %>">
    <meta name="twitter:description" content="<%= meta_description %>">
    <% if meta_image && !meta_image.empty? %>
      <meta name="twitter:image" content="<%= meta_image %>">
    <% end %>
  <% end %>

  <!-- Async CSS loading with correct themes from server -->
  <link rel="preload" href="/assets/<%= theme_vars[:pico_theme_file] %>" as="style" onload="loadCSS(this, 'pico-css-link')">
  <link rel="preload" href="/syntax/<%= theme_vars[:saved_syntax_theme] %>/<%= theme_vars[:resolved_pico_theme] %>" as="style" onload="loadCSS(this, 'highlight-css-link')">

  
  <script>
    // Async CSS loading function
    function loadCSS(link, id) {
      // Create a proper stylesheet link
      var stylesheet = document.createElement('link');
      stylesheet.rel = 'stylesheet';
      stylesheet.href = link.href;
      stylesheet.id = id;

      // Replace the preload link
      link.parentNode.replaceChild(stylesheet, link);
    }
  </script>
  <script src="/assets/bundle.js" defer></script>
  <!-- Encryption functionality -->
  <script src="/assets/crypto.js" defer></script>
  <!-- Language mapping for syntax highlighting -->
  <script src="/assets/language-mapping.js" defer></script>
  <!-- Shared editor functionality -->
  <script src="/assets/editor-shared.js" defer></script>
  <script src="/assets/mobile_controls.js" defer></script>
  <!-- Service Worker Registration -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/assets/sw.js')
          .then(function(registration) {
            console.log('ServiceWorker registration successful with scope: ', registration.scope);
          })
          .catch(function(error) {
            console.log('ServiceWorker registration failed: ', error);
          });
      });
    }
  </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Async Google Fonts loading -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700&family=Chivo+Mono:wght@400;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">

  <!-- Fallback for browsers that don't support preload -->
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700&family=Chivo+Mono:wght@400;700&display=swap" rel="stylesheet">
  </noscript>

  <%= render "src/views/_critical_css.ecr" %>
</head>
<body>
  <div class="app-layout">
    <!-- Sidebar -->
    <aside class="sidebar collapsed" id="sidebar">
      <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle sidebar">
        <span id="toggle-icon">☰</span>
      </button>

      <div class="sidebar-content">
        <div style="padding: 1rem; position: relative;">
        <!-- Combined SVG with text and grass -->
        <svg viewBox="0 0 300 50" preserveAspectRatio="xMidYMid meet" style="width: 100%; height: 50px; display: block;">
          <!-- Pasto text -->
          <a href="https://github.com/ralsina/pasto" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">
            <text x="10" y="35" font-family="inherit" font-size="48" font-weight="300" fill="var(--pico-primary, #0074d9)" style="cursor: pointer;">Pasto</text>
          </a>

          <!-- Grass will be generated here -->
          <g id="grass-svg-container"></g>
        </svg>
      </div>

      <!-- Controls will be injected here for mobile -->
      <div class="mobile-controls" id="mobile-controls" style="padding: 0 1rem 1rem 1rem;">
      </div>

      <div class="sidebar-section" style="padding: 0 1rem 1rem 1rem;">

        <div class="theme-group" style="margin-bottom: 1rem; margin-top: 0;">
          <label style="display: block; font-weight: 400; margin-bottom: 0.5rem; font-size: 0.9rem; font-family: 'Chivo', 'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace;">UI Theme:</label>
          <select id="pico-theme" onchange="updateThemes()" style="width: 100%; font-size: 0.9rem;">
            <option value="auto" <%= theme_vars[:saved_pico_theme] == "auto" ? "selected" : "" %>>Auto (System)</option>
            <option value="light" <%= theme_vars[:saved_pico_theme] == "light" ? "selected" : "" %>>Light</option>
            <option value="dark" <%= theme_vars[:saved_pico_theme] == "dark" ? "selected" : "" %>>Dark</option>
          </select>
        </div>

        <div class="theme-group" style="margin-bottom: 1rem;">
          <label style="display: block; font-weight: 400; margin-bottom: 0.5rem; font-size: 0.9rem; font-family: 'Chivo', 'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace;">Color Scheme:</label>
          <select id="pico-color" onchange="updateThemes()" style="width: 100%; font-size: 0.9rem;">
            <% color_options = ["css", "red", "pink", "fuchsia", "purple", "violet", "indigo", "blue", "cyan", "jade", "green", "lime", "yellow", "amber", "pumpkin", "orange", "sand", "grey", "zinc", "slate"] %>
            <% color_names = ["Azure", "Red", "Pink", "Fuchsia", "Purple", "Violet", "Indigo", "Blue", "Cyan", "Jade", "Green", "Lime", "Yellow", "Amber", "Pumpkin", "Orange", "Sand", "Grey", "Zinc", "Slate"] %>
            <% color_options.each_with_index do |color, index| %>
              <option value="<%= color %>" <%= theme_vars[:saved_pico_color] == color ? "selected" : "" %>><%= color_names[index] %></option>
            <% end %>
          </select>
        </div>

        <div class="theme-group" style="margin-bottom: 1rem;">
          <label style="display: block; font-weight: 400; margin-bottom: 0.5rem; font-size: 0.9rem; font-family: 'Chivo', 'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace;">Syntax Highlighting:</label>
          <select id="syntax-theme" onchange="updateThemes()" style="width: 100%; font-size: 0.9rem;">
            <!-- Themes will be loaded via API -->
          </select>
        </div>
      </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Controls -->
      <div class="controls" id="main-controls">
        <div class="controls-group" id="controls-group">
          <!-- Page-specific controls will be injected here -->
        </div>
      </div>

      <!-- Content Area -->
      <div class="content-area">
        <%= content %>
      </div>
    </main>
  </div>

  <script>
    // Function to handle mobile controls placement - simplified version
    // Include mobile controls functionality from external file
    // The handleMobileControls function is loaded from mobile_controls.js

    // Sidebar toggle function
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const toggleIcon = document.getElementById('toggle-icon');

      sidebar.classList.toggle('collapsed');

      // Handle controls placement based on new sidebar state
      handleMobileControls();

      // Update toggle icon
      const isCollapsed = sidebar.classList.contains('collapsed');
      toggleIcon.textContent = isCollapsed ? '☰' : '✕';

      // Save preference
      localStorage.setItem('sidebarCollapsed', isCollapsed);
    }

    // Generate 200 grass blades inside SVG
    function generateGrass() {
      const grassContainer = document.getElementById('grass-svg-container');
      if (!grassContainer) return;

      const grassColors = ['#4ade80', '#22c55e', '#16a34a', '#15803d', '#166534'];

      for (let i = 0; i < 200; i++) {
        const x = Math.random() * 300;
        const height = 3.75 + Math.random() * 7.5; // Random height between 3.75-11.25 (50% shorter)
        const curve = Math.random() * 4 - 2; // Random curve between -2 to 2
        const strokeWidth = 0.5 + Math.random() * 1.5; // Random width between 0.5-2
        const color = grassColors[Math.floor(Math.random() * grassColors.length)];
        const delay = Math.random() * 2; // Random delay for more organic growth

        // Create curved path for grass growing from y=35 (text baseline)
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        const d = `M${x},35 Q${x + curve},${35 - height/2} ${x + curve/2},${35 - height} Q${x - curve/2},${35 - height/2} ${x},35`;

        path.setAttribute('d', d);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', color);
        path.setAttribute('stroke-width', strokeWidth);
        path.classList.add('grass-blade');
        path.style.animationDelay = `${delay}s`;

        grassContainer.appendChild(path);
      }
    }

    // Initialize sidebar state and generate grass
    document.addEventListener('DOMContentLoaded', function() {
      const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') !== 'false'; // Default to collapsed
      const sidebar = document.getElementById('sidebar');
      const toggleIcon = document.getElementById('toggle-icon');

      if (sidebarCollapsed) {
        sidebar.classList.add('collapsed');
        toggleIcon.textContent = '☰';
      } else {
        sidebar.classList.remove('collapsed');
        toggleIcon.textContent = '✕';
      }

      // Generate grass on page load
      generateGrass();

      // Handle mobile controls on page load
      handleMobileControls();

      // Add resize listener to handle mobile/desktop transitions
      window.addEventListener('resize', function() {
        handleMobileControls();
      });

      // Initialize Lucide icons using shared utility
      if (window.SharedIcons) {
        window.SharedIcons.init(document.body);
      } else if (window.lucide) {
        window.lucide.createIcons();
      }
    });

    // Theme update functions
    function updateThemes() {
      const picoTheme = document.getElementById('pico-theme').value;
      const picoColor = document.getElementById('pico-color').value;
      const syntaxTheme = document.getElementById('syntax-theme').value;

      // Check if user is logged in using current_user variable
      const isUserLoggedIn = <%= current_user ? "true" : "false" %>;

      // Update Pico CSS
      const picoLink = document.getElementById('pico-css-link');
      if (picoLink) {
        picoLink.href = `/assets/${picoColor === 'css' ? 'pico.min.css' : 'pico.' + picoColor + '.min.css'}`;
      }

      // Update syntax theme
      const syntaxLink = document.getElementById('highlight-css-link');
      if (syntaxLink) {
        syntaxLink.href = `/syntax/${syntaxTheme}/${picoTheme === 'dark' ? 'dark' : 'light'}`;
      }

      // CodeJar theme is now handled by the enhanced /syntax endpoint

      // Calculate resolved theme for data-theme attribute
      const resolvedTheme = picoTheme === 'auto' ?
        (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') :
        picoTheme;

      // Save to server for logged-in users
      if (isUserLoggedIn) {
        saveThemesToServer(picoTheme, picoColor, syntaxTheme);
      } else {
        // For anonymous users, save to localStorage only
        localStorage.setItem('picoTheme', picoTheme);
        localStorage.setItem('picoColor', picoColor);
        localStorage.setItem('syntaxTheme', syntaxTheme);
      }

      // Update data-theme attribute
      document.documentElement.setAttribute('data-theme', resolvedTheme);
    }

    // Save themes to server for logged-in users
    function saveThemesToServer(picoTheme, picoColor, syntaxTheme) {
      const formData = new FormData();
      formData.append('pico_theme', picoTheme);
      formData.append('pico_color', picoColor);
      formData.append('syntax_theme', syntaxTheme);

      fetch('/profile', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      })
      .then(response => {
        if (response.ok) {
          console.log('Theme preferences saved successfully');
          // Optionally show success feedback
        } else {
          console.error('Failed to save theme preferences');
          // Optionally show error feedback
        }
      })
      .catch(error => {
        console.error('Error saving theme preferences:', error);
        // Themes are still saved to localStorage as fallback
      });
    }

    // Load saved theme preferences
    document.addEventListener('DOMContentLoaded', function() {
      // Check if user is logged in
      const isUserLoggedIn = <%= current_user ? "true" : "false" %>;

      if (isUserLoggedIn) {
        // For logged-in users, server has provided specific theme preferences
        // Set select elements to show server preferences
        document.getElementById('pico-theme').value = '<%= theme_vars[:saved_pico_theme] %>';
        document.getElementById('pico-color').value = '<%= theme_vars[:saved_pico_color] %>';

        // Don't call updateThemes() - server already set the correct theme
        console.log('Logged-in user detected: using server-side themes', {
          pico_theme: '<%= theme_vars[:saved_pico_theme] %>',
          pico_color: '<%= theme_vars[:saved_pico_color] %>',
          syntax_theme: '<%= theme_vars[:saved_syntax_theme] %>'
        });

        // Make syntax theme available to JavaScript
        window.pastoSyntaxTheme = '<%= theme_vars[:saved_syntax_theme] %>';
      } else {
        // For anonymous users, use localStorage preferences
        const savedPicoTheme = localStorage.getItem('picoTheme') || 'auto';
        const savedPicoColor = localStorage.getItem('picoColor') || 'slate';
        const savedSyntaxTheme = localStorage.getItem('syntaxTheme') || 'default';

        document.getElementById('pico-theme').value = savedPicoTheme;
        document.getElementById('pico-color').value = savedPicoColor;
        // Don't set syntax theme value yet - will be set after themes load

        console.log('Anonymous user detected: using localStorage themes', {
          pico_theme: savedPicoTheme,
          pico_color: savedPicoColor,
          syntax_theme: savedSyntaxTheme
        });

        // Make syntax theme available to JavaScript
        window.pastoSyntaxTheme = savedSyntaxTheme;
      }

      // Load syntax themes via API
      fetch('/api/themes')
        .then(response => response.json())
        .then(themes => {
          const syntaxSelect = document.getElementById('syntax-theme');
          syntaxSelect.innerHTML = '';

          // Determine the current theme at runtime
          let currentTheme;
          const isUserLoggedIn = <%= current_user ? "true" : "false" %>;

          if (isUserLoggedIn) {
            // Logged-in user with server-provided theme
            currentTheme = '<%= theme_vars[:saved_syntax_theme] %>';
          } else {
            // Anonymous user, use localStorage or default
            currentTheme = localStorage.getItem('syntaxTheme') || 'default';
          }

          themes.forEach(theme => {
            const option = document.createElement('option');
            option.value = theme.name;
            option.textContent = theme.name;
            option.selected = theme.name === currentTheme;
            syntaxSelect.appendChild(option);
          });

          // Now that themes are loaded and selected, update the themes
          updateThemes();
        })
        .catch(error => console.error('Error loading themes:', error));
    });
  </script>
<%= render "src/views/_modal_utils.ecr" %>
</body>
</html>
<%= render "src/views/_editor_container.ecr" %>


<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '<%= paste.language || "" %>';
  const pasteId = '<%= paste.sepia_id %>';
  const initialContent = <%= paste.content.to_json %>;
  const initialTitle = <%= (paste.title || "").to_json %>;

  // Use shared functions from external module
  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language using shared function
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    // Use shared togglePreview function
    if (typeof window.togglePreview === 'function') {
      window.togglePreview(jar,
        () => document.getElementById('language').value,
        () => document.getElementById('syntax-theme')?.value || 'monokai'
      );
    }

    // Update edit-specific UI elements
    const container = document.getElementById('editor-preview-container');
    const isHidden = container.classList.contains('preview-hidden');
  }

  function updatePreview() {
    // Use shared updatePreview function
    if (typeof window.updatePreview === 'function') {
      window.updatePreview(jar,
        () => document.getElementById('language').value,
        () => document.getElementById('syntax-theme')?.value || 'monokai'
      );

      // Update currentLanguage if auto-detect is active and language was detected
      const languageSelect = document.getElementById('language');
      const isAutoDetect = (languageSelect?.value === 'Auto' || languageSelect?.value === '');
      if (isAutoDetect && languageSelect?.options) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto' || option.value === ''
        );
        if (autoDetectOption && autoDetectOption.textContent.includes('(')) {
          // Extract detected language from text like "Auto (javascript)"
          const match = autoDetectOption.textContent.match(/\(([^)]+)\)/);
          if (match) {
            currentLanguage = match[1];
          }
        }
      }
    }
  }

  function updatePaste() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');
    const titleSelect = document.getElementById('paste-title');

    if (!languageSelect || !titleSelect) {
      alert('Language or title selector not available');
      return;
    }

    const language = languageSelect.value;
    const title = titleSelect.value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('title', title);

    // Add expiration if selected
    const expirationSelect = document.getElementById('expiration');
    if (expirationSelect && expirationSelect.value) {
      formData.append('expiration', expirationSelect.value);
    }

    fetch('/' + pasteId + '/edit', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else if (response.ok) {
        window.location.href = '/' + pasteId;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error updating paste:', error);
      alert('Error updating paste: ' + error.message);
    });
  }

  // Initialize CodeJar on page load
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into the controls-group
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="plus" style="width: 20px; height: 20px;"></i>
        </a>
        <input type="text" id="paste-title" value="${initialTitle}" placeholder="Title (optional)" class="controls-input">
        <select id="language" onchange="updateLanguage()" class="controls-select" aria-label="Select programming language">
          <!-- Preload Auto and paste's language for immediate responsiveness -->
          <option value="">Auto</option>
          <% if lang = paste.language %>
          <% if !lang.empty? %>
          <option value="<%= lang.downcase %>" selected><%= lang %></option>
          <% end %>
          <% end %>
        </select>
        <select id="expiration" class="controls-select" aria-label="Select expiration time" title="Set paste expiration time">
          <option value="">Never</option>
          <option value="10m">10 minutes</option>
          <option value="1h">1 hour</option>
          <option value="1d">1 day</option>
          <option value="1w">1 week</option>
          <option value="1M">1 month</option>
          <option value="view-once">View Once 🔥</option>
        </select>
        <button onclick="updatePaste()" class="controls-button" title="Save Changes" aria-label="Save Changes">
          <i data-lucide="save" style="width: 20px; height: 20px;"></i>
        </button>
        <button onclick="window.togglePreview(window.jar, () => document.getElementById('language').value, () => document.getElementById('syntax-theme')?.value || 'monokai')" class="controls-button" title="Show Preview" id="controls-show-preview-button" aria-label="Show Preview" style="display: none;">
          <i data-lucide="eye" style="width: 20px; height: 20px;"></i>
        </button>
        <button onclick="window.togglePreview(window.jar, () => document.getElementById('language').value, () => document.getElementById('syntax-theme')?.value || 'monokai')" class="controls-button" title="Hide Preview" id="controls-hide-preview-button" aria-label="Hide Preview" style="display: flex;">
          <i data-lucide="eye-off" style="width: 20px; height: 20px;"></i>
        </button>
        <a href="/${pasteId}" class="controls-button" title="Cancel" aria-label="Cancel" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="x" style="width: 20px; height: 20px;"></i>
        </a>
        <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="help-circle" style="width: 20px; height: 20px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user" style="width: 20px; height: 20px;"></i>
        </a>
      `;
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');

    const editorElement = document.getElementById('editor');

    // Use shared highlight function
    jar = CodeJar(editorElement, (editor) => {
      if (typeof window.highlight === 'function') {
        window.highlight(editor, currentLanguage);
      }
    }, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Force Chivo Mono font application
    editorElement.style.fontFamily = "'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace";

    // Set keyboard focus on the editor
    editorElement.focus();

    // Set initial content
    jar.updateCode(initialContent);

    // Export jar to window for external functions
    window.jar = jar;

    // Update preview on content change using debounced function
    jar.onUpdate(() => {
      if (typeof window.debouncedUpdatePreview === 'function') {
        debounceTimer = window.debouncedUpdatePreview(() => {
          window.updatePreview(window.jar,
            () => document.getElementById('language').value,
            () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
          );
        }, debounceTimer);
      } else {
        // Fallback if shared function not available
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          window.updatePreview(window.jar,
            () => document.getElementById('language').value,
            () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
          );
        }, 300);
      }
    });

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    const container = document.getElementById('editor-preview-container');
    const showButton = document.getElementById('controls-show-preview-button');
    const hideButton = document.getElementById('controls-hide-preview-button');

    if (previewHidden) {
      container.classList.add('preview-hidden');
      if (showButton) showButton.style.display = 'flex';
      if (hideButton) hideButton.style.display = 'none';
    } else {
      container.classList.remove('preview-hidden');
      if (showButton) showButton.style.display = 'none';
      if (hideButton) hideButton.style.display = 'flex';
    }

    // Initialize Lucide icons
    if (window.lucide) {
      window.lucide.createIcons();
    }

    // Initialize language options via API
    fetch('/api/languages')
      .then(response => response.json())
      .then(languages => {
        const languageSelect = document.getElementById('language');
        const currentValue = languageSelect.value;
        languageSelect.innerHTML = '<option value="">Auto</option>';

        // Add paste's current language if it exists
        <% if lang = paste.language %>
        <% if !lang.empty? %>
        const currentOption = document.createElement('option');
        currentOption.value = '<%= lang.downcase %>';
        currentOption.textContent = '<%= lang %>';
        currentOption.selected = true;
        languageSelect.appendChild(currentOption);
        <% end %>
        <% end %>

        // Add all available languages
        languages.forEach(langObj => {
          // langObj is an object with {name: "...", value: "..."}
          if (langObj && langObj.name && langObj.value) {
            // Skip if this is the current language (already added)
            if (langObj.value.toLowerCase() !== '<%= (paste.language || "").downcase %>') {
              const option = document.createElement('option');
              option.value = langObj.value;
              option.textContent = langObj.name;
              languageSelect.appendChild(option);
            }
          }
        });
      })
      .catch(error => console.error('Error loading languages:', error));

    // Initialize preview
    updatePreview();
  });
</script>

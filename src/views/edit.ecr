<div class="editor-preview-container" id="editor-preview-container">
  <div class="editor-pane">
    <div class="editor-wrapper">
      <div class="codejar-editor" id="editor"></div>
    </div>
  </div>

  <div class="preview-pane">
    <div class="preview-content" id="preview">
      <pre><code>Loading...</code></pre>
    </div>
  </div>
</div>


<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '<%= paste.language || "" %>';
  const pasteId = '<%= paste.sepia_id %>';
  const initialContent = <%= paste.content.to_json %>;
  const initialTitle = <%= (paste.title || "").to_json %>;

  // Map common language names to highlight.js names
  function mapLanguage(lang) {
    if (!lang) return 'plaintext';
    const langLower = lang.toLowerCase();
    const mapping = {
      'c++': 'cpp',
      'c#': 'csharp',
      'objective-c': 'objectivec',
      'shell': 'bash',
      'dockerfile': 'docker',
      'console': 'bash',
      'text': 'plaintext',
      'plain text': 'plaintext',
      'crystal': 'ruby',  // Crystal is similar to Ruby
      'auto-detect': 'plaintext'
    };
    return mapping[langLower] || langLower;
  }

  // Highlight function for CodeJar
  function highlight(editor) {
    const code = editor.textContent;
    if (!code) return;
    
    const lang = currentLanguage || '';
    const mappedLang = mapLanguage(lang);
    
    try {
      if (mappedLang !== 'plaintext' && hljs.getLanguage(mappedLang)) {
        editor.innerHTML = hljs.highlight(code, { language: mappedLang, ignoreIllegals: true }).value;
      } else if (!lang || lang === '' || mappedLang === 'plaintext') {
        // Auto-detect mode or plaintext
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
      } else {
        // Unknown language, try auto-detection
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
      }
    } catch (e) {
      // Fallback to plain text
      editor.textContent = code;
    }
  }

  function debouncedUpdatePreview() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updatePreview, 300);
  }

  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    const container = document.getElementById('editor-preview-container');
    const previewButton = document.getElementById('preview-text');
    const controlsButton = document.getElementById('controls-preview-text');
    const controlsIcon = document.querySelector('#controls-preview-button i[data-lucide]');

    const isHidden = container.classList.toggle('preview-hidden');

    if (isHidden) {
      // Update preview pane header button
      previewButton.textContent = 'Show';
      previewButton.title = 'Show Preview';

      // Update controls button
      if (controlsButton) controlsButton.textContent = 'Show Preview';
      if (controlsIcon) {
        controlsIcon.setAttribute('data-lucide', 'eye-off');
        if (window.lucide) lucide.createIcons();
      }
    } else {
      // Update preview pane header button
      previewButton.textContent = 'Hide';
      previewButton.title = 'Hide Preview';

      // Update controls button
      if (controlsButton) controlsButton.textContent = 'Preview';
      if (controlsIcon) {
        controlsIcon.setAttribute('data-lucide', 'eye');
        if (window.lucide) lucide.createIcons();
      }

      updatePreview(); // Refresh preview when shown
    }

    // Save preference
    localStorage.setItem('previewHidden', isHidden);
  }

  function updatePreview() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');
    const syntaxThemeSelect = document.getElementById('syntax-theme');

    // Check if elements exist before accessing their values
    if (!languageSelect || !syntaxThemeSelect) {
      console.warn('Language or syntax theme selectors not available');
      return;
    }

    const language = languageSelect.value;
    const syntaxTheme = syntaxThemeSelect.value;

    if (!content.trim()) {
      const previewElement = document.getElementById('preview');
      if (previewElement) {
        previewElement.innerHTML = '<pre><code>Start typing to see preview...</code></pre>';
      }
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('theme', syntaxTheme);

    fetch('/highlight', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      const previewElement = document.getElementById('preview');
      if (previewElement) {
        previewElement.innerHTML = data.html;
      }

      // Update language selector text to show detected language if auto-detection is active
      const isAutoDetect = (languageSelect.value === 'Auto-detect' || languageSelect.value === '');

      if (isAutoDetect) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto-detect' || option.value === ''
        );

        if (autoDetectOption) {
          if (data.detected_language) {
            autoDetectOption.textContent = `Auto-detect (${data.detected_language})`;
            // Update editor highlighting with detected language
            currentLanguage = data.detected_language;
          } else {
            autoDetectOption.textContent = 'Auto-detect';
          }
        }
      }
    })
    .catch(error => {
      console.error('Error updating preview:', error);
      const previewElement = document.getElementById('preview');
      if (previewElement) {
        previewElement.innerHTML = '<pre><code>Error updating preview</code></pre>';
      }
    });
  }

  function updatePaste() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');
    const titleSelect = document.getElementById('paste-title');

    if (!languageSelect || !titleSelect) {
      alert('Language or title selector not available');
      return;
    }

    const language = languageSelect.value;
    const title = titleSelect.value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('title', title);

    fetch('/' + pasteId + '/edit', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else if (response.ok) {
        window.location.href = '/' + pasteId;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error updating paste:', error);
      alert('Error updating paste: ' + error.message);
    });
  }

  // Initialize CodeJar on page load
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into the controls-group
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <input type="text" id="paste-title" value="${initialTitle}" placeholder="Title (optional)" class="controls-input">
        <select id="language" onchange="updateLanguage()" class="controls-select" aria-label="Select programming language">
          <!-- Preload Auto-detect and paste's language for immediate responsiveness -->
          <option value="">Auto-detect</option>
          <% if lang = paste.language %>
          <% if !lang.empty? %>
          <option value="<%= lang.downcase %>" selected><%= lang %></option>
          <% end %>
          <% end %>
        </select>
        <button onclick="updatePaste()" class="controls-button" title="Save Changes">
          <i data-lucide="save" style="width: 16px; height: 16px;"></i>
          Save
        </button>
        <button onclick="togglePreview()" class="controls-button" title="Toggle Preview" id="controls-preview-button">
          <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
          <span id="controls-preview-text">Preview</span>
        </button>
        <a href="/${pasteId}" class="controls-button" title="Cancel" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="x" style="width: 16px; height: 16px;"></i>
          Cancel
        </a>
        <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="help-circle" style="width: 16px; height: 16px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user" style="width: 16px; height: 16px;"></i>
        </a>
      `;
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');
    
    const editorElement = document.getElementById('editor');
    
    jar = CodeJar(editorElement, highlight, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Force Chivo Mono font application
    editorElement.style.fontFamily = "'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace";

    // Set keyboard focus on the editor
    editorElement.focus();

    // Set initial content
    jar.updateCode(initialContent);

    // Update preview on content change
    jar.onUpdate(() => {
      debouncedUpdatePreview();
    });

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    if (previewHidden) {
      document.getElementById('editor-preview-container').classList.add('preview-hidden');
      document.getElementById('preview-text').textContent = 'Show';

      // Update controls button if it exists
      const controlsButton = document.getElementById('controls-preview-text');
      const controlsIcon = document.querySelector('#controls-preview-button i[data-lucide]');
      if (controlsButton) controlsButton.textContent = 'Show Preview';
      if (controlsIcon) {
        controlsIcon.setAttribute('data-lucide', 'eye-off');
        if (window.lucide) window.lucide.createIcons();
      }
    }

    // Initialize Lucide icons
    if (window.lucide) {
      window.lucide.createIcons();
    }

    // Initialize language options via API
    fetch('/api/languages')
      .then(response => response.json())
      .then(languages => {
        const languageSelect = document.getElementById('language');
        const currentValue = languageSelect.value;
        languageSelect.innerHTML = '<option value="">Auto-detect</option>';

        // Add paste's current language if it exists
        <% if lang = paste.language %>
        <% if !lang.empty? %>
        const currentOption = document.createElement('option');
        currentOption.value = '<%= lang.downcase %>';
        currentOption.textContent = '<%= lang %>';
        currentOption.selected = true;
        languageSelect.appendChild(currentOption);
        <% end %>
        <% end %>

        // Add all available languages
        languages.forEach(lang => {
          // Skip if this is the current language (already added)
          if (lang.toLowerCase() !== '<%= (paste.language || "").downcase %>') {
            const option = document.createElement('option');
            option.value = lang;
            option.textContent = lang;
            languageSelect.appendChild(option);
          }
        });
      })
      .catch(error => console.error('Error loading languages:', error));

    // Initialize preview
    updatePreview();
  });
</script>

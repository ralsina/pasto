<div class="editor-preview-container">
  <div class="editor-pane">
    <div class="codejar-wrap">
      <div class="codejar-editor" id="editor"></div>
    </div>
  </div>

  <div class="preview-pane">
    <div class="preview-content" id="preview">
      <pre><code>Loading...</code></pre>
    </div>
  </div>
</div>

<!-- CodeJar and Highlight.js -->
<!-- highlight.js is now bundled in bundle.js -->

<style>
  .codejar-wrap {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .codejar-editor {
    flex: 1;
    min-height: 0;
    padding: 1rem;
    font-family: 'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    overflow: auto;
    outline: none;
    background: var(--pico-card-background-color, var(--pico-background-color));
    color: var(--pico-color);
    tab-size: 2;
    -moz-tab-size: 2;
    white-space: pre-wrap;
    word-wrap: break-word;
    border: 2px solid var(--pico-primary);
    border-radius: var(--pico-border-radius);
  }

  .codejar-editor:focus-within {
    box-shadow: 0 0 0 3px var(--pico-primary-focus);
  }

  .codejar-editor:empty::before {
    content: 'Enter your code here...';
    color: var(--pico-muted-color);
    pointer-events: none;
  }

  /* Highlight.js styling adjustments */
  .codejar-editor.hljs {
    background: transparent !important;
    padding: 0 !important;
  }
</style>

<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '<%= paste.language || "" %>';
  const pasteId = '<%= paste.sepia_id %>';
  const initialContent = <%= paste.content.to_json %>;
  const initialTitle = <%= (paste.title || "").to_json %>;

  // Map common language names to highlight.js names
  function mapLanguage(lang) {
    if (!lang) return 'plaintext';
    const langLower = lang.toLowerCase();
    const mapping = {
      'c++': 'cpp',
      'c#': 'csharp',
      'objective-c': 'objectivec',
      'shell': 'bash',
      'dockerfile': 'docker',
      'console': 'bash',
      'text': 'plaintext',
      'plain text': 'plaintext',
      'crystal': 'ruby',  // Crystal is similar to Ruby
      'auto-detect': 'plaintext'
    };
    return mapping[langLower] || langLower;
  }

  // Highlight function for CodeJar
  function highlight(editor) {
    const code = editor.textContent;
    if (!code) return;
    
    const lang = currentLanguage || '';
    const mappedLang = mapLanguage(lang);
    
    try {
      if (mappedLang !== 'plaintext' && hljs.getLanguage(mappedLang)) {
        editor.innerHTML = hljs.highlight(code, { language: mappedLang, ignoreIllegals: true }).value;
      } else if (!lang || lang === '' || mappedLang === 'plaintext') {
        // Auto-detect mode or plaintext
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
      } else {
        // Unknown language, try auto-detection
        const result = hljs.highlightAuto(code);
        editor.innerHTML = result.value;
      }
    } catch (e) {
      // Fallback to plain text
      editor.textContent = code;
    }
  }

  function debouncedUpdatePreview() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updatePreview, 300);
  }

  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    const container = document.querySelector('.editor-preview-container');
    const button = document.getElementById('preview-toggle');
    const isHidden = container.classList.toggle('preview-hidden');
    
    if (isHidden) {
      button.innerHTML = '<i data-lucide="eye-off"></i>';
      button.title = 'Show Preview';
    } else {
      button.innerHTML = '<i data-lucide="eye"></i>';
      button.title = 'Hide Preview';
      updatePreview(); // Refresh preview when shown
    }
    lucide.createIcons();
    
    // Save preference
    localStorage.setItem('previewHidden', isHidden);
  }

  function updatePreview() {
    const content = jar ? jar.toString() : '';
    const language = document.getElementById('language').value;
    const syntaxTheme = document.getElementById('syntax-theme').value;

    if (!content.trim()) {
      document.getElementById('preview').innerHTML = '<pre><code>Start typing to see preview...</code></pre>';
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('theme', syntaxTheme);

    fetch('/highlight', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      document.getElementById('preview').innerHTML = data.html;

      // Update language selector text to show detected language if auto-detection is active
      const languageSelect = document.getElementById('language');
      const isAutoDetect = (languageSelect.value === 'Auto-detect' || languageSelect.value === '');

      if (isAutoDetect) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto-detect' || option.value === ''
        );

        if (autoDetectOption) {
          if (data.detected_language) {
            autoDetectOption.textContent = `Auto-detect (${data.detected_language})`;
            // Update editor highlighting with detected language
            currentLanguage = data.detected_language;
          } else {
            autoDetectOption.textContent = 'Auto-detect';
          }
        }
      }
    })
    .catch(error => {
      console.error('Error updating preview:', error);
      document.getElementById('preview').innerHTML = '<pre><code>Error updating preview</code></pre>';
    });
  }

  function updatePaste() {
    const content = jar ? jar.toString() : '';
    const language = document.getElementById('language').value;
    const title = document.getElementById('paste-title').value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('title', title);

    fetch('/' + pasteId + '/edit', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else if (response.ok) {
        window.location.href = '/' + pasteId;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error updating paste:', error);
      alert('Error updating paste: ' + error.message);
    });
  }

  // Initialize CodeJar on page load
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into top bar
    const topBarRight = document.querySelector('.top-bar-right');
    if (topBarRight) {
      topBarRight.insertAdjacentHTML('afterbegin', `
        <input type="text" id="paste-title" value="${initialTitle}" placeholder="Title (optional)" style="width: 200px; padding: 0.25rem 0.5rem; font-size: 0.85rem; margin: 0; height: auto;">
        <select id="language" onchange="updateLanguage()">
          <% Pasto::Paste.available_languages.each do |lang| %>
            <option value="<%= lang == "Auto-detect" ? "" : lang %>" <%= paste.language == lang || (lang != "Auto-detect" && paste.language == lang.downcase) ? "selected" : "" %>><%= lang %></option>
          <% end %>
        </select>
        <button onclick="updatePaste()" title="Save Changes"><i data-lucide="save"></i></button>
        <button id="preview-toggle" onclick="togglePreview()" title="Toggle Preview"><i data-lucide="eye"></i></button>
        <a href="/${pasteId}" class="top-bar-btn" title="Cancel"><i data-lucide="x"></i></a>
      `);
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');
    
    const editorElement = document.getElementById('editor');
    
    jar = CodeJar(editorElement, highlight, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Set initial content
    jar.updateCode(initialContent);

    // Update preview on content change
    jar.onUpdate(() => {
      debouncedUpdatePreview();
    });

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    if (previewHidden) {
      document.querySelector('.editor-preview-container').classList.add('preview-hidden');
      document.getElementById('preview-toggle').innerHTML = '<i data-lucide="eye-off"></i>';
      document.getElementById('preview-toggle').title = 'Show Preview';
    }

    // Initialize Lucide icons
    lucide.createIcons();

    // Initialize preview
    updatePreview();
  });
</script>

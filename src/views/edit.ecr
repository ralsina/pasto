<%= render "src/views/_editor_container.ecr" %>


<script>
  let jar;
  let debounceTimer;
  let currentLanguage = '<%= paste.language || "" %>';
  const pasteId = '<%= paste.sepia_id %>';
  const initialContent = <%= paste.content.to_json %>;
  const initialTitle = <%= (paste.title || "").to_json %>;

  // Security settings object
  let securitySettings = {
    accessControl: '<%= paste.private? ? "private" : "public" %>',
    expiration: '<%= paste.expires_at.year == 9999 ? "" : paste.expires_at.to_s("%Y-%m-%d") %>',
    burnAfterReading: <%= paste.burn_after_reading? ? "true" : "false" %>',
    encryptionEnabled: <%= paste.is_encrypted? ? "true" : "false" %>,
    encryptionPassword: null,
    password: '<%= "" %>'
  };

  // Use shared functions from external module
  function updateLanguage() {
    currentLanguage = document.getElementById('language').value;
    if (jar) {
      // Re-highlight with new language using shared function
      jar.updateCode(jar.toString());
    }
    updatePreview();
  }

  function togglePreview() {
    // Use shared togglePreview function
    if (typeof window.togglePreview === 'function') {
      window.togglePreview(jar,
        () => document.getElementById('language').value,
        () => document.getElementById('syntax-theme')?.value || 'monokai'
      );
    }

    // Update edit-specific UI elements
    const container = document.getElementById('editor-preview-container');
    const isHidden = container.classList.contains('preview-hidden');
  }

  function updatePreview() {
    // Use shared updatePreview function
    if (typeof window.updatePreview === 'function') {
      window.updatePreview(jar,
        () => document.getElementById('language').value,
        () => document.getElementById('syntax-theme')?.value || 'monokai'
      );

      // Update currentLanguage if auto-detect is active and language was detected
      const languageSelect = document.getElementById('language');
      const isAutoDetect = (languageSelect?.value === 'Auto' || languageSelect?.value === '');
      if (isAutoDetect && languageSelect?.options) {
        const autoDetectOption = Array.from(languageSelect.options).find(
          option => option.value === 'Auto' || option.value === ''
        );
        if (autoDetectOption && autoDetectOption.textContent.includes('(')) {
          // Extract detected language from text like "Auto (javascript)"
          const match = autoDetectOption.textContent.match(/\(([^)]+)\)/);
          if (match) {
            currentLanguage = match[1];
          }
        }
      }
    }
  }

  function updatePaste() {
    const content = jar ? jar.toString() : '';
    const languageSelect = document.getElementById('language');
    const titleSelect = document.getElementById('paste-title');

    if (!languageSelect || !titleSelect) {
      alert('Language or title selector not available');
      return;
    }

    const language = languageSelect.value;
    const title = titleSelect.value;

    if (!content.trim()) {
      alert('Please enter some content');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    formData.append('language', language);
    formData.append('title', title);

    // Add security settings to form data
    formData.append('access_control', securitySettings.accessControl);

    if (securitySettings.expiration) {
      formData.append('expiration', securitySettings.expiration);
    }

    if (securitySettings.burnAfterReading) {
      formData.append('burn_after_reading', 'true');
    }

    if (securitySettings.accessControl === 'private') {
      formData.append('private', 'true');
    }

    if (securitySettings.password) {
      formData.append('password', securitySettings.password);
    }

    fetch('/' + pasteId + '/edit', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else if (response.ok) {
        window.location.href = '/' + pasteId;
      } else {
        return response.text().then(text => {
          throw new Error(text);
        });
      }
    })
    .catch(error => {
      console.error('Error updating paste:', error);
      alert('Error updating paste: ' + error.message);
    });
  }

  // Security settings dialog function
  function showSecuritySettingsDialog() {
    const modal = document.createElement('dialog');
    modal.style.cssText = `
      padding: 2rem;
      border: 2px solid var(--pico-primary);
      border-radius: 0.5rem;
      max-width: 500px;
      width: 90vw;
      max-height: 90vh;
      overflow-y: auto;
    `;

    modal.innerHTML = `
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">
        <i data-lucide="shield" style="width: 1.5rem; height: 1.5rem; vertical-align: middle; margin-right: 0.5rem;"></i>
        Security Settings
      </h3>

      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Access Control -->
        <div>
          <label for="security-access-control" style="display: block; margin-bottom: 0.5rem; font-weight: 600;"><i data-lucide="shield" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 0.5rem;"></i>Access Control</label>
          <select id="security-access-control" style="width: 100%; padding: 0.5rem;">
            <option value="public" ${securitySettings.accessControl === 'public' && !securitySettings.encryptionEnabled ? 'selected' : ''}>Public</option>
            <option value="password" ${securitySettings.accessControl === 'password' && !securitySettings.encryptionEnabled ? 'selected' : ''}>Password Protected</option>
            <option value="encrypted" ${securitySettings.encryptionEnabled ? 'selected' : ''}>End-to-End Encrypted</option>
            <option value="private" ${securitySettings.accessControl === 'private' && !securitySettings.encryptionEnabled ? 'selected' : ''}>Private</option>
          </select>
        </div>

        <!-- Expiration -->
        <div>
          <label for="security-expiration" style="display: block; margin-bottom: 0.5rem; font-weight: 600;"><i data-lucide="clock" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 0.5rem;"></i>Expiration</label>
          <select id="security-expiration" style="width: 100%; padding: 0.5rem;">
            <option value="">Never</option>
            <option value="10m" ${securitySettings.expiration === '10m' ? 'selected' : ''}>10 minutes</option>
            <option value="1h" ${securitySettings.expiration === '1h' ? 'selected' : ''}>1 hour</option>
            <option value="1d" ${securitySettings.expiration === '1d' ? 'selected' : ''}>1 day</option>
            <option value="1w" ${securitySettings.expiration === '1w' ? 'selected' : ''}>1 week</option>
            <option value="1M" ${securitySettings.expiration === '1M' ? 'selected' : ''}>1 month</option>
          </select>
        </div>

        <!-- Burn After Reading -->
        <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: var(--pico-background-color); border: 1px solid var(--pico-border-color); border-radius: 4px;">
          <input type="checkbox" id="security-burn" ${securitySettings.burnAfterReading ? 'checked' : ''} style="margin: 0;">
          <i data-lucide="flame" style="width: 16px; height: 16px;"></i>
          <div style="flex: 1;">
            <strong>Burn After Reading</strong>
          </div>
        </label>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem; justify-content: flex-end;">
        <button id="cancelSecurityBtn" style="background: var(--pico-secondary-background); color: var(--pico-color); border: 1px solid var(--pico-border-color); padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer;">
          Cancel
        </button>
        <button id="saveSecurityBtn" style="background: var(--pico-primary-background); color: var(--pico-primary-inverse); border: 1px solid var(--pico-primary); padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer;">
          Save Settings
        </button>
      </div>
    `;

    document.body.appendChild(modal);

    // Add event listeners
    const accessControlSelect = document.getElementById('security-access-control');
    const encryptionOptions = document.getElementById('encryptionOptions');
    const passwordOptions = document.getElementById('passwordOptions');

    // Access control change handler
    accessControlSelect.addEventListener('change', (e) => {
      const value = e.target.value;

      if (value === 'encrypted') {
        securitySettings.encryptionEnabled = true;
        securitySettings.accessControl = 'public';
        if (encryptionOptions) encryptionOptions.style.display = 'block';
        if (passwordOptions) passwordOptions.style.display = 'none';
      } else {
        securitySettings.encryptionEnabled = false;
        securitySettings.accessControl = value;
        if (encryptionOptions) encryptionOptions.style.display = 'none';
        if (passwordOptions) passwordOptions.style.display = value === 'password' ? 'block' : 'none';
      }
    });

    // Expiration change handler
    document.getElementById('security-expiration').addEventListener('change', (e) => {
      securitySettings.expiration = e.target.value;
    });

    // Burn after reading handler
    document.getElementById('security-burn').addEventListener('change', (e) => {
      securitySettings.burnAfterReading = e.target.checked;
    });

    // Cancel button
    modal.querySelector('#cancelSecurityBtn').onclick = () => {
      modal.close();
      document.body.removeChild(modal);
    };

    // Save button
    modal.querySelector('#saveSecurityBtn').onclick = () => {
      modal.close();
      document.body.removeChild(modal);
      updateSecuritySettingsButton();
    };

    // Initialize Lucide icons
    if (window.lucide) {
      window.lucide.createIcons();
    }

    modal.showModal();
  }

  // Update security settings button appearance based on current settings
  function updateSecuritySettingsButton() {
    const securityBtn = document.getElementById('security-settings-btn');
    if (!securityBtn) return;

    // Count active security features
    let activeFeatures = [];

    if (securitySettings.expiration) {
      activeFeatures.push('Expiration');
    }

    if (securitySettings.burnAfterReading) {
      activeFeatures.push('Burn');
    }

    if (securitySettings.encryptionEnabled) {
      activeFeatures.push('Encrypted');
    }

    // Update button appearance
    if (activeFeatures.length > 0) {
      // Has security features - use accent style
      securityBtn.style.background = 'var(--pico-primary-background)';
      securityBtn.style.color = 'var(--pico-primary-inverse)';
      securityBtn.style.borderColor = 'var(--pico-primary)';

      // Update icon to shield-check if features are active
      const icon = securityBtn.querySelector('i');
      if (icon) {
        icon.setAttribute('data-lucide', 'shield-check');
        if (window.lucide) {
          window.lucide.createIcons();
        }
      }
    } else {
      // No security features - use neutral style
      securityBtn.style.background = 'transparent';
      securityBtn.style.color = 'var(--pico-primary)';
      securityBtn.style.borderColor = 'var(--pico-primary)';

      // Update icon back to shield
      const icon = securityBtn.querySelector('i');
      if (icon) {
        icon.setAttribute('data-lucide', 'shield');
        if (window.lucide) {
          window.lucide.createIcons();
        }
      }
    }
  }

  // Initialize CodeJar on page load
  document.addEventListener('DOMContentLoaded', async function() {
    // Inject controls into the controls-group
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="plus" style="width: 20px; height: 20px;"></i>
        </a>
        <input type="text" id="paste-title" value="${initialTitle}" placeholder="Title (optional)" class="controls-input">
        <select id="language" onchange="updateLanguage()" class="controls-select" aria-label="Select programming language">
          <!-- Preload Auto and paste's language for immediate responsiveness -->
          <option value="">Auto</option>
          <% if lang = paste.language %>
          <% if !lang.empty? %>
          <option value="<%= lang.downcase %>" selected><%= lang %></option>
          <% end %>
          <% end %>
        </select>
        <select id="expiration" class="controls-select" aria-label="Select expiration time" title="Set paste expiration time">
          <option value="">Never</option>
          <option value="10m">10 minutes</option>
          <option value="1h">1 hour</option>
          <option value="1d">1 day</option>
          <option value="1w">1 week</option>
          <option value="1M">1 month</option>
          <option value="view-once">View Once 🔥</option>
        </select>
        <button onclick="showSecuritySettingsDialog()" class="controls-button" id="security-settings-btn" title="Security Settings" aria-label="Security Settings" style="background: transparent; border: 1px solid var(--pico-primary); color: var(--pico-primary);">
          <i data-lucide="shield" style="width: 20px; height: 20px;"></i>
        </button>
        <button onclick="updatePaste()" class="controls-button" title="Save Changes" aria-label="Save Changes">
          <i data-lucide="save" style="width: 20px; height: 20px;"></i>
        </button>
        <button onclick="window.togglePreview(window.jar, () => document.getElementById('language').value, () => document.getElementById('syntax-theme')?.value || 'monokai')" class="controls-button" title="Show Preview" id="controls-show-preview-button" aria-label="Show Preview" style="display: none;">
          <i data-lucide="eye" style="width: 20px; height: 20px;"></i>
        </button>
        <button onclick="window.togglePreview(window.jar, () => document.getElementById('language').value, () => document.getElementById('syntax-theme')?.value || 'monokai')" class="controls-button" title="Hide Preview" id="controls-hide-preview-button" aria-label="Hide Preview" style="display: flex;">
          <i data-lucide="eye-off" style="width: 20px; height: 20px;"></i>
        </button>
        <a href="/${pasteId}" class="controls-button" title="Cancel" aria-label="Cancel" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="x" style="width: 20px; height: 20px;"></i>
        </a>
        <a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="help-circle" style="width: 20px; height: 20px;"></i>
        </a>
        <a href="/profile" class="controls-button" title="Profile / Login" aria-label="Profile / Login" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user" style="width: 20px; height: 20px;"></i>
        </a>
      `;
    }

    // Dynamically import CodeJar as ES module
    const { CodeJar } = await import('/assets/codejar.min.js');

    const editorElement = document.getElementById('editor');

    // Use shared highlight function
    jar = CodeJar(editorElement, (editor) => {
      if (typeof window.highlight === 'function') {
        window.highlight(editor, currentLanguage);
      }
    }, {
      tab: '  ',
      indentOn: /[{[(]$/,
      moveToNewLine: /^[}\])]$/,
      spellcheck: false,
      catchTab: true,
      preserveIdent: true,
      addClosing: true,
      history: true
    });

    // Force Chivo Mono font application
    editorElement.style.fontFamily = "'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace";

    // Set keyboard focus on the editor
    editorElement.focus();

    // Set initial content
    jar.updateCode(initialContent);

    // Export jar to window for external functions
    window.jar = jar;

    // Update preview on content change using debounced function
    jar.onUpdate(() => {
      if (typeof window.debouncedUpdatePreview === 'function') {
        debounceTimer = window.debouncedUpdatePreview(() => {
          window.updatePreview(window.jar,
            () => document.getElementById('language').value,
            () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
          );
        }, debounceTimer);
      } else {
        // Fallback if shared function not available
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          window.updatePreview(window.jar,
            () => document.getElementById('language').value,
            () => (document.querySelector('#syntax-theme') || document.getElementById('syntax-theme'))?.value || 'monokai'
          );
        }, 300);
      }
    });

    // Restore preview visibility preference
    const previewHidden = localStorage.getItem('previewHidden') === 'true';
    const container = document.getElementById('editor-preview-container');
    const showButton = document.getElementById('controls-show-preview-button');
    const hideButton = document.getElementById('controls-hide-preview-button');

    if (previewHidden) {
      container.classList.add('preview-hidden');
      if (showButton) showButton.style.display = 'flex';
      if (hideButton) hideButton.style.display = 'none';
    } else {
      container.classList.remove('preview-hidden');
      if (showButton) showButton.style.display = 'none';
      if (hideButton) hideButton.style.display = 'flex';
    }

    // Initialize Lucide icons
    if (window.lucide) {
      window.lucide.createIcons();
    }

    // Initialize language options via API
    fetch('/api/languages')
      .then(response => response.json())
      .then(languages => {
        const languageSelect = document.getElementById('language');
        const currentValue = languageSelect.value;
        languageSelect.innerHTML = '<option value="">Auto</option>';

        // Add paste's current language if it exists
        <% if lang = paste.language %>
        <% if !lang.empty? %>
        const currentOption = document.createElement('option');
        currentOption.value = '<%= lang.downcase %>';
        currentOption.textContent = '<%= lang %>';
        currentOption.selected = true;
        languageSelect.appendChild(currentOption);
        <% end %>
        <% end %>

        // Add all available languages
        languages.forEach(langObj => {
          // langObj is an object with {name: "...", value: "..."}
          if (langObj && langObj.name && langObj.value) {
            // Skip if this is the current language (already added)
            if (langObj.value.toLowerCase() !== '<%= (paste.language || "").downcase %>') {
              const option = document.createElement('option');
              option.value = langObj.value;
              option.textContent = langObj.name;
              languageSelect.appendChild(option);
            }
          }
        });
      })
      .catch(error => console.error('Error loading languages:', error));

    // Initialize preview with a small delay to ensure proper initialization
    setTimeout(() => {
      updatePreview();
    }, 100);

    // Initialize security settings button appearance
    updateSecuritySettingsButton();
  });
</script>

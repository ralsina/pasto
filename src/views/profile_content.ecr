<script>
  document.addEventListener('DOMContentLoaded', function() {
    const topBarRight = document.querySelector('.top-bar-right');
    if (topBarRight) {
      topBarRight.insertAdjacentHTML('afterbegin', `
        <a href="/" class="top-bar-btn" title="Create New Paste"><i data-lucide="plus"></i></a>
        <button onclick="document.getElementById('logout-form').submit()" class="top-bar-btn" title="Logout"><i data-lucide="log-out"></i></button>
      `);
      lucide.createIcons();
    }
  });
</script>
<form id="logout-form" method="post" action="/logout" style="display: none;"></form>

<div class="profile-container">
  <% if current_user %>
    <% updated = env.params.query["updated"]? == "true" %>
    <% error = env.params.query["error"]? %>

    <% if updated %>
    <div class="alert alert-success">
      <i data-lucide="check" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle;"></i> Profile updated successfully!
    </div>
    <% end %>

    <% if error %>
    <div class="alert alert-error">
      <i data-lucide="x" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle;"></i> Failed to update profile. Please try again.
    </div>
    <% end %>

    <div class="user-info">
      <h2>User Profile</h2>
      
      <!-- Edit Name Form -->
      <form method="post" action="/profile" class="edit-name-form">
        <label for="name">Display Name</label>
        <div class="input-group">
          <input type="text" 
                 id="name" 
                 name="name" 
                 value="<%= current_user.name || "" %>" 
                 placeholder="Enter your display name"
                 maxlength="50">
          <button type="submit" class="save-btn">Save</button>
        </div>
        <small>This name will be shown on your profile. Leave empty to remain anonymous.</small>
      </form>

      <div class="user-details">
        <div class="detail-row">
          <strong>SSH Keys:</strong> <%= current_user.keys.size %>
        </div>
        <div class="detail-row">
          <strong>Total Pastes:</strong> <%= current_user.all_pastes.size %>
        </div>
        <div class="detail-row">
          <strong>Member Since:</strong> <%= current_user.created_at.to_s("%B %d, %Y") %>
        </div>
      </div>

    </div>

    <!-- SSH Keys Section -->
    <div class="ssh-keys-section">
      <h3>🔑 SSH Keys</h3>
      <% if current_user.keys.empty? %>
        <p class="no-items">No SSH keys linked to your account.</p>
      <% else %>
        <div class="keys-list">
          <% current_user.keys.each do |ssh_key| %>
            <div class="key-item">
              <code class="fingerprint"><%= ssh_key.sepia_id.gsub("_", "/") %></code>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- User's Pastes Section -->
    <div class="pastes-section">
      <h3>📋 Your Pastes</h3>
      <% user_pastes = current_user.all_pastes %>
      <% if user_pastes.empty? %>
        <p class="no-items">You haven't created any pastes yet.</p>
        <p>Create pastes via the web interface or using SSH:</p>
        <code class="command-example">echo "Hello World" | ssh -p <%= ssh_port %> <%= ssh_host %> paste</code>
      <% else %>
        <div class="pastes-list">
          <% user_pastes.sort_by(&.created_at).reverse.first(20).each do |paste| %>
          <div class="paste-item">
            <a href="/<%= paste.sepia_id %>" class="paste-link">
              <span class="paste-title"><%= HTML.escape(paste.display_title) %></span>
              <span class="paste-lang"><%= paste.language || "text" %></span>
              <span class="paste-date"><%= paste.created_at.to_s("%Y-%m-%d %H:%M") %></span>
            </a>
          </div>
          <% end %>
          <% if user_pastes.size > 20 %>
          <p class="more-pastes">Showing 20 of <%= user_pastes.size %> pastes</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="not-logged-in">
      <h2>Not Logged In</h2>
      <div class="login-instructions">
        <h3>How to Login</h3>
        <% if ssh_enabled %>
        <p>To access your profile, log in using SSH:</p>

        <div class="login-steps">
          <h4>Steps:</h4>
          <ol>
            <li>Run: <code>ssh -p <%= ssh_port %> <%= ssh_host %> login</code></li>
            <li>Open the URL shown in your browser</li>
            <li>The link expires after 10 minutes for security</li>
          </ol>
        </div>

        <div class="security-info">
          <h4>Security Note:</h4>
          <p>Your SSH public key is used for authentication - no passwords needed.</p>
        </div>
        <% else %>
        <p>SSH login is not currently enabled on this server.</p>
        <% end %>
      </div>

      <div class="profile-actions">
        <a href="/" class="back-btn">← Back to Pasto</a>
      </div>
    </div>
  <% end %>
</div>

<style>
  .profile-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .alert {
    padding: 1rem;
    border-radius: var(--pico-border-radius);
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: var(--pico-ins-background);
    border: 1px solid var(--pico-ins-border);
    color: var(--pico-ins-color);
  }

  .alert-error {
    background-color: var(--pico-del-background);
    border: 1px solid var(--pico-del-border);
    color: var(--pico-del-color);
  }

  .user-info, .not-logged-in, .ssh-keys-section, .pastes-section {
    background-color: var(--pico-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .edit-name-form {
    margin: 1.5rem 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--pico-border-color);
  }

  .edit-name-form label {
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }

  .input-group {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    align-items: center;
  }

  .input-group input[type="text"] {
    flex: 1 1 auto;
    margin-bottom: 0;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    min-width: 200px;
    width: 100%;
  }

  .save-btn {
    flex: 0 0 auto;
    background-color: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
    border: none;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
    border-radius: var(--pico-border-radius);
    margin-bottom: 0;
    width: auto !important;
  }

  .save-btn:hover {
    background-color: var(--pico-primary-hover-background);
  }

  .edit-name-form small {
    color: var(--pico-muted-color);
    display: block;
    margin-top: 0.25rem;
  }

  .ssh-keys-section h3, .pastes-section h3 {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .user-details {
    margin: 1.5rem 0;
  }

  .detail-row {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-row strong {
    min-width: 120px;
    color: var(--pico-primary);
  }

  .profile-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .logout-btn {
    background-color: var(--pico-del-background);
    color: var(--pico-del-color);
    border: 1px solid var(--pico-del-border);
  }

  .logout-btn:hover {
    background-color: var(--pico-del-hover-background);
  }

  /* SSH Keys */
  .keys-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .key-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
  }

  .fingerprint {
    font-size: 0.85rem;
    background: none;
    padding: 0;
  }

  .key-meta {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
  }

  /* Pastes List */
  .pastes-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .paste-item {
    border-radius: var(--pico-border-radius);
    overflow: hidden;
  }

  .paste-link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s;
  }

  .paste-link:hover {
    background-color: var(--pico-secondary-background);
  }

  .paste-title {
    color: var(--pico-primary);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .paste-lang {
    color: var(--pico-muted-color);
    font-size: 0.9rem;
  }

  .paste-date {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
  }

  .no-items {
    color: var(--pico-muted-color);
    margin-bottom: 0.5rem;
  }

  .command-example {
    display: block;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
    font-size: 0.9rem;
  }

  .more-pastes {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
    text-align: center;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background-color: var(--pico-secondary-background);
    color: var(--pico-color);
    text-decoration: none;
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
  }

  .back-btn:hover {
    background-color: var(--pico-secondary-hover-background);
  }

  .login-instructions {
    margin: 2rem 0;
  }

  .login-steps {
    margin: 1.5rem 0;
  }

  .login-steps ol {
    padding-left: 1.5rem;
  }

  .login-steps li {
    margin-bottom: 0.5rem;
  }

  .security-info {
    margin: 1.5rem 0;
    padding: 1rem;
    background-color: var(--pico-ins-background);
    border: 1px solid var(--pico-ins-border);
    border-radius: var(--pico-border-radius);
  }

  .security-info p {
    margin: 0;
    color: var(--pico-ins-color);
  }

  @media (max-width: 768px) {
    .profile-container {
      padding: 1rem;
    }

    .user-info, .not-logged-in, .ssh-keys-section, .pastes-section {
      padding: 1.5rem;
    }

    .input-group {
      flex-direction: column;
      gap: 0.5rem;
    }

    .input-group input[type="text"] {
      width: 100%;
    }

    .save-btn {
      align-self: flex-start;
      width: auto;
    }

    .detail-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .detail-row strong {
      min-width: auto;
    }

    .profile-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .key-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .fingerprint {
      word-break: break-all;
    }

    .paste-link {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    .paste-size {
      text-align: left;
    }
  }
</style>
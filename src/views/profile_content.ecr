<script>
  document.addEventListener('DOMContentLoaded', function() {
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      let html = `<a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;"><i data-lucide="plus" style="width: 20px; height: 20px;"></i></a>`;
      html += `<a href="/help" class="controls-button" title="Help" aria-label="Help" style="text-decoration: none; display: flex; align-items: center; justify-content: center;"><i data-lucide="help-circle" style="width: 20px; height: 20px;"></i></a>`;
      <% if current_user %>
      html += `<button onclick="document.getElementById('logout-form').submit()" class="controls-button" title="Logout" aria-label="Logout from your account" style="color: var(--pico-del-color);"><i data-lucide="log-out" style="width: 20px; height: 20px;"></i></button>`;
      <% end %>
      controlsGroup.insertAdjacentHTML('afterbegin', html);
      if (window.lucide) {
        lucide.createIcons();
      }
    }
  });
</script>
<form id="logout-form" method="post" action="/logout" style="display: none;"></form>

<div class="profile-container">
  <% if current_user %>
    <% updated = env.params.query["updated"]? == "true" %>
    <% error = env.params.query["error"]? %>

    <% if updated %>
    <div class="alert alert-success">
      <i data-lucide="check" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle;"></i> Profile updated successfully!
    </div>
    <% end %>

    <% if error %>
    <div class="alert alert-error">
      <i data-lucide="x" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle;"></i> Failed to update profile. Please try again.
    </div>
    <% end %>

    <div class="user-info">
      <h2>User Profile</h2>
      
      <!-- Edit Name Form -->
      <form method="post" action="/profile" class="edit-name-form">
        <label for="name">Display Name</label>
        <div class="input-group">
          <input type="text" 
                 id="name" 
                 name="name" 
                 value="<%= current_user.name || "" %>" 
                 placeholder="Enter your display name"
                 maxlength="50">
          <button type="submit" class="save-btn">Save</button>
        </div>
        <small>This name will be shown on your profile. Leave empty to remain anonymous.</small>
      </form>

  
    </div>

    <!-- SSH Keys Section -->
    <div class="ssh-keys-section">
      <h3>🔑 SSH Keys</h3>
      <% if current_user.keys.empty? %>
        <p class="no-items">No SSH keys linked to your account.</p>
      <% else %>
        <div class="keys-list">
          <% current_user.keys.each do |ssh_key| %>
            <div class="key-item">
              <code class="fingerprint"><%= ssh_key.sepia_id.gsub("_", "/") %></code>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- API Keys Section -->
    <div class="api-keys-section">
      <h3>🔐 API Keys</h3>
      <% api_keys = current_user.all_api_keys %>
      <% if api_keys.empty? %>
        <p class="no-items">No API keys generated yet.</p>
        <p>Create API keys via SSH to access the Pasto API programmatically:</p>
        <code class="command-example">ssh -p <%= ssh_port %> <%= ssh_host %> api-key create</code>
        <p><small>After creating an API key, you can use it with HTTP Bearer authentication:</small></p>
        <code class="command-example">curl -H "Authorization: Bearer pasto_ak_your_key" <%= env.request.headers["X-Forwarded-Proto"]? || "http" %>://<%= env.request.host_with_port %>/api/v1/me</code>
      <% else %>
        <div class="api-keys-list">
          <% api_keys.each do |api_key| %>
            <div class="api-key-item">
              <div class="api-key-info">
                <code class="api-key-id"><%= api_key.id %></code>
                <div class="api-key-meta">
                  <span class="created-date">Created: <%= api_key.key_data.created_at.to_s("%Y-%m-%d %H:%M") %></span>
                  <span class="usage-count">Used: <%= api_key.key_data.usage_count %> times</span>
                  <% if last_used = api_key.key_data.last_used_at %>
                    <span class="last-used">Last used: <%= last_used.to_s("%Y-%m-%d %H:%M") %></span>
                  <% end %>
                </div>
              </div>
              <div class="api-key-actions">
                <button class="copy-btn" onclick="copyToClipboard('<%= api_key.id %>')" title="Copy API Key">
                  <i data-lucide="copy"></i>
                </button>
              </div>
            </div>
          <% end %>
        </div>
        <div class="api-docs-link">
          <a href="/api-docs" target="_blank" class="docs-btn">
            <i data-lucide="book-open"></i>
            View API Documentation
          </a>
        </div>
      <% end %>
    </div>

    <!-- User's Pastes Section -->
    <div class="pastes-section">
      <h3>📋 Your Pastes</h3>
      <% user_pastes = current_user.all_pastes %>
      <% if user_pastes.empty? %>
        <p class="no-items">You haven't created any pastes yet.</p>
        <p>Create pastes via the web interface or using SSH:</p>
        <code class="command-example">echo "Hello World" | ssh -p <%= ssh_port %> <%= ssh_host %> paste</code>
      <% else %>
        <div class="pastes-list">
          <% user_pastes.sort_by(&.created_at).reverse.first(20).each do |paste| %>
          <div class="paste-item <%= paste.burn_after_reading? ? "burn-after-reading" : "" %>">
            <div class="paste-link">
              <a href="/<%= paste.sepia_id %>" class="paste-content">
                <span class="paste-title">
                  <%= HTML.escape(paste.display_title) %>
                  <% if paste.burn_after_reading? %>
                    <i data-lucide="flame" class="burn-icon" title="Burn-after-reading paste"></i>
                    <span class="burn-badge">View once</span>
                  <% end %>
                  <% if paste.is_encrypted? %>
                    <i data-lucide="lock" class="lock-icon" title="Encrypted paste"></i>
                    <span class="encrypted-badge">Encrypted</span>
                  <% end %>
                  <% if paste.private? %>
                    <i data-lucide="shield" class="private-icon" title="Private paste"></i>
                    <span class="private-badge">Private</span>
                  <% end %>
                </span>
                <span class="paste-lang"><%= paste.language || "text" %></span>
                <span class="paste-date"><%= paste.created_at.to_s("%Y-%m-%d %H:%M") %></span>
              </a>
              <div class="paste-actions">
                <% unless paste.burn_after_reading? %>
                <a href="/<%= paste.sepia_id %>/edit" class="edit-btn" title="Edit Paste" aria-label="Edit Paste">
                  <i data-lucide="edit-2"></i>
                </a>
                <% end %>
                <button class="delete-btn" onclick="confirmDelete('<%= paste.sepia_id %>')" title="Delete Paste" aria-label="Delete Paste">
                  <i data-lucide="trash-2"></i>
                </button>
              </div>
            </div>
          </div>
          <% end %>
          <% if user_pastes.size > 20 %>
          <p class="more-pastes">Showing 20 of <%= user_pastes.size %> pastes</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="not-logged-in">
      <h2>Not Logged In</h2>
      <div class="login-instructions">
        <h3>How to Login</h3>
        <% if ssh_enabled %>
        <p>To access your profile, log in using SSH:</p>

        <div class="login-steps">
          <h4>Steps:</h4>
          <ol>
            <li>Run: <code>ssh -p <%= ssh_port %> <%= ssh_host %> login</code></li>
            <li>Open the URL shown in your browser</li>
            <li>The link expires after 10 minutes for security</li>
          </ol>
        </div>

        <div class="security-info">
          <h4>Security Note:</h4>
          <p>Your SSH public key is used for authentication - no passwords needed.</p>
        </div>
        <% else %>
        <p>SSH login is not currently enabled on this server.</p>
        <% end %>
      </div>
    </div>

  <% end %>
</div>

<script>
function confirmDelete(pasteId) {
  showConfirmDialog('Are you sure you want to delete this paste? This action cannot be undone.', () => {
    fetch(`/${pasteId}/delete`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      }
    })
    .then(response => {
      if (response.ok) {
        // Reload the page to show updated paste list
        window.location.reload();
      } else {
        // Handle error
        showError('Failed to delete paste. Please try again.');
      }
    })
    .catch(error => {
      console.error('Error deleting paste:', error);
      showError('Failed to delete paste. Please try again.');
    });
  });
}

// Copy to clipboard function
function copyToClipboard(text) {
  navigator.clipboard.writeText(text).then(function() {
    // Show success message
    showSuccess('API key copied to clipboard!');
  }, function(err) {
    // Fallback for older browsers
    const textArea = document.createElement("textarea");
    textArea.value = text;
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();

    try {
      const successful = document.execCommand('copy');
      if (successful) {
        showSuccess('API key copied to clipboard!');
      } else {
        showError('Failed to copy API key');
      }
    } catch (err) {
      showError('Failed to copy API key');
    }

    document.body.removeChild(textArea);
  });
}

// Reinitialize Lucide icons for the new buttons
document.addEventListener('DOMContentLoaded', function() {
  if (window.lucide) {
    lucide.createIcons();
  }
});
</script>

<style>
  .profile-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .alert {
    padding: 1rem;
    border-radius: var(--pico-border-radius);
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: var(--pico-ins-background);
    border: 1px solid var(--pico-ins-border);
    color: var(--pico-ins-color);
  }

  .alert-error {
    background-color: var(--pico-del-background);
    border: 1px solid var(--pico-del-border);
    color: var(--pico-del-color);
  }

  .user-info, .not-logged-in, .ssh-keys-section, .api-keys-section, .pastes-section {
    background-color: var(--pico-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .edit-name-form {
    margin: 1.5rem 0 1rem 0;
  }

  .edit-name-form label {
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }

  .input-group {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    align-items: center;
  }

  .input-group input[type="text"] {
    flex: 1 1 auto;
    margin-bottom: 0;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    min-width: 200px;
    width: 100%;
  }

  .save-btn {
    flex: 0 0 auto;
    background-color: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
    border: none;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
    border-radius: var(--pico-border-radius);
    margin-bottom: 0;
    width: auto !important;
  }

  .save-btn:hover {
    background-color: var(--pico-primary-hover-background);
  }

  .edit-name-form small {
    color: var(--pico-muted-color);
    display: block;
    margin-top: 0.25rem;
  }

  .ssh-keys-section h3, .api-keys-section h3, .pastes-section h3 {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .user-details {
    margin: 1.5rem 0;
  }

  .detail-row {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-row strong {
    min-width: 120px;
    color: var(--pico-primary);
  }

  .profile-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .logout-btn {
    background-color: var(--pico-del-background);
    color: var(--pico-del-color);
    border: 1px solid var(--pico-del-border);
  }

  .logout-btn:hover {
    background-color: var(--pico-del-hover-background);
  }

  /* SSH Keys */
  .keys-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .key-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
  }

  .fingerprint {
    font-size: 0.85rem;
    background: none;
    padding: 0;
  }

  .key-meta {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
  }

  /* API Keys */
  .api-keys-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .api-key-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
    border: 1px solid rgba(0, 123, 255, 0.2);
  }

  .api-key-info {
    flex: 1;
    min-width: 0;
  }

  .api-key-id {
    font-size: 0.9rem;
    font-weight: 600;
    background: none;
    padding: 0;
    color: var(--pico-primary);
    word-break: break-all;
    display: block;
    margin-bottom: 0.5rem;
  }

  .api-key-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--pico-muted-color);
    font-size: 0.8rem;
  }

  .api-key-meta span {
    white-space: nowrap;
  }

  .api-key-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: 1rem;
  }

  .copy-btn {
    padding: 0.5rem;
    border-radius: var(--pico-border-radius);
    border: 1px solid var(--pico-border-color);
    background-color: var(--pico-background-color);
    color: var(--pico-color);
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
  }

  .copy-btn:hover {
    background-color: var(--pico-secondary-background);
    border-color: var(--pico-primary);
    color: var(--pico-primary);
  }

  .copy-btn i {
    width: 16px;
    height: 16px;
  }

  .api-docs-link {
    margin-top: 1.5rem;
    text-align: center;
  }

  .docs-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
    text-decoration: none;
    border-radius: var(--pico-border-radius);
    border: 1px solid var(--pico-primary-border);
    transition: all 0.2s;
    font-weight: 500;
  }

  .docs-btn:hover {
    background-color: var(--pico-primary-hover-background);
    border-color: var(--pico-primary-hover-border);
  }

  .docs-btn i {
    width: 18px;
    height: 18px;
  }

  /* Pastes List */
  .pastes-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .paste-item {
    border-radius: var(--pico-border-radius);
    overflow: hidden;
  }

  /* Burn-after-reading paste styling */
  .paste-item.burn-after-reading {
    border-left: 3px solid #ff6b35;
    background-color: rgba(255, 107, 53, 0.05);
  }

  .burn-icon, .lock-icon, .private-icon {
    vertical-align: middle;
  }

  .burn-icon {
    animation: flicker 2s infinite;
  }

  @keyframes flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .burn-badge, .encrypted-badge, .private-badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .burn-badge {
    background: #ff6b35;
    color: white;
  }

  .encrypted-badge {
    background: #007bff;
    color: white;
  }

  .private-badge {
    background: #6c757d;
    color: white;
  }

  .paste-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    transition: background-color 0.2s;
  }

  .paste-link:hover {
    background-color: var(--pico-secondary-background);
  }

  .paste-content {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .paste-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    align-items: center;
  }

  .edit-btn, .delete-btn {
    padding: 0.25rem;
    border-radius: var(--pico-border-radius);
    border: 1px solid var(--pico-border-color);
    background-color: var(--pico-background-color);
    color: var(--pico-color);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    transition: all 0.2s;
  }

  .edit-btn:hover {
    background-color: var(--pico-secondary-background);
    border-color: var(--pico-primary);
  }

  .delete-btn:hover {
    background-color: var(--pico-del-background);
    color: var(--pico-del-color);
    border-color: var(--pico-del-border);
  }

  .edit-btn i, .delete-btn i {
    width: 14px;
    height: 14px;
  }

  .paste-title {
    color: var(--pico-primary);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .paste-lang {
    color: var(--pico-muted-color);
    font-size: 0.9rem;
  }

  .paste-date {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
  }

  .no-items {
    color: var(--pico-muted-color);
    margin-bottom: 0.5rem;
  }

  .command-example {
    display: block;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
    font-size: 0.9rem;
  }

  .more-pastes {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
    text-align: center;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background-color: var(--pico-secondary-background);
    color: var(--pico-color);
    text-decoration: none;
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
  }

  .back-btn:hover {
    background-color: var(--pico-secondary-hover-background);
  }

  /* Controls buttons styling */
  .controls-button {
    background: transparent;
    border: 2px solid var(--pico-primary);
    border-radius: 4px;
    padding: 0;
    cursor: pointer;
    font-size: 1.25rem;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    color: var(--pico-primary);
  }

  .controls-button:hover {
    background: var(--pico-primary);
    color: var(--pico-primary-inverse);
  }

  .controls-button i,
  .controls-button svg {
    color: inherit;
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    min-height: 20px !important;
    max-width: 20px !important;
    max-height: 20px !important;
  }

  .login-instructions {
    margin: 2rem 0;
  }

  .login-steps {
    margin: 1.5rem 0;
  }

  .login-steps ol {
    padding-left: 1.5rem;
  }

  .login-steps li {
    margin-bottom: 0.5rem;
  }

  .security-info {
    margin: 1.5rem 0;
    padding: 1rem;
    background-color: var(--pico-ins-background);
    border: 1px solid var(--pico-ins-border);
    border-radius: var(--pico-border-radius);
  }

  .security-info p {
    margin: 0;
    color: var(--pico-ins-color);
  }

  @media (max-width: 768px) {
    .profile-container {
      padding: 1rem;
    }

    .user-info, .not-logged-in, .ssh-keys-section, .api-keys-section, .pastes-section {
      padding: 1.5rem;
    }

    .input-group {
      flex-direction: column;
      gap: 0.5rem;
    }

    .input-group input[type="text"] {
      width: 100%;
    }

    .save-btn {
      align-self: flex-start;
      width: auto;
    }

    .detail-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .detail-row strong {
      min-width: auto;
    }

    .profile-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .key-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .fingerprint {
      word-break: break-all;
    }

    .api-key-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .api-key-actions {
      margin-left: 0;
      align-self: flex-end;
    }

    .paste-link {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .paste-content {
      grid-template-columns: 1fr auto;
      gap: 0.5rem;
    }

    .paste-actions {
      grid-column: 1 / -1;
      justify-content: flex-end;
      margin-top: 0.5rem;
    }

    .edit-btn, .delete-btn {
      min-width: 32px;
      height: 32px;
    }
  }
</style>
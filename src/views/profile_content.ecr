<%# Include shared utilities and styles %>
<%= render "src/views/_shared_utils.ecr" %>
<%= render "src/views/_shared_styles.ecr" %>
<%= render "src/views/_modal_utils.ecr" %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      // Define buttons for profile page
      const buttons = [
        {type: "link", href: "/", icon: "plus", title: "Create New Paste"},
        {type: "link", href: "/help", icon: "help-circle", title: "Help"}
        <% if current_user %>
        ,
        {type: "button", icon: "log-out", title: "Logout", action: "document.getElementById('logout-form').submit()", style: "danger"}
        <% end %>
      ];

      // Use shared controls component
      const controlsHTML = `
        <div class="shared-controls center">
          ${buttons.map(button => {
            if (button.type === 'link') {
              return `<a href="${button.href}" class="controls-button ${button.style || ''}" title="${button.title}" aria-label="${button.title}" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
                <i data-lucide="${button.icon}" style="width: 20px; height: 20px;"></i>
              </a>`;
            } else if (button.type === 'button') {
              return `<button onclick="${button.action}" class="controls-button ${button.style || ''}" title="${button.title}" aria-label="${button.title}">
                <i data-lucide="${button.icon}" style="width: 20px; height: 20px;"></i>
              </button>`;
            }
            return '';
          }).join('')}
        </div>
      `;

      controlsGroup.insertAdjacentHTML('afterbegin', controlsHTML);

      // Initialize Lucide icons using shared utility
      if (window.SharedIcons) {
        window.SharedIcons.init(controlsGroup);
      } else if (window.lucide) {
        window.lucide.createIcons();
      }
    }
  });
</script>
<form id="logout-form" method="post" action="/logout" style="display: none;"></form>

<div class="profile-container">
  <% if current_user %>
    <% updated = env.params.query["updated"]? == "true" %>
    <% error = env.params.query["error"]? %>

    <% if updated %>
    <div class="alert alert-success">
      <i data-lucide="check" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle;"></i> Profile updated successfully!
    </div>
    <% end %>

    <% if error %>
    <div class="alert alert-error">
      <i data-lucide="x" style="width: 20px; height: 20px; display: inline-block; vertical-align: middle;"></i> Failed to update profile. Please try again.
    </div>
    <% end %>

    <div class="user-info">
      <h2>User Profile</h2>
      
      <!-- Edit Name Form -->
      <form method="post" action="/profile" class="edit-name-form">
        <label for="name">Display Name</label>
        <div class="input-group">
          <input type="text" 
                 id="name" 
                 name="name" 
                 value="<%= current_user.name || "" %>" 
                 placeholder="Enter your display name"
                 maxlength="50">
          <button type="submit" class="save-btn">Save</button>
        </div>
        <small>This name will be shown on your profile. Leave empty to remain anonymous.</small>
      </form>

  
    </div>

    <!-- Accordion Sections -->
    <div class="accordion-sections">

      <!-- Pastes Accordion -->
      <details class="accordion"<%= env.params.query.has_key?("page") ? " open" : "" %>>
        <summary class="accordion-summary">
          <span class="accordion-title">
            <i data-lucide="file-text" style="width: 20px; height: 20px;"></i>
            Your Pastes
          </span>
          <% total_pastes = current_user ? current_user.all_pastes.size : 0 %>
          <span class="accordion-count"><%= total_pastes %> items</span>
        </summary>
        <div class="accordion-content">
          <% if user_pastes.empty? %>
            <p class="no-items">You haven't created any pastes yet.</p>
            <p>Create pastes via the web interface or using SSH:</p>
            <code class="command-example">echo "Hello World" | ssh -p <%= ssh_port %> <%= ssh_host %> paste</code>
          <% else %>
            <% if page_count > 1 %>
            <div class="pagination-info">
              <span>Showing page <%= page_number %> of <%= page_count %></span>
              <div class="pagination-controls">
                <% if page_number > 1 %>
                  <a href="/profile?page=<%= page_number - 1 %>" class="pagination-btn prev">
                    <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i>
                    Previous
                  </a>
                <% end %>

                <span class="pagination-page-info">
                  Page <%= page_number %> of <%= page_count %>
                </span>

                <% if page_number < page_count %>
                  <a href="/profile?page=<%= page_number + 1 %>" class="pagination-btn next">
                    Next
                    <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                  </a>
                <% end %>
              </div>
            </div>
            <% end %>

            <div class="pastes-list">
              <% user_pastes.each do |paste| %>
              <div class="paste-item <%= paste.burn_after_reading? ? "burn-after-reading" : "" %>">
                <div class="paste-link">
                  <a href="/<%= paste.sepia_id %>" class="paste-content">
                    <span class="paste-title">
                      <%= HTML.escape(paste.display_title) %>
                      <% if paste.burn_after_reading? %>
                        <i data-lucide="flame" class="burn-icon" title="Burn-after-reading paste"></i>
                        <span class="burn-badge">View once</span>
                      <% end %>
                      <% if paste.is_encrypted? %>
                        <i data-lucide="lock" class="lock-icon" title="Encrypted paste"></i>
                        <span class="encrypted-badge">Encrypted</span>
                      <% end %>
                      <% if paste.private? %>
                        <i data-lucide="shield" class="private-icon" title="Private paste"></i>
                        <span class="private-badge">Private</span>
                      <% end %>
                    </span>
                    <span class="paste-lang"><%= paste.language || "text" %></span>
                    <span class="paste-date"><%= paste.created_at.to_s("%Y-%m-%d %H:%M") %></span>
                  </a>
                  <div class="paste-actions">
                    <% unless paste.burn_after_reading? %>
                    <a href="/<%= paste.sepia_id %>/edit" class="edit-btn" title="Edit Paste" aria-label="Edit Paste">
                      <i data-lucide="edit-2"></i>
                    </a>
                    <% end %>
                    <button class="delete-btn" onclick="confirmDelete('<%= paste.sepia_id %>')" title="Delete Paste" aria-label="Delete Paste">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </div>
                </div>
              </div>
              <% end %>
              <% if page_count > 1 %>
            <div class="pagination-bottom">
              <div class="pagination-controls">
                <% if page_number > 1 %>
                  <a href="/profile?page=<%= page_number - 1 %>" class="pagination-btn prev">
                    <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i>
                    Previous
                  </a>
                <% end %>

                <span class="pagination-page-info">
                  Page <%= page_number %> of <%= page_count %>
                </span>

                <% if page_number < page_count %>
                  <a href="/profile?page=<%= page_number + 1 %>" class="pagination-btn next">
                    Next
                    <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                  </a>
                <% end %>
              </div>
            </div>
            <% end %>
            </div>
          <% end %>
        </div>
      </details>

      <!-- API Keys Accordion -->
      <details class="accordion">
        <summary class="accordion-summary">
          <span class="accordion-title">
            <i data-lucide="shield" style="width: 20px; height: 20px;"></i>
            API Keys
          </span>
          <% api_keys = current_user.all_api_keys %>
          <span class="accordion-count"><%= api_keys.size %> keys</span>
        </summary>
        <div class="accordion-content">
          <% if api_keys.empty? %>
            <p class="no-items">No API keys generated yet.</p>
            <p>Create API keys via SSH to access the Pasto API programmatically:</p>
            <code class="command-example">ssh -p <%= ssh_port %> <%= ssh_host %> api-key create</code>
            <p><small>After creating an API key, you can use it with HTTP Bearer authentication:</small></p>
            <code class="command-example">curl -H "Authorization: Bearer pasto_ak_your_key" <%= env.request.headers["X-Forwarded-Proto"]? || "http" %>://<%= env.request.headers["Host"]? || "localhost:3000" %>/api/v1/me</code>
          <% else %>
            <div class="api-keys-list">
              <% api_keys.each do |api_key| %>
                <div class="api-key-item">
                  <div class="api-key-info">
                    <code class="api-key-id"><%= api_key.id %></code>
                    <div class="api-key-meta">
                      <span class="created-date">Created: <%= api_key.key_data.created_at.to_s("%Y-%m-%d %H:%M") %></span>
                      <span class="usage-count">Used: <%= api_key.key_data.usage_count %> times</span>
                      <% if last_used = api_key.key_data.last_used_at %>
                        <span class="last-used">Last used: <%= last_used.to_s("%Y-%m-%d %H:%M") %></span>
                      <% end %>
                    </div>
                  </div>
                  <div class="api-key-actions">
                    <button class="copy-btn" onclick="copyToClipboard('<%= api_key.id %>', 'api')" title="Copy API Key">
                      <i data-lucide="copy"></i>
                    </button>
                    <button class="revoke-btn" onclick="confirmRevokeKey('<%= api_key.id %>')" title="Revoke API Key">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="api-docs-link">
              <a href="/api-docs" target="_blank" class="docs-btn">
                <i data-lucide="book-open"></i>
                View API Documentation
              </a>
            </div>
          <% end %>
        </div>
      </details>

      <!-- SSH Keys Accordion -->
      <details class="accordion">
        <summary class="accordion-summary">
          <span class="accordion-title">
            <i data-lucide="key" style="width: 20px; height: 20px;"></i>
            SSH Keys
          </span>
          <span class="accordion-count"><%= current_user.keys.size %> keys</span>
        </summary>
        <div class="accordion-content">
          <% if current_user.keys.empty? %>
            <p class="no-items">No SSH keys linked to your account.</p>
          <% else %>
            <div class="keys-list">
              <% current_user.keys.each do |ssh_key| %>
                <div class="key-item">
                  <div class="key-info">
                    <code class="fingerprint"><%= ssh_key.sepia_id.gsub("_", "/") %></code>
                    <div class="key-meta">
                      <span class="created-date">Added: <%= ssh_key.created_at.to_s("%Y-%m-%d %H:%M") %></span>
                    </div>
                  </div>
                  <div class="key-actions">
                    <button class="revoke-btn" onclick="confirmRevokeSSHKey('<%= ssh_key.sepia_id %>', 'SSH Key')" title="Revoke SSH Key">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </details>

      <!-- Backups Accordion -->
      <details class="accordion">
        <summary class="accordion-summary">
          <span class="accordion-title">
            <i data-lucide="database" style="width: 20px; height: 20px;"></i>
            Data Backups
          </span>
        </summary>
        <div class="accordion-content">
        <%
        backup_status_result = backup_status[:status]
        backup = backup_status[:backup]
        %>

        <% if backup_status_result == "available" && backup %>
          <div class="backup-status success">
            <i data-lucide="check-circle" class="backup-status-icon"></i>
            <span>Backup available</span>
          </div>

          <div class="backup-meta">
            <strong>Created:</strong> <%= Time.parse_rfc3339(backup["created_at"].as_s).to_s("%Y-%m-%d %H:%M:%S UTC") %>
          </div>

          <div class="backup-controls">
            <button onclick="downloadBackup()" class="primary">
              <i data-lucide="download" style="width: 16px; height: 16px; margin-right: 6px;"></i>
              Download Backup
            </button>
            <button onclick="createBackup()">
              <i data-lucide="refresh-cw" style="width: 16px; height: 16px; margin-right: 6px;"></i>
              Create New Backup
            </button>
          </div>
        <% else %>
          <div class="backup-status none">
            <i data-lucide="file-minus" class="backup-status-icon"></i>
            <span>No backup available</span>
          </div>

          <div class="backup-controls">
            <button onclick="createBackup()" class="primary">
              <i data-lucide="plus" style="width: 16px; height: 16px; margin-right: 6px;"></i>
              Create Backup
            </button>
          </div>
        <% end %>

        <div class="backup-info-text">
          <p><strong>Backup Information:</strong></p>
          <ul class="backup-info-list">
            <li>Backups contain all your pastes, SSH keys, API keys, and profile settings</li>
            <li>Backups are limited to one per day to prevent abuse</li>
            <li>Only the most recent backup is kept (new backups replace old ones)</li>
            <li>Backups are retained permanently until you create a new one</li>
          </ul>
        </div>
      </div>
      </details>

    </div>
  <% else %>
    <div class="not-logged-in">
      <h2>Not Logged In</h2>
      <div class="login-instructions">
        <h3>How to Login</h3>
        <% if ssh_enabled %>
        <p>To access your profile, log in using SSH:</p>

        <div class="login-steps">
          <h4>Steps:</h4>
          <ol>
            <li>Run: <code>ssh -p <%= ssh_port %> <%= ssh_host %> login</code></li>
            <li>Open the URL shown in your browser</li>
            <li>The link expires after 10 minutes for security</li>
          </ol>
        </div>

        <div class="security-info">
          <h4>Security Note:</h4>
          <p>Your SSH public key is used for authentication - no passwords needed.</p>
        </div>
        <% else %>
        <p>SSH login is not currently enabled on this server.</p>
        <% end %>
      </div>
    </div>

  <% end %>
</div>

<script>
function confirmDelete(pasteId) {
  showConfirmDialog('Are you sure you want to delete this paste? This action cannot be undone.', () => {
    fetch(`/${pasteId}/delete`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      }
    })
    .then(response => {
      if (response.ok) {
        // Reload the page to show updated paste list
        window.location.reload();
      } else {
        // Handle error
        showError('Failed to delete paste. Please try again.');
      }
    })
    .catch(error => {
      console.error('Error deleting paste:', error);
      showError('Failed to delete paste. Please try again.');
    });
  });
}

function confirmRevokeKey(apiKeyId) {
  showConfirmDialog('Are you sure you want to revoke this API key? This action cannot be undone and will immediately invalidate the key.', () => {
    fetch(`/profile/api-keys/revoke`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: `api_key_id=${encodeURIComponent(apiKeyId)}`
    })
    .then(response => {
      if (response.ok) {
        // Reload the page to show updated API key list
        window.location.reload();
      } else {
        // Handle error
        showError('Failed to revoke API key. Please try again.');
      }
    })
    .catch(error => {
      console.error('Error revoking API key:', error);
      showError('Failed to revoke API key. Please try again.');
    });
  });
}

function confirmRevokeSSHKey(fingerprint, keyType) {
  showConfirmDialog(`Are you sure you want to revoke SSH key "${keyType}"? This action cannot be undone and will immediately invalidate the key.`, () => {
    fetch('/profile/ssh-keys/revoke', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: `fingerprint=${encodeURIComponent(fingerprint)}`
    })
    .then(response => {
      if (response.ok) {
        // Reload the page to show updated SSH key list
        window.location.reload();
      } else {
        // Handle error
        showError('Failed to revoke SSH key. Please try again.');
      }
    })
    .catch(error => {
      console.error('Error revoking SSH key:', error);
      showError('Failed to revoke SSH key. Please try again.');
    });
  });
}

// Copy to clipboard using shared utility
function copyToClipboard(text, type = 'api') {
  const itemType = type === 'ssh' ? 'SSH key fingerprint' : 'API key';

  // Use shared clipboard utility
  SharedClipboard.copy(text, {
    successMessage: `${itemType} copied to clipboard!`,
    errorMessage: `Failed to copy ${itemType}`
  });
}

// Simple backup functions
function createBackup() {
  // Show loading state
  const button = event.target.closest('button');
  const originalText = button.innerHTML;
  button.disabled = true;
  button.innerHTML = '<i data-lucide="loader" class="spin" style="width: 16px; height: 16px; margin-right: 6px;"></i> Creating...';

  fetch('/profile/backups/create', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
      'X-Requested-With': 'XMLHttpRequest'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.status === 'success') {
      // Success, reload page to show updated status
      window.location.reload();
    } else {
      // Error occurred
      showError(data.message || 'Failed to create backup');
    }
  })
  .catch(error => {
    console.error('Error creating backup:', error);
    showError('Failed to create backup. Please try again.');
  })
  .finally(() => {
    // Restore button state if not reloading
    if (!data || data.status !== 'success') {
      button.disabled = false;
      button.innerHTML = originalText;
    }
  });
}

function downloadBackup() {
  // Trigger file download
  window.location.href = '/profile/backups/download';
}

</script>

<style>
  .profile-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .alert {
    padding: 1rem;
    border-radius: var(--pico-border-radius);
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: var(--pico-ins-background);
    border: 1px solid var(--pico-ins-border);
    color: var(--pico-ins-color);
  }

  .alert-error {
    background-color: var(--pico-del-background);
    border: 1px solid var(--pico-del-border);
    color: var(--pico-del-color);
  }

  .user-info, .not-logged-in {
    background-color: var(--pico-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .accordion-sections {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .accordion {
    background-color: var(--pico-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    overflow: hidden;
  }

  .accordion[open] {
    border-color: var(--pico-primary-border);
  }

  .accordion-summary {
    background-color: var(--pico-secondary-background);
    border: none;
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-weight: 600;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    transition: background-color 0.2s;
    list-style: none;
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-summary::before {
    content: '▶';
    margin-right: 0.75rem;
    transition: transform 0.2s;
    font-size: 0.8rem;
    color: var(--pico-muted-color);
  }

  .accordion[open] > .accordion-summary::before {
    transform: rotate(90deg);
  }

  .accordion-summary:hover {
    background-color: var(--pico-secondary-hover-background);
  }

  .accordion[open] > .accordion-summary {
    background-color: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
  }

  .accordion-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--pico-contrast);
  }

  .accordion-title i {
    flex-shrink: 0;
  }

  .accordion-count {
    background-color: var(--pico-code-background-color);
    color: var(--pico-contrast);
    padding: 0.25rem 0.5rem;
    border-radius: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    margin-left: auto;
  }

  .accordion[open] > .accordion-summary .accordion-count {
    background-color: rgba(255, 255, 255, 0.2);
    color: var(--pico-primary-inverse);
  }

  .accordion-content {
    padding: 1.5rem;
    border-top: 1px solid var(--pico-border-color);
  }

  .edit-name-form {
    margin: 1.5rem 0 1rem 0;
  }

  .edit-name-form label {
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }

  .input-group {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    align-items: center;
  }

  .input-group input[type="text"] {
    flex: 1 1 auto;
    margin-bottom: 0;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    min-width: 200px;
    width: 100%;
  }

  .save-btn {
    flex: 0 0 auto;
    background-color: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
    border: none;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
    border-radius: var(--pico-border-radius);
    margin-bottom: 0;
    width: auto !important;
  }

  .save-btn:hover {
    background-color: var(--pico-primary-hover-background);
  }

  .edit-name-form small {
    color: var(--pico-muted-color);
    display: block;
    margin-top: 0.25rem;
  }

  
  .user-details {
    margin: 1.5rem 0;
  }

  .detail-row {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-row strong {
    min-width: 120px;
    color: var(--pico-primary);
  }

  .profile-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .logout-btn {
    background-color: var(--pico-del-background);
    color: var(--pico-del-color);
    border: 1px solid var(--pico-del-border);
  }

  .logout-btn:hover {
    background-color: var(--pico-del-hover-background);
  }

  /* SSH Keys */
  .keys-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .key-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
  }

  .fingerprint {
    font-size: 0.85rem;
    background: none;
    padding: 0;
  }

  .key-meta {
    color: var(--pico-muted-color);
    font-size: 0.85rem;
  }

  /* API Keys */
  .api-keys-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .api-key-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem;
    background-color: var(--pico-code-background-color);
    border-radius: var(--pico-border-radius);
    border: 1px solid rgba(0, 123, 255, 0.2);
  }

  .api-key-info {
    flex: 1;
    min-width: 0;
  }

  .api-key-id {
    font-size: 0.9rem;
    font-weight: 600;
    background: none;
    padding: 0;

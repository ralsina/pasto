<%# Include shared utilities and styles %>
<%= render "src/views/_shared_utils.ecr" %>
<%= render "src/views/_shared_styles.ecr" %>

<div class="help-markdown" id="help-markdown"></div>
<script>
  fetch((window.PASTO_BASE_PATH === '/' ? '/assets/' : window.PASTO_BASE_PATH + '/assets/') + 'HELP.md')
    .then(response => response.text())
    .then(helpMarkdown => {
      document.getElementById('help-markdown').innerHTML = marked.parse(helpMarkdown);
    });
</script>
<style>
  .help-markdown {
    background: var(--pico-secondary-background, #f5f7fa);
    border-radius: var(--pico-border-radius, 6px);
    padding: 1.5em 2em;
    font-size: 1.08em;
    line-height: 1.7;
    color: var(--pico-color, #222);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    max-width: 1050px;
    margin: 2rem auto;
    transition: background 0.3s, color 0.3s;
  }
  .help-markdown h2, .help-markdown h3 {
    margin-top: 1.5em;
  }
</style>

<script>
  // Inject controls into controls-group using shared components
  document.addEventListener('DOMContentLoaded', function() {
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      // Define buttons for help page
      const buttons = [
        {type: "link", href: window.PASTO_BASE_PATH === '/' ? '/' : window.PASTO_BASE_PATH + '/', icon: "plus", title: "Create New Paste"},
        {type: "link", href: window.PASTO_BASE_PATH === '/' ? '/help' : window.PASTO_BASE_PATH + '/help', icon: "help-circle", title: "Help"},
        {type: "link", href: window.PASTO_BASE_PATH === '/' ? '/profile' : window.PASTO_BASE_PATH + '/profile', icon: "user", title: "Profile / Login"}
      ];

      // Use shared controls component
      const controlsHTML = `
        <div class="shared-controls center">
          ${buttons.map(button => {
            return `<a href="${button.href}" class="controls-button" title="${button.title}" aria-label="${button.title}" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
              <i data-lucide="${button.icon}" style="width: 20px; height: 20px;"></i>
            </a>`;
          }).join('')}
        </div>
      `;

      controlsGroup.insertAdjacentHTML('afterbegin', controlsHTML);

      // Initialize Lucide icons using shared utility
      if (window.SharedIcons) {
        window.SharedIcons.init(controlsGroup);
      } else if (window.lucide) {
        window.lucide.createIcons();
      }
    }
  });
</script>

<div class="help-markdown" id="help-markdown"></div>
<script>
  fetch('/assets/HELP.md')
    .then(response => response.text())
    .then(helpMarkdown => {
      document.getElementById('help-markdown').innerHTML = marked.parse(helpMarkdown);
    });
</script>
<style>
  .help-markdown {
    background: var(--pico-secondary-background, #f5f7fa);
    border-radius: var(--pico-border-radius, 6px);
    padding: 1.5em 2em;
    font-size: 1.08em;
    line-height: 1.7;
    color: var(--pico-color, #222);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    max-width: 1050px;
    margin: 2rem auto;
    transition: background 0.3s, color 0.3s;
  }
  .help-markdown h2, .help-markdown h3 {
    margin-top: 1.5em;
  }
</style>

<script>
  // Inject controls into controls-group
  document.addEventListener('DOMContentLoaded', function() {
    const controlsGroup = document.getElementById('controls-group');
    if (controlsGroup) {
      controlsGroup.innerHTML = `
        <a href="/" class="controls-button" title="Create New Paste" aria-label="Create New Paste" style="text-decoration: none; display: flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="plus" style="width: 20px; height: 20px;"></i>
        </a>
        <%= render "src/views/_controls_help_profile.ecr" %>
      `;

      // Initialize Lucide icons
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }
  });
</script>

<style>
  /* Critical CSS to prevent FOUC while main CSS loads asynchronously */
  html, body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  /* Essential Pico-like styles for immediate rendering */
  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.5;
    min-height: 100vh;
  }

  /* Clean Responsive Layout */
  .app-layout {
    display: flex;
    min-height: 100vh;
  }

  .sidebar {
    width: 260px;
    flex-shrink: 0;
    border-right: 3px solid var(--pico-primary);
    background: var(--pico-background-color);
    transition: margin-left 0.3s ease;
    overflow-y: auto;
  }

  .sidebar.collapsed {
    margin-left: -260px;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .controls {
    padding: 1rem 1rem 0 1rem;
    border-bottom: 1px solid var(--pico-border-color);
    background: var(--pico-background-color);
    flex-shrink: 0;
    min-height: 60px;
  }

  .content-area {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
  }

  /* Sidebar toggle button */
  .sidebar-toggle {
    position: fixed;
    top: 1rem;
    left: 0.5rem;
    z-index: 1000;
    background: var(--pico-primary, #0074d9);
    color: white;
    border: none;
    outline: none;
    border-radius: 4px;
    padding: 0.5rem;
    cursor: pointer;
    font-size: 1.2rem;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: left 0.3s ease, border-radius 0.3s ease;
  }

  .sidebar-toggle:focus,
  .sidebar-toggle:focus-visible,
  .sidebar-toggle:focus-within {
    outline: none !important;
    border: none !important;
    box-shadow: none !important;
  }

  .sidebar:not(.collapsed) .sidebar-toggle {
    left: 258.5px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  /* Controls styling */
  .controls-group {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-end;
    margin-left: auto;
    padding-left: 2.75rem; /* Space for sidebar toggle */
  }

  .controls-input {
    flex: 0 0 auto;
    width: 200px !important;
    padding: 0.5rem;
    border: 1px solid var(--pico-border-color);
    border-radius: 4px;
    font-size: 0.9rem;
    height: 3rem !important;
    box-sizing: border-box;
    line-height: 1;
    vertical-align: middle;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
  }

  .controls-select {
    padding: 0.5rem;
    border: 1px solid var(--pico-border-color);
    border-radius: 4px;
    font-size: 0.9rem;
    width: 200px;
    height: 3rem;
    box-sizing: border-box;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
  }

  /* Controls button styles are now in _shared_styles.ecr */

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .app-layout {
      flex-direction: column;
    }

    body .app-layout .sidebar {
      width: 100%;
      height: auto;
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--pico-border-color);
      margin-left: 0 !important;
      transform: translateX(0) !important; /* Override desktop negative margin for all sidebar states */
    }

    body .app-layout .sidebar.collapsed {
      display: block; /* Keep sidebar visible for toggle button */
      height: auto;
      min-height: 3rem; /* Just enough for toggle button */
      margin-left: 0 !important;
      transform: translateX(0) !important; /* Explicit override for collapsed state */
    }

    .sidebar.collapsed .sidebar-content {
      display: none; /* Hide sidebar content when collapsed */
    }

    .sidebar-toggle {
      position: relative;
      margin: 0.5rem;
      align-self: flex-start;
      display: block; /* Always show toggle button */
      left: auto !important;
      top: auto !important;
      border-top-left-radius: 4px !important;
      border-top-right-radius: 4px !important;
      border-bottom-left-radius: 4px !important;
      border-bottom-right-radius: 4px !important;
    }

    .main-content {
      margin-left: 0;
      padding-top: 0;
    }

    .controls-group {
      flex-direction: column;
      width: 100%;
      gap: 0.5rem;
    }

    .controls-input,
    .controls-select {
      width: 100%;
      min-width: unset;
    }

    /* Mobile controls layout优化 - better arrangement */
    .mobile-controls .controls-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0;
    }

    .mobile-controls .controls-row {
      display: flex;
      flex-direction: row;
      gap: 0.5rem;
      align-items: stretch;
      flex-wrap: wrap;
    }

    .mobile-controls .controls-row > * {
      flex: 1;
      min-width: 0;
    }

    .mobile-controls .controls-input {
      width: 100%;
      min-width: 120px;
    }

    .mobile-controls .controls-select {
      width: 100%;
      min-width: 140px;
    }

    .mobile-controls .controls-button {
      flex: 0 0 auto;
      width: auto;
      min-width: 44px; /* Touch-friendly minimum size */
      padding: 0.5rem 0.75rem;
    }
  }

  /* Editor/Preview specific styles */
  .editor-preview-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    height: calc(100vh - 140px); /* Reduced to maximize content area */
    min-height: 350px;
  }

  .editor-preview-container.preview-hidden {
    grid-template-columns: 1fr;
  }

  .editor-preview-container.preview-hidden .preview-pane {
    display: none;
  }

  .editor-pane {
    border: 1px solid var(--pico-primary);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .editor-wrapper {
    flex: 1;
    margin: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .preview-pane {
    border: 1px solid var(--pico-primary);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }


  .codejar-editor {
    flex: 1;
    padding: 0;
    font-family: var(--pico-font-family-monospace);
    font-size: var(--pico-font-size) !important;
    line-height: 1.5;
    overflow: auto;
    outline: none;
    border: none;
    resize: none;
    tab-size: 2;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .codejar-editor:empty::before {
    content: 'Paste your code here...';
    color: var(--pico-muted-color, #6b7280);
  }

  .preview-content {
    flex: 1;
    padding: 1rem;
    overflow: auto;
    display: flex;
    flex-direction: column;
  }

  .preview-content pre {
    flex: 1;
    margin: 0;
    padding: 0;
    font-family: var(--pico-font-family-monospace);
    font-size: var(--pico-font-size);
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
    background: transparent;
    border: none;
    outline: none;
    box-sizing: border-box;
  }

  .preview-content code {
    display: inline;
    padding: 0.1em 0.3em;
    font-weight: 400;
    background: var(--pico-code-background-color, #f4f4f4);
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* Code blocks should be blocks */
  .preview-content pre code {
    display: block;
    padding: 0;
    background: transparent;
    border-radius: 0;
  }

  /* Show/Hide states */
  .hidden {
    display: none !important;
  }

  /* Make all headings use Chivo fonts */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--pico-font-family-sans-serif);
  }

  /* Global font adjustments for Chivo */
  :root {
    --pico-font-family-sans-serif: 'Chivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --pico-font-family: var(--pico-font-family-sans-serif);
    --pico-font-family-monospace: 'Chivo Mono', 'Consolas', 'Monaco', 'Courier New', monospace;
    --pico-font-weight: 400;
    --pico-font-size: 90%;
  }

  /* Apply Chivo font to body and all text elements */
  body {
    font-family: var(--pico-font-family);
    font-weight: var(--pico-font-weight);
    font-size: var(--pico-font-size);
  }

  /* Mobile adjustments for editor */
  @media (max-width: 768px) {
    .editor-preview-container {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto; /* Editor takes main space, preview takes what it needs */
      height: auto;
      min-height: 400px;
      max-height: 70vh; /* Don't take too much screen space on mobile */
    }

    .editor-preview-container.preview-hidden {
      grid-template-rows: 1fr; /* Only editor when preview hidden */
    }

    .editor-pane {
      min-height: 300px; /* Ensure editor has usable space on mobile */
    }

    .preview-pane {
      min-height: 200px; /* Ensure preview has usable space when visible */
      max-height: 50vh; /* Limit preview height on mobile */
      overflow-y: auto; /* Allow scrolling for long previews */
    }
  }

  /* Grass animation styles */
  .grass-container {
    pointer-events: none;
  }

  .grass-blade {
    stroke-dasharray: 22;
    stroke-dashoffset: 22;
    opacity: 0;
    transition: stroke-dashoffset 2s ease-out, opacity 1.5s ease-out;
    transform-origin: bottom center;
    transition-delay: 5s;
  }

  .sidebar:not(.collapsed) .grass-blade {
    stroke-dashoffset: 0;
    opacity: 1;
    animation: sway 4s ease-in-out infinite alternate;
    animation-delay: 6.5s; /* 5s initial delay + 1.5s transition */
  }

  @keyframes sway {
    0% {
      transform: translateX(-1px);
    }
    25% {
      transform: translateX(1px);
    }
    50% {
      transform: translateX(-0.5px);
    }
    75% {
      transform: translateX(0.8px);
    }
    100% {
      transform: translateX(-1px);
    }
  }

  /* Spinner animation for loading states */
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
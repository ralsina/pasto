<script>
// Security settings dialog function - accepts initial settings and customization options
function showSharedSecurityModal(initialSettings, options = {}) {
  const modal = document.createElement('dialog');
  modal.style.cssText = `
    padding: 2rem;
    border: 2px solid var(--pico-primary);
    border-radius: 0.5rem;
    max-width: 500px;
    width: 90vw;
    max-height: 90vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  `;

  // Default options
  const defaultOptions = {
    showEncryptionOptions: true,
    saveButtonText: 'Save Settings',
    primaryButtonStyle: 'var(--pico-primary-background)',
    primaryButtonTextColor: 'var(--pico-primary-inverse)'
  };

  const opts = { ...defaultOptions, ...options };
  const securitySettings = { ...initialSettings };

  modal.innerHTML = `
    <h3 style="margin-top: 0; margin-bottom: 1.5rem;">
      <i data-lucide="shield" style="width: 1.5rem; height: 1.5rem; vertical-align: middle; margin-right: 0.5rem;"></i>
      Security Settings
    </h3>

    <div>
      <!-- Access Control -->
      <div>
        <label for="security-access-control" style="display: block; margin-bottom: 0.5rem; font-weight: 600;"><i data-lucide="shield" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 0.5rem;"></i>Access Control</label>
        <select id="security-access-control" style="width: 100%; padding: 0.5rem;">
          <option value="public" ${securitySettings.accessControl === 'public' && !securitySettings.encryptionEnabled ? 'selected' : ''}>Public</option>
          <% if current_user %>
          <option value="private" ${securitySettings.accessControl === 'private' && !securitySettings.encryptionEnabled ? 'selected' : ''}>Private</option>
        <% end %>
          <option value="encrypted" ${securitySettings.encryptionEnabled ? 'selected' : ''}>Encrypted</option>
        </select>
      </div>

      <!-- Expiration -->
      <div>
        <label for="security-expiration" style="display: block; margin-bottom: 0.5rem; font-weight: 600;"><i data-lucide="clock" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 0.5rem;"></i>Expiration</label>

        <% if mode == "edit" && paste && paste.expires_at.year < 9999 %>
          <p style="font-size: 0.875rem; margin-bottom: 0.5rem; padding: 0.5rem; background: var(--pico-secondary-background); border-radius: var(--pico-border-radius); border-left: 3px solid var(--pico-primary);">
            <i data-lucide="info" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 0.25rem;"></i>
            Currently expires: <strong><%= paste.expires_at.to_s("%Y-%m-%d %H:%M") %> UTC</strong>
          </p>
          <p style="font-size: 0.75rem; margin-bottom: 0.5rem; color: var(--pico-muted-color);">
            Select a preset below to change expiration, or leave as-is to keep current setting.
          </p>
        <% end %>

        <select id="security-expiration" style="width: 100%; padding: 0.5rem;">
          <option value="">Never</option>
          <option value="10m" ${securitySettings.expiration === '10m' ? 'selected' : ''}>10 minutes</option>
          <option value="1h" ${securitySettings.expiration === '1h' ? 'selected' : ''}>1 hour</option>
          <option value="1d" ${securitySettings.expiration === '1d' ? 'selected' : ''}>1 day</option>
          <option value="1w" ${securitySettings.expiration === '1w' ? 'selected' : ''}>1 week</option>
          <option value="1M" ${securitySettings.expiration === '1M' ? 'selected' : ''}>1 month</option>
        </select>
      </div>

      <!-- Burn After Reading -->
      <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: var(--pico-background-color); border: 1px solid var(--pico-border-color); border-radius: 4px;">
        <input type="checkbox" id="security-burn" ${securitySettings.burnAfterReading ? 'checked' : ''} style="margin: 0;">
        <i data-lucide="flame" style="width: 16px; height: 16px;"></i>
        <div style="flex: 1;">
          <strong>Burn After Reading</strong>
        </div>
      </label>

      <%# Anonymous paste option - only for logged-in users %>
      <% if current_user %>
      <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: var(--pico-background-color); border: 1px solid var(--pico-border-color); border-radius: 4px;">
        <input type="checkbox" id="security-anonymous" ${securitySettings.anonymous ? 'checked' : ''} style="margin: 0;">
        <i data-lucide="user-x" style="width: 16px; height: 16px;"></i>
        <div style="flex: 1;">
          <strong>Anonymous</strong>
          <div style="font-size: 0.875rem; opacity: 0.8; margin-top: 0.25rem;">Create paste without linking to your account</div>
        </div>
      </label>
      <% end %>

    <div style="display: flex; gap: 1rem; margin-top: 2rem; justify-content: flex-end;">
      <button id="cancelSecurityBtn" style="background: var(--pico-secondary-background); color: var(--pico-color); border: 1px solid var(--pico-border-color); padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer;">
        Cancel
      </button>
      <button id="saveSecurityBtn" style="background: ${opts.primaryButtonStyle}; color: ${opts.primaryButtonTextColor}; border: none; padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer;">
        ${opts.saveButtonText}
      </button>
    </div>
  `;

  document.body.appendChild(modal);

  // Add event listeners
  const accessControlSelect = document.getElementById('security-access-control');
  const passwordTypeRadios = document.querySelectorAll('input[name="passwordType"]');
  const encryptionOptions = document.getElementById('encryptionOptions');
  const customPasswordDiv = document.getElementById('customPasswordDiv');
  const customPasswordInput = document.getElementById('customPasswordInput');

  // Access control change handler
  accessControlSelect.addEventListener('change', (e) => {
    const value = e.target.value;

    if (value === 'encrypted') {
      securitySettings.encryptionEnabled = true;
      securitySettings.accessControl = 'public';
      if (encryptionOptions) encryptionOptions.style.display = 'block';
    } else {
      securitySettings.encryptionEnabled = false;
      securitySettings.accessControl = value;
      if (encryptionOptions) encryptionOptions.style.display = 'none';
    }
  });

  // Password type change handlers
  passwordTypeRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      if (customPasswordDiv) {
        customPasswordDiv.style.display = e.target.value === 'custom' ? 'block' : 'none';
        if (e.target.value === 'custom' && customPasswordInput) {
          customPasswordInput.focus();
        }
      }
    });
  });

  // Expiration change handler
  document.getElementById('security-expiration').addEventListener('change', (e) => {
    securitySettings.expiration = e.target.value;
  });

  // Burn after reading handler
  document.getElementById('security-burn').addEventListener('change', (e) => {
    securitySettings.burnAfterReading = e.target.checked;
  });

  // Anonymous handler
  const anonymousCheckbox = document.getElementById('security-anonymous');
  if (anonymousCheckbox) {
    anonymousCheckbox.addEventListener('change', (e) => {
      securitySettings.anonymous = e.target.checked;

      // If anonymous is checked, disable private option
      const accessControlSelect = document.getElementById('security-access-control');
      if (accessControlSelect) {
        if (e.target.checked) {
          // Force to public when anonymous
          accessControlSelect.value = 'public';
          securitySettings.accessControl = 'public';
          // Disable private option
          const privateOption = accessControlSelect.querySelector('option[value="private"]');
          if (privateOption) privateOption.disabled = true;
        } else {
          // Enable private option again
          const privateOption = accessControlSelect.querySelector('option[value="private"]');
          if (privateOption) privateOption.disabled = false;
        }
      }
    });

    // Initialize state - disable private if anonymous is checked
    if (securitySettings.anonymous) {
      const accessControlSelect = document.getElementById('security-access-control');
      if (accessControlSelect) {
        const privateOption = accessControlSelect.querySelector('option[value="private"]');
        if (privateOption) privateOption.disabled = true;
      }
    }
  }

  // Cancel button
  modal.querySelector('#cancelSecurityBtn').onclick = () => {
    modal.close();
    document.body.removeChild(modal);
  };

  // Save button - return updated settings via callback
  modal.querySelector('#saveSecurityBtn').onclick = () => {
    // Update security settings from form values
    if (encryptionOptions && encryptionOptions.style.display !== 'none') {
      const passwordType = document.querySelector('input[name="passwordType"]:checked')?.value;
      if (passwordType === 'auto') {
        securitySettings.encryptionPassword = 'auto';
      } else if (passwordType === 'custom' && customPasswordInput) {
        securitySettings.encryptionPassword = customPasswordInput.value;
      }
    }

    modal.close();
    document.body.removeChild(modal);

    // Call callback if provided
    if (options.onSave) {
      options.onSave(securitySettings);
    }
  };

  // Initialize Lucide icons
  if (window.lucide) {
    window.lucide.createIcons();
  }

  // Add Escape key support to close modal without saving
  modal.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      e.stopPropagation();
      modal.close();
      document.body.removeChild(modal);
    }
  });

  modal.showModal();

  return modal; // Return modal for external manipulation if needed
}
</script>